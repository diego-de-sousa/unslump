---
/**
 * ExercisePrep Component
 * "Get ready" countdown screen before starting an exercise
 */
import type { Exercise } from '../../types/workout';

interface Props {
  exercise: Exercise;
  phaseColor: string;
  lang: 'en' | 'es';
}

const { exercise, phaseColor, lang } = Astro.props;

const translations = {
  en: {
    getReady: 'Get ready!',
    nextExercise: 'Next exercise:',
    starting: 'Starting in...',
    skipCountdown: 'Skip countdown',
  },
  es: {
    getReady: '¡Prepárate!',
    nextExercise: 'Siguiente ejercicio:',
    starting: 'Comenzando en...',
    skipCountdown: 'Saltar cuenta atrás',
  },
};

const t = translations[lang];
---

<div class="exercise-prep fixed inset-0 z-50 flex flex-col items-center justify-center bg-gradient-to-br from-gray-50 to-white p-6">
  <!-- Get Ready Title -->
  <h1 class="get-ready-title mb-8 text-center font-['Barriecito'] text-5xl font-bold md:text-6xl" style={`color: ${phaseColor};`}>
    {t.getReady}
  </h1>

  <!-- Next Exercise Label -->
  <p class="mb-4 text-center text-sm font-semibold uppercase tracking-wide text-gray-500">
    {t.nextExercise}
  </p>

  <!-- Exercise Name -->
  <h2 class="mb-8 max-w-2xl text-center text-3xl font-bold text-gray-800 md:text-4xl">
    {exercise.name}
  </h2>

  <!-- Exercise Image/GIF Preview (if available) -->
  {exercise.gifUrl || exercise.imageUrl ? (
    <div class="mb-8 overflow-hidden rounded-2xl shadow-xl">
      <img
        src={exercise.gifUrl || exercise.imageUrl}
        alt={exercise.name}
        class="h-64 w-auto object-cover md:h-80"
      />
    </div>
  ) : null}

  <!-- Starting In Label -->
  <p class="mb-4 text-center text-lg text-gray-600">
    {t.starting}
  </p>

  <!-- Countdown Circle -->
  <div
    class="countdown-circle relative mb-8 flex h-40 w-40 items-center justify-center rounded-full border-8 md:h-48 md:w-48"
    style={`border-color: ${phaseColor};`}
  >
    <div
      class="countdown-number font-['Barriecito'] text-7xl font-bold md:text-8xl"
      style={`color: ${phaseColor};`}
      id="countdownNumber"
    >
      5
    </div>
  </div>

  <!-- Skip Button -->
  <button
    id="skipCountdownButton"
    class="skip-button rounded-full bg-gray-200 px-6 py-3 text-sm font-semibold text-gray-700 transition-all duration-200 hover:bg-gray-300 active:scale-95"
  >
    {t.skipCountdown}
  </button>
</div>

<style>
  .exercise-prep {
    animation: fadeIn 0.3s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .get-ready-title {
    animation: pulse 1s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.05);
    }
  }

  .countdown-circle {
    animation: scaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes scaleIn {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .countdown-number {
    animation: countdownPulse 1s ease-in-out infinite;
  }

  @keyframes countdownPulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  /* Countdown animation when number changes */
  .countdown-number.changing {
    animation: countdownChange 0.3s ease-out;
  }

  @keyframes countdownChange {
    0% {
      transform: scale(1.5);
      opacity: 0;
    }
    50% {
      transform: scale(0.8);
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
