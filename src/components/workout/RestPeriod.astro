---
/**
 * RestPeriod Component
 * Rest screen shown between exercises
 */
import type { Exercise } from '../../types/workout';

interface Props {
  nextExercise: Exercise | null;
  phaseColor: string;
  lang: 'en' | 'es';
}

const { nextExercise, phaseColor, lang } = Astro.props;

const translations = {
  en: {
    title: 'Rest',
    message: 'Take a breath, prepare for the next exercise',
    nextUp: 'Next up:',
    skipRest: 'Skip rest',
  },
  es: {
    title: 'Descanso',
    message: 'Respira, prepárate para el siguiente ejercicio',
    nextUp: 'A continuación:',
    skipRest: 'Saltar descanso',
  },
};

const t = translations[lang];
---

<div class="rest-period fixed inset-0 z-50 flex flex-col items-center justify-center bg-gradient-to-br from-blue-50 to-white p-6">
  <!-- Rest Icon -->
  <div class="rest-icon mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-blue-100">
    <svg class="h-10 w-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
      ></path>
    </svg>
  </div>

  <!-- Rest Title -->
  <h1 class="mb-4 text-center font-['Barriecito'] text-4xl font-bold text-blue-600 md:text-5xl">
    {t.title}
  </h1>

  <!-- Rest Message -->
  <p class="mb-8 max-w-md text-center text-lg text-gray-600">
    {t.message}
  </p>

  <!-- Timer Circle -->
  <div class="timer-circle relative mb-8 flex h-32 w-32 items-center justify-center rounded-full border-8 border-blue-500 md:h-40 md:w-40">
    <div class="timer-number font-['Barriecito'] text-6xl font-bold text-blue-500 md:text-7xl" id="restTimer">
      7
    </div>
    <!-- Progress ring -->
    <svg class="progress-ring absolute inset-0 -rotate-90" width="100%" height="100%">
      <circle
        class="progress-ring-circle"
        stroke={phaseColor}
        stroke-width="8"
        fill="transparent"
        r="58"
        cx="50%"
        cy="50%"
      />
    </svg>
  </div>

  <!-- Next Exercise Preview -->
  {nextExercise && (
    <div class="next-exercise-preview mb-8 max-w-md rounded-xl bg-white p-6 shadow-lg">
      <p class="mb-2 text-center text-sm font-semibold uppercase tracking-wide text-gray-500">
        {t.nextUp}
      </p>
      <h3 class="mb-4 text-center text-xl font-bold text-gray-800">
        {nextExercise.name}
      </h3>

      {/* Exercise preview image */}
      {(nextExercise.imageUrl || nextExercise.gifUrl) && (
        <div class="overflow-hidden rounded-lg">
          <img
            src={nextExercise.imageUrl || nextExercise.gifUrl}
            alt={nextExercise.name}
            class="h-32 w-full object-cover"
          />
        </div>
      )}

      {/* Exercise info */}
      <div class="mt-4 flex items-center justify-center gap-4 text-sm text-gray-600">
        {nextExercise.duration > 0 && (
          <div class="flex items-center gap-1">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{nextExercise.duration}s</span>
          </div>
        )}
        {nextExercise.reps && (
          <div class="flex items-center gap-1">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <span>{nextExercise.reps}</span>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Skip Rest Button -->
  <button
    id="skipRestButton"
    class="skip-rest-button rounded-full bg-gray-200 px-6 py-3 text-sm font-semibold text-gray-700 transition-all duration-200 hover:bg-gray-300 active:scale-95"
  >
    {t.skipRest} →
  </button>
</div>

<style>
  .rest-period {
    animation: fadeIn 0.3s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .rest-icon {
    animation: breathe 3s ease-in-out infinite;
  }

  @keyframes breathe {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .timer-circle {
    animation: scaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes scaleIn {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .timer-number {
    animation: pulse 1s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .next-exercise-preview {
    animation: slideUp 0.5s ease-out 0.2s both;
  }

  @keyframes slideUp {
    from {
      transform: translateY(20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .progress-ring-circle {
    transition: stroke-dashoffset 1s linear;
    transform-origin: center;
  }
</style>
