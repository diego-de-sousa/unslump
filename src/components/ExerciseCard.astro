---
/**
 * Exercise Card Component
 * Displays a single exercise with timer, sets, and completion button
 */

import Info from './icons/Info.astro';
import Check from './icons/Check.astro';
import ExerciseTimer from './islands/ExerciseTimer.tsx';
import SetCounter from './islands/SetCounter.tsx';
import LevelInfo from './islands/LevelInfo.tsx';
import ExerciseImage from './ExerciseImage.astro';
import type { Exercise } from '../types/workout';
import type { Language } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  exercise: Exercise;
  phaseId: string;
  colorPrimaryHex: string;
  colorLightHex: string;
  colorBorderHex: string;
  lang: Language;
}

const {
  exercise,
  phaseId,
  colorPrimaryHex,
  colorLightHex,
  colorBorderHex,
  lang
} = Astro.props;

const t = useTranslations(lang);
---

<div
  class="exercise-card border-2 border-slate-200 dark:border-gray-700 bg-white dark:bg-gray-800 rounded-lg p-3 sm:p-4 transition-all cursor-pointer hover:shadow-lg"
  data-phase-id={phaseId}
  data-exercise-id={exercise.id}
  data-duration={exercise.duration}
>
  {/* Header row: Title + Info button + Complete button */}
  <div class="flex justify-between items-start gap-2 mb-2">
    <div class="flex items-start gap-2 flex-1 min-w-0">
      <h3 class="font-bold text-lg sm:text-xl text-slate-800 dark:text-gray-100 flex-1 min-w-0 break-words">
        {exercise.name}
      </h3>
      <button
        class="info-btn p-1.5 sm:p-2 border rounded-full transition-all flex-shrink-0 shadow-sm hover:shadow-md"
        style={`background-color: ${colorLightHex}; border-color: ${colorBorderHex};`}
        data-exercise-id={exercise.id}
        title={t('common.moreInfo')}
      >
        <Info size={18} style={`color: ${colorPrimaryHex};`} />
      </button>
    </div>

    <button
      class="complete-btn p-1.5 sm:p-2 rounded-full transition-all bg-slate-200 text-slate-500 hover:bg-slate-300 flex-shrink-0"
      data-phase-id={phaseId}
      data-exercise-id={exercise.id}
    >
      <Check size={18} />
    </button>
  </div>

  {/* Exercise reference media (video or image) - Full width */}
  <div class="flex justify-center w-full mb-2">
    <ExerciseImage
      imageUrl={exercise.imageUrl}
      gifUrl={exercise.gifUrl}
      videoEmbedUrl={exercise.videoEmbedUrl}
      alt={exercise.name}
      exerciseId={exercise.id}
    />
  </div>

  {/* Exercise details */}
  <p class="text-sm sm:text-base font-semibold text-slate-700 dark:text-gray-300 mb-2">
    {exercise.reps}
  </p>
  <p class="text-xs sm:text-sm text-slate-700 dark:text-gray-300 mb-2">
    {exercise.instructions}
  </p>

  {exercise.levels && (
    <LevelInfo
      client:visible
      levels={exercise.levels}
      colorHex={colorPrimaryHex}
      colorLightHex={colorLightHex}
      colorBorderHex={colorBorderHex}
      labels={{
        beginner: t('levels.beginner'),
        intermediate: t('levels.intermediate'),
        advanced: t('levels.advanced')
      }}
    />
  )}

  {exercise.duration > 0 && (
    <ExerciseTimer
      client:visible
      exerciseId={exercise.id}
      phaseId={phaseId}
      duration={exercise.duration}
      colorHex={colorPrimaryHex}
      colorLightHex={colorLightHex}
      colorBorderHex={colorBorderHex}
      startLabel={t('common.start')}
    />
  )}

  {exercise.sets && exercise.sets > 0 && (
    <SetCounter
      client:visible
      exerciseId={exercise.id}
      phaseId={phaseId}
      totalSets={exercise.sets}
      colorHex={colorPrimaryHex}
      colorLightHex={colorLightHex}
      colorBorderHex={colorBorderHex}
      completedLabel={t('timer.completed')}
      addSetLabel={t('timer.addSet')}
    />
  )}
</div>
