---
interface Props {
  size?: 'small' | 'medium' | 'large' | 'xl';
  showProgress?: boolean;
  id?: string;
}

const { size = 'large', showProgress = false, id } = Astro.props;

// Tamaños responsive
const sizeClasses = {
  small: 'text-2xl sm:text-3xl',
  medium: 'text-3xl sm:text-5xl',
  large: 'text-5xl sm:text-8xl',
  xl: 'text-6xl sm:text-9xl'
};

const textSize = sizeClasses[size];

// Colores por fase con rotación inicial (encorvado)
// XROT: rotación horizontal (hacia adelante/atrás) - positivo = encorvado hacia atrás
// YROT: rotación vertical (hacia los lados) - negativo = inclinado al otro lado
const phases = [
  { id: 'fase1', text: 'un', color: '#4f46e5', clipPath: 'inset(0 100% 0 0)', xrot: 25, yrot: -15 },
  { id: 'fase2', text: 'sl', color: '#14b8a6', clipPath: 'inset(0 100% 0 0)', xrot: 25, yrot: -15 },
  { id: 'fase3', text: 'um', color: '#f97316', clipPath: 'inset(0 100% 0 0)', xrot: 25, yrot: -15 },
  { id: 'fase4', text: 'p!', color: '#ec4899', clipPath: 'inset(-10% 100% -10% 0)', xrot: 25, yrot: -15 }
];
---

<div id={id} class="flex items-center justify-center">
  {phases.map(phase => (
    <div
      class="letter-group"
      data-phase={showProgress ? phase.id : undefined}
      data-xrot={showProgress ? phase.xrot : 0}
      data-yrot={showProgress ? phase.yrot : 0}
      style="position: relative; display: inline-block; overflow: visible;"
    >
      <span
        class={`base-layer logo-font ${textSize} text-slate-500`}
        style={`--xrot: ${showProgress ? phase.xrot : 0}; --yrot: ${showProgress ? phase.yrot : 0};`}
      >
        {phase.text}
      </span>
      <span
        class={`color-layer logo-font ${textSize}`}
        style={`position: absolute; top: 0; left: 0; color: ${phase.color}; clip-path: ${showProgress ? phase.clipPath : 'inset(0 0 0 0)'}; --xrot: ${showProgress ? phase.xrot : 0}; --yrot: ${showProgress ? phase.yrot : 0};`}
      >
        {phase.text}
      </span>
    </div>
  ))}
</div>

<style>
  /* Registrar custom properties para animar rotaciones */
  @property --xrot {
    syntax: '<number>';
    inherits: false;
    initial-value: 25;
  }

  @property --yrot {
    syntax: '<number>';
    inherits: false;
    initial-value: -15;
  }

  .logo-font {
    font-family: 'Tilt Warp Variable', system-ui, sans-serif;
    font-weight: 400;
    font-variation-settings: 'XROT' var(--xrot), 'YROT' var(--yrot);
  }

  .letter-group {
    letter-spacing: -0.02em;
  }

  .color-layer {
    will-change: clip-path;
    /* Transitions are handled by the animation system, not CSS */
  }

  .base-layer {
    display: inline-block;
    /* Transitions are handled by the animation system, not CSS */
  }
</style>
