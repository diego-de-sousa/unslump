---
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="trust-section py-12 sm:py-16 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- Trust badges grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8 mb-8">

      <!-- Science-backed badge -->
      <div class="trust-badge group relative bg-indigo-50 border-2 border-indigo-200 rounded-2xl p-6 sm:p-8 hover:shadow-xl hover:border-indigo-400 transition-all duration-300">
        <div class="relative flex items-center gap-4">
          <!-- Emoji Icon -->
          <div class="flex-shrink-0 text-4xl sm:text-5xl transform group-hover:scale-110 transition-transform duration-300">
            🔬
          </div>

          <!-- Text -->
          <div class="flex-1">
            <h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-1 text-balance">
              {t('landing.trust.scienceBacked')}
            </h3>
            <p class="text-sm sm:text-base text-gray-600 text-pretty">
              {t('modal.references.description').substring(0, 80)}...
            </p>
          </div>
        </div>
      </div>

      <!-- Desk-approved badge -->
      <div class="trust-badge group relative bg-teal-50 border-2 border-teal-200 rounded-2xl p-6 sm:p-8 hover:shadow-xl hover:border-teal-400 transition-all duration-300">
        <div class="relative flex items-center gap-4">
          <!-- Emoji Icon -->
          <div class="flex-shrink-0 text-4xl sm:text-5xl transform group-hover:scale-110 transition-transform duration-300">
            💻
          </div>

          <!-- Text -->
          <div class="flex-1">
            <h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-1 text-balance">
              {t('landing.trust.deskApproved')}
            </h3>
            <p class="text-sm sm:text-base text-gray-600 text-pretty">
              {lang === 'en' ? 'Designed specifically for office workers' : 'Diseñado específicamente para oficinistas'}
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- Studies note -->
    <div class="text-center">
      <p class="text-base sm:text-lg text-gray-700 font-medium mb-4 text-pretty">
        📖 {t('landing.trust.studiesNote')}
      </p>

      <!-- View references link -->
      <button
        id="view-references-landing"
        class="inline-flex items-center gap-2 text-indigo-600 font-semibold hover:text-indigo-700 underline decoration-2 underline-offset-4 transition-colors duration-200"
      >
        {t('modal.references.viewButtonShort')}
      </button>
    </div>

  </div>
</section>

<style>
  .trust-badge {
    will-change: transform, box-shadow;
  }

  .trust-badge:hover {
    transform: translateY(-4px);
  }
</style>

<script>
  // Add click handler to view references button
  document.addEventListener('DOMContentLoaded', () => {
    const viewReferencesBtn = document.getElementById('view-references-landing');
    if (viewReferencesBtn) {
      viewReferencesBtn.addEventListener('click', () => {
        // This will be handled by the references modal in the main app
        // For landing page, we can scroll to a references section or open modal
        const event = new CustomEvent('open-references-modal');
        window.dispatchEvent(event);
      });
    }
  });
</script>
