---
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="how-it-works-section py-16 sm:py-20 bg-gray-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <!-- Section title -->
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 text-balance">
        {lang === 'en' ? 'How it works' : 'Cómo funciona'} ⚙️
      </h2>
      <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto text-pretty">
        {lang === 'en'
          ? 'Simple, guided, and backed by science'
          : 'Simple, guiado y respaldado por ciencia'}
      </p>
    </div>

    <!-- Steps -->
    <div class="space-y-8">

      <!-- Step 1 -->
      <div class="step-card flex flex-col sm:flex-row gap-6 items-start bg-white rounded-2xl p-6 sm:p-8 border-2 border-indigo-200 hover:border-indigo-400 hover:shadow-xl transition-all">
        <div class="flex-shrink-0">
          <div class="w-16 h-16 sm:w-20 sm:h-20 bg-indigo-500 rounded-2xl flex items-center justify-center text-white text-3xl sm:text-4xl font-bold shadow-lg">
            1
          </div>
        </div>
        <div class="flex-1">
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3 text-balance">
            {lang === 'en' ? 'Start the guided workout' : 'Inicia la rutina guiada'} 🎯
          </h3>
          <p class="text-base sm:text-lg text-gray-700 mb-3 text-pretty">
            {lang === 'en'
              ? 'Click "Unslump now!" to begin. The app will guide you through all 4 phases in the correct order.'
              : 'Haz clic en "¡Unslump ahora!" para empezar. La app te guiará por las 4 fases en el orden correcto.'}
          </p>
          <div class="flex items-center gap-2 text-sm text-indigo-700 font-semibold">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-pretty">{lang === 'en' ? 'No guesswork, just follow along' : 'Sin adivinar, solo sigue las indicaciones'}</span>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="step-card flex flex-col sm:flex-row gap-6 items-start bg-white rounded-2xl p-6 sm:p-8 border-2 border-teal-200 hover:border-teal-400 hover:shadow-xl transition-all">
        <div class="flex-shrink-0">
          <div class="w-16 h-16 sm:w-20 sm:h-20 bg-teal-500 rounded-2xl flex items-center justify-center text-white text-3xl sm:text-4xl font-bold shadow-lg">
            2
          </div>
        </div>
        <div class="flex-1">
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3 text-balance">
            {lang === 'en' ? 'Follow the instructions' : 'Sigue las instrucciones'} 📱
          </h3>
          <p class="text-base sm:text-lg text-gray-700 mb-3 text-pretty">
            {lang === 'en'
              ? 'Each exercise shows reps, duration, and detailed instructions. Watch tutorial videos if you need help with form.'
              : 'Cada ejercicio muestra repeticiones, duración e instrucciones detalladas. Mira videos tutoriales si necesitas ayuda con la técnica.'}
          </p>
          <div class="flex items-center gap-2 text-sm text-teal-700 font-semibold">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span class="text-pretty">{lang === 'en' ? 'Video tutorials available for every exercise' : 'Videos tutoriales disponibles para cada ejercicio'}</span>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="step-card flex flex-col sm:flex-row gap-6 items-start bg-white rounded-2xl p-6 sm:p-8 border-2 border-orange-200 hover:border-orange-400 hover:shadow-xl transition-all">
        <div class="flex-shrink-0">
          <div class="w-16 h-16 sm:w-20 sm:h-20 bg-orange-500 rounded-2xl flex items-center justify-center text-white text-3xl sm:text-4xl font-bold shadow-lg">
            3
          </div>
        </div>
        <div class="flex-1">
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3 text-balance">
            {lang === 'en' ? 'Track your progress' : 'Sigue tu progreso'} ✅
          </h3>
          <p class="text-base sm:text-lg text-gray-700 mb-3 text-pretty">
            {lang === 'en'
              ? 'Mark exercises complete as you go. The app automatically saves your progress and tracks your streaks.'
              : 'Marca ejercicios como completos a medida que avanzas. La app guarda automáticamente tu progreso y rastrea tus rachas.'}
          </p>
          <div class="flex items-center gap-2 text-sm text-orange-700 font-semibold">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            <span class="text-pretty">{lang === 'en' ? 'Your progress is stored locally in this browser' : 'Tu progreso se guarda localmente en este navegador'}</span>
          </div>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="step-card flex flex-col sm:flex-row gap-6 items-start bg-white rounded-2xl p-6 sm:p-8 border-2 border-pink-200 hover:border-pink-400 hover:shadow-xl transition-all">
        <div class="flex-shrink-0">
          <div class="w-16 h-16 sm:w-20 sm:h-20 bg-pink-500 rounded-2xl flex items-center justify-center text-white text-3xl sm:text-4xl font-bold shadow-lg">
            4
          </div>
        </div>
        <div class="flex-1">
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3 text-balance">
            {lang === 'en' ? 'Repeat 3 times per week' : 'Repite 3 veces por semana'} 📅
          </h3>
          <p class="text-base sm:text-lg text-gray-700 mb-3 text-pretty">
            {lang === 'en'
              ? 'Consistency is key. Do this routine 3 times weekly for 12+ weeks to see lasting postural changes.'
              : 'La consistencia es clave. Haz esta rutina 3 veces semanales durante 12+ semanas para ver cambios posturales duraderos.'}
          </p>
          <div class="flex items-center gap-2 text-sm text-pink-700 font-semibold">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-pretty">{lang === 'en' ? 'Results take time, but they\'re worth it' : 'Los resultados toman tiempo, pero valen la pena'}</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Key Tips Section -->
    <div class="mt-12">
      <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6 text-center text-balance">
        💡 {lang === 'en' ? 'Key tips for success' : 'Consejos clave para el éxito'}
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Tip 1: Sequence -->
        <div class="p-4 bg-gradient-to-br from-indigo-50 to-indigo-100/50 rounded-xl border-l-4 border-indigo-500 shadow-sm hover:shadow-lg transition-all">
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-10 h-10 bg-indigo-500 rounded-lg flex items-center justify-center text-xl shadow-sm">
              🔒
            </div>
            <p class="flex-1 text-sm sm:text-base text-gray-800 leading-relaxed text-pretty" set:html={t('modal.onboarding.keyTip1')}></p>
          </div>
        </div>

        <!-- Tip 2: Frequency -->
        <div class="p-4 bg-gradient-to-br from-teal-50 to-teal-100/50 rounded-xl border-l-4 border-teal-500 shadow-sm hover:shadow-lg transition-all">
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-10 h-10 bg-teal-500 rounded-lg flex items-center justify-center text-xl shadow-sm">
              📅
            </div>
            <p class="flex-1 text-sm sm:text-base text-gray-800 leading-relaxed text-pretty" set:html={t('modal.onboarding.keyTip2')}></p>
          </div>
        </div>

        <!-- Tip 3: Bird dog -->
        <div class="p-4 bg-gradient-to-br from-orange-50 to-orange-100/50 rounded-xl border-l-4 border-orange-500 shadow-sm hover:shadow-lg transition-all">
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-10 h-10 bg-orange-500 rounded-lg flex items-center justify-center text-xl shadow-sm">
              🏆
            </div>
            <p class="flex-1 text-sm sm:text-base text-gray-800 leading-relaxed text-pretty" set:html={t('modal.onboarding.keyTip3')}></p>
          </div>
        </div>

        <!-- Tip 4: Duration -->
        <div class="p-4 bg-gradient-to-br from-pink-50 to-pink-100/50 rounded-xl border-l-4 border-pink-500 shadow-sm hover:shadow-lg transition-all">
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-10 h-10 bg-pink-500 rounded-lg flex items-center justify-center text-xl shadow-sm">
              ⏳
            </div>
            <p class="flex-1 text-sm sm:text-base text-gray-800 leading-relaxed text-pretty" set:html={t('modal.onboarding.keyTip4')}></p>
          </div>
        </div>

        <!-- Tip 5: Safety Warning (full width) -->
        <div class="sm:col-span-2 p-4 bg-gradient-to-br from-red-50 to-red-100/50 rounded-xl border-l-4 border-red-500 shadow-sm hover:shadow-lg transition-all">
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-10 h-10 bg-red-500 rounded-lg flex items-center justify-center text-xl shadow-sm">
              ⚠️
            </div>
            <p class="flex-1 text-sm sm:text-base text-gray-800 leading-relaxed text-pretty" set:html={t('modal.onboarding.keyTip5')}></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom note -->
    <div class="mt-12 text-center bg-white rounded-2xl border-2 border-gray-200 p-6 sm:p-8">
      <p class="text-base sm:text-lg text-gray-700 font-semibold mb-2 text-pretty">
        {lang === 'en'
          ? '💡 Pro tip: Bookmark this page and add it to your home screen'
          : '💡 Consejo: Marca esta página y añádela a tu pantalla de inicio'}
      </p>
      <p class="text-sm sm:text-base text-gray-600 text-pretty">
        {lang === 'en'
          ? 'Works offline, no download required!'
          : '¡Funciona sin conexión, no requiere descarga!'}
      </p>
    </div>

  </div>
</section>

<style>
  .step-card {
    transition: all 0.3s ease;
  }

  .step-card:hover {
    transform: translateX(8px);
  }
</style>
