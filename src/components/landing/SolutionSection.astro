---
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="solution-section py-16 sm:py-20 bg-gradient-to-b from-indigo-50 to-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <!-- Section title -->
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        {lang === 'en' ? 'The solution: A scientific 4-phase system' : 'La solución: Un sistema científico de 4 fases'} 🔬
      </h2>
      <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto">
        {lang === 'en'
          ? 'Based on 30+ peer-reviewed studies, this corrective exercise sequence is designed specifically for desk workers'
          : 'Basado en más de 30 estudios peer-reviewed, esta secuencia de ejercicios correctivos está diseñada específicamente para trabajadores de escritorio'}
      </p>
    </div>

    <!-- 4 Phase Timeline -->
    <div class="relative mb-16">
      <!-- Connecting line -->
      <div class="hidden lg:block absolute top-1/2 left-0 right-0 h-1 bg-gradient-to-r from-indigo-200 via-teal-200 via-orange-200 to-pink-200 transform -translate-y-1/2"></div>

      <!-- Phases -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">

        <!-- Phase 1: Inhibit -->
        <div class="phase-solution text-center">
          <div class="relative inline-block">
            <div class="w-20 h-20 sm:w-24 sm:h-24 bg-indigo-100 border-4 border-indigo-500 rounded-full flex items-center justify-center text-4xl sm:text-5xl mb-4 mx-auto relative z-10 shadow-lg">
              🧘
            </div>
            <div class="absolute -top-2 -right-2 w-8 h-8 bg-indigo-500 rounded-full flex items-center justify-center text-white font-bold text-sm shadow">
              1
            </div>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-indigo-700 mb-2">
            {lang === 'en' ? 'Inhibit' : 'Inhibir'}
          </h3>
          <p class="text-sm sm:text-base text-gray-700 mb-3 font-semibold">
            {lang === 'en' ? 'Release tension' : 'Liberar tensión'}
          </p>
          <p class="text-sm text-gray-600">
            {lang === 'en'
              ? 'Foam rolling to calm overactive muscles'
              : 'Rodillo de espuma para calmar músculos hiperactivos'}
          </p>
        </div>

        <!-- Phase 2: Lengthen -->
        <div class="phase-solution text-center">
          <div class="relative inline-block">
            <div class="w-20 h-20 sm:w-24 sm:h-24 bg-teal-100 border-4 border-teal-500 rounded-full flex items-center justify-center text-4xl sm:text-5xl mb-4 mx-auto relative z-10 shadow-lg">
              🤸
            </div>
            <div class="absolute -top-2 -right-2 w-8 h-8 bg-teal-500 rounded-full flex items-center justify-center text-white font-bold text-sm shadow">
              2
            </div>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-teal-700 mb-2">
            {lang === 'en' ? 'Lengthen' : 'Alargar'}
          </h3>
          <p class="text-sm sm:text-base text-gray-700 mb-3 font-semibold">
            {lang === 'en' ? 'Restore range of motion' : 'Restaurar rango de movimiento'}
          </p>
          <p class="text-sm text-gray-600">
            {lang === 'en'
              ? 'Static stretches for shortened muscles'
              : 'Estiramientos estáticos para músculos acortados'}
          </p>
        </div>

        <!-- Phase 3: Activate -->
        <div class="phase-solution text-center">
          <div class="relative inline-block">
            <div class="w-20 h-20 sm:w-24 sm:h-24 bg-orange-100 border-4 border-orange-500 rounded-full flex items-center justify-center text-4xl sm:text-5xl mb-4 mx-auto relative z-10 shadow-lg">
              💪
            </div>
            <div class="absolute -top-2 -right-2 w-8 h-8 bg-orange-500 rounded-full flex items-center justify-center text-white font-bold text-sm shadow">
              3
            </div>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-orange-700 mb-2">
            {lang === 'en' ? 'Activate' : 'Activar'}
          </h3>
          <p class="text-sm sm:text-base text-gray-700 mb-3 font-semibold">
            {lang === 'en' ? 'Wake up weak muscles' : 'Despertar músculos débiles'}
          </p>
          <p class="text-sm text-gray-600">
            {lang === 'en'
              ? 'Isolated exercises to strengthen neglected areas'
              : 'Ejercicios aislados para fortalecer áreas descuidadas'}
          </p>
        </div>

        <!-- Phase 4: Integrate -->
        <div class="phase-solution text-center">
          <div class="relative inline-block">
            <div class="w-20 h-20 sm:w-24 sm:h-24 bg-pink-100 border-4 border-pink-500 rounded-full flex items-center justify-center text-4xl sm:text-5xl mb-4 mx-auto relative z-10 shadow-lg">
              🏃
            </div>
            <div class="absolute -top-2 -right-2 w-8 h-8 bg-pink-500 rounded-full flex items-center justify-center text-white font-bold text-sm shadow">
              4
            </div>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-pink-700 mb-2">
            {lang === 'en' ? 'Integrate' : 'Integrar'}
          </h3>
          <p class="text-sm sm:text-base text-gray-700 mb-3 font-semibold">
            {lang === 'en' ? 'Move like a human' : 'Moverse como humano'}
          </p>
          <p class="text-sm text-gray-600">
            {lang === 'en'
              ? 'Dynamic movements that retrain your body'
              : 'Movimientos dinámicos que reentrenan tu cuerpo'}
          </p>
        </div>

      </div>
    </div>

    <!-- Key facts -->
    <div class="bg-white rounded-2xl border-2 border-gray-200 p-8 shadow-lg">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
        <div>
          <div class="text-4xl sm:text-5xl font-bold text-indigo-600 mb-2">25</div>
          <p class="text-sm sm:text-base text-gray-700 font-semibold">
            {lang === 'en' ? 'minutes per session' : 'minutos por sesión'}
          </p>
        </div>
        <div>
          <div class="text-4xl sm:text-5xl font-bold text-teal-600 mb-2">3×</div>
          <p class="text-sm sm:text-base text-gray-700 font-semibold">
            {lang === 'en' ? 'times per week' : 'veces por semana'}
          </p>
        </div>
        <div>
          <div class="text-4xl sm:text-5xl font-bold text-orange-600 mb-2">21</div>
          <p class="text-sm sm:text-base text-gray-700 font-semibold">
            {lang === 'en' ? 'exercises total' : 'ejercicios en total'}
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .phase-solution {
    transition: all 0.3s ease;
  }

  .phase-solution:hover {
    transform: translateY(-8px);
  }
</style>
