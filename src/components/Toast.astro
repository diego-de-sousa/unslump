---
/**
 * Toast Component
 * Shows temporary notifications with smooth animations
 */
---

<!-- Toast Container (hidden by default, controlled by JS) -->
<div
  id="toast-container"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[100] pointer-events-none"
  style="opacity: 0; transform: translate(-50%, 100px);"
>
  <div
    id="toast"
    class="toast-message px-6 py-4 rounded-xl shadow-2xl backdrop-blur-md border-2 pointer-events-auto max-w-[90vw] sm:max-w-md"
  >
    <p class="text-sm sm:text-base font-medium toast-text"></p>
  </div>
</div>

<style>
  .toast-message {
    /* Default white background with slight transparency */
    background: rgba(255, 255, 255, 0.95);
  }
</style>
