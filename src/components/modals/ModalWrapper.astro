---
/**
 * Modal Wrapper Component
 * Shared wrapper for all modals with backdrop and container
 */

import X from '../icons/X.astro';

interface Props {
  id: string;
  title?: string;
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '4xl';
  showCloseButton?: boolean;
  zIndex?: string;
}

const {
  id,
  title,
  maxWidth = '2xl',
  showCloseButton = true,
  zIndex = 'z-50'
} = Astro.props;

const maxWidthClasses = {
  sm: 'max-w-sm',
  md: 'max-w-md',
  lg: 'max-w-lg',
  xl: 'max-w-xl',
  '2xl': 'max-w-2xl',
  '4xl': 'max-w-4xl'
};
---

<div
  id={id}
  class:list={['modal', 'fixed', 'inset-0', 'bg-black', 'bg-opacity-50', 'flex', 'items-center', 'justify-center', 'p-3', 'sm:p-4', zIndex, 'hidden']}
  data-modal={id}
>
  <div class:list={['bg-white', 'dark:bg-gray-800', 'rounded-lg', maxWidthClasses[maxWidth], 'w-full', 'max-h-[90vh]', 'overflow-y-auto', 'p-4', 'sm:p-6']}>
    {(title || showCloseButton) && (
      <div class="flex justify-between items-start gap-2 mb-4">
        {title && (
          <h2 class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-gray-100 flex-1 min-w-0">
            {title}
          </h2>
        )}
        {showCloseButton && (
          <button
            data-close-modal={id}
            class="p-1.5 sm:p-2 hover:bg-slate-100 dark:hover:bg-gray-700 rounded-full transition-all flex-shrink-0"
            aria-label="Close modal"
          >
            <X size={20} />
          </button>
        )}
      </div>
    )}

    <div class="modal-content">
      <slot />
    </div>
  </div>
</div>
