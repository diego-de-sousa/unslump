---
/**
 * Onboarding Modal Component
 * Welcome guide, preferences, and app instructions
 */

import Logo from '../Logo.astro';
import X from '../icons/X.astro';
import LevelSelector from '../islands/LevelSelector.tsx';
import type { Language } from '../../i18n/utils';
import { useTranslations, languages } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="onboarding-modal" class="modal fixed inset-0 bg-black/50 flex items-center justify-center p-3 sm:p-4 z-50 hidden">
  <div class="bg-white dark:bg-gray-800 rounded-lg max-w-2xl w-full max-h-[90vh] overflow-hidden flex flex-col relative">
    <!-- Header with sticky logo -->
    <div class="flex-shrink-0 bg-white dark:bg-gray-800 px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between gap-3 border-b border-slate-200 dark:border-gray-700 rounded-t-lg">
      <Logo id="onboarding-logo" showProgress={true} size="medium" />
      <button id="close-onboarding-modal" class="p-1.5 sm:p-2 hover:bg-slate-100 dark:hover:bg-gray-700 rounded-full transition-all flex-shrink-0">
        <X size={20} />
      </button>
    </div>

    <!-- Scrollable content -->
    <div class="flex-1 overflow-y-auto px-4 sm:px-6 py-4">

      <!-- App description -->
      <div class="onboarding-section">
        <div class="mb-4 relative overflow-hidden rounded-xl border-2 border-blue-300 dark:border-blue-700 shadow-lg">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-100 via-indigo-50 to-purple-100 dark:from-blue-900/40 dark:via-indigo-900/30 dark:to-purple-900/40"></div>
          <div class="absolute top-0 right-0 w-32 h-32 bg-blue-200/30 dark:bg-blue-700/20 rounded-full -mr-16 -mt-16 blur-2xl"></div>
          <div class="absolute bottom-0 left-0 w-24 h-24 bg-indigo-200/30 dark:bg-indigo-700/20 rounded-full -ml-12 -mb-12 blur-2xl"></div>

          <div class="relative p-5 sm:p-6">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 mb-3 bg-blue-500 text-white rounded-full text-xs font-bold shadow-md">
              <span>⏱️</span>
              <span>25 min</span>
            </div>

            <p class="text-base sm:text-lg text-slate-900 dark:text-gray-50 mb-3 font-bold leading-tight text-balance">
              {t('modal.onboarding.subtitle')}
            </p>

            <div class="mb-3 p-3 bg-white/60 dark:bg-gray-900/40 rounded-lg backdrop-blur-sm">
              <div class="grid grid-cols-4 gap-1.5 sm:gap-2">
                <div class="text-center p-2 bg-indigo-500/10 dark:bg-indigo-500/20 rounded-lg border border-indigo-300/50 dark:border-indigo-700/50">
                  <div class="text-lg sm:text-xl mb-0.5">🧘</div>
                  <div class="text-[10px] sm:text-xs font-bold text-indigo-700 dark:text-indigo-300 leading-tight">{lang === 'es' ? 'Inhibir' : 'Inhibit'}</div>
                </div>
                <div class="text-center p-2 bg-teal-500/10 dark:bg-teal-500/20 rounded-lg border border-teal-300/50 dark:border-teal-700/50">
                  <div class="text-lg sm:text-xl mb-0.5">🤸</div>
                  <div class="text-[10px] sm:text-xs font-bold text-teal-700 dark:text-teal-300 leading-tight">{lang === 'es' ? 'Alargar' : 'Lengthen'}</div>
                </div>
                <div class="text-center p-2 bg-orange-500/10 dark:bg-orange-500/20 rounded-lg border border-orange-300/50 dark:border-orange-700/50">
                  <div class="text-lg sm:text-xl mb-0.5">💪</div>
                  <div class="text-[10px] sm:text-xs font-bold text-orange-700 dark:text-orange-300 leading-tight">{lang === 'es' ? 'Activar' : 'Activate'}</div>
                </div>
                <div class="text-center p-2 bg-pink-500/10 dark:bg-pink-500/20 rounded-lg border border-pink-300/50 dark:border-pink-700/50">
                  <div class="text-lg sm:text-xl mb-0.5">🏃</div>
                  <div class="text-[10px] sm:text-xs font-bold text-pink-700 dark:text-pink-300 leading-tight">{lang === 'es' ? 'Integrar' : 'Integrate'}</div>
                </div>
              </div>
            </div>

            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/70 dark:bg-gray-800/70 backdrop-blur-sm border border-slate-300 dark:border-gray-600 rounded-lg">
              <span class="text-sm">📚</span>
              <span class="text-xs font-semibold text-slate-700 dark:text-gray-300">
                {lang === 'es' ? 'Basado en 30+ estudios peer-reviewed' : 'Based on 30+ peer-reviewed studies'}
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- How to use -->
      <div class="onboarding-section">
        <h3 class="text-base sm:text-lg font-bold text-slate-800 dark:text-gray-100 mb-3 flex items-center gap-2">
          📖 {t('modal.onboarding.howToUse')}
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
          <div class="relative p-4 bg-gradient-to-br from-teal-50 to-cyan-50 dark:from-teal-900/30 dark:to-cyan-900/30 rounded-xl border-2 border-teal-200 dark:border-teal-700 shadow-md hover:shadow-xl hover:scale-105 transition-all duration-300 group overflow-hidden">
            <div class="absolute -top-8 -right-8 w-24 h-24 bg-teal-200/30 dark:bg-teal-600/20 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-500"></div>
            <div class="relative">
              <div class="w-12 h-12 bg-teal-500 rounded-xl flex items-center justify-center text-2xl mb-3 shadow-md group-hover:rotate-12 transition-transform duration-300">
                ✓
              </div>
              <h4 class="font-bold text-sm sm:text-base text-teal-900 dark:text-teal-100 mb-2">
                {t('modal.onboarding.completeTitle')}
              </h4>
              <p class="text-xs sm:text-sm text-teal-800 dark:text-teal-200/90 leading-relaxed">
                {t('modal.onboarding.completeDescription')}
              </p>
            </div>
          </div>

          <div class="relative p-4 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/30 dark:to-indigo-900/30 rounded-xl border-2 border-blue-200 dark:border-blue-700 shadow-md hover:shadow-xl hover:scale-105 transition-all duration-300 group overflow-hidden">
            <div class="absolute -top-8 -right-8 w-24 h-24 bg-blue-200/30 dark:bg-blue-600/20 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-500"></div>
            <div class="relative">
              <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center text-2xl mb-3 shadow-md group-hover:rotate-12 transition-transform duration-300">
                ℹ️
              </div>
              <h4 class="font-bold text-sm sm:text-base text-blue-900 dark:text-blue-100 mb-2">
                {t('modal.onboarding.infoTitle')}
              </h4>
              <p class="text-xs sm:text-sm text-blue-800 dark:text-blue-200/90 leading-relaxed">
                {t('modal.onboarding.infoDescription')}
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Key tips -->
      <div class="onboarding-section">
        <div class="mt-4">
          <h4 class="font-bold text-base sm:text-lg text-slate-900 dark:text-gray-100 mb-3 flex items-center gap-2">
            💡 {t('modal.onboarding.keyTipsTitle')}
          </h4>
          <div class="grid grid-cols-1 gap-2.5">
            <div class="p-3 bg-gradient-to-r from-indigo-50 to-indigo-100/50 dark:from-indigo-900/30 dark:to-indigo-800/20 rounded-lg border-l-4 border-indigo-500 shadow-sm hover:shadow-md transition-all">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center text-lg shadow-sm">
                  🔒
                </div>
                <p class="flex-1 text-xs sm:text-sm text-slate-800 dark:text-gray-200 leading-relaxed text-balance" set:html={t('modal.onboarding.keyTip1')}></p>
              </div>
            </div>

            <div class="p-3 bg-gradient-to-r from-teal-50 to-teal-100/50 dark:from-teal-900/30 dark:to-teal-800/20 rounded-lg border-l-4 border-teal-500 shadow-sm hover:shadow-md transition-all">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 bg-teal-500 rounded-lg flex items-center justify-center text-lg shadow-sm">
                  📅
                </div>
                <p class="flex-1 text-xs sm:text-sm text-slate-800 dark:text-gray-200 leading-relaxed text-balance" set:html={t('modal.onboarding.keyTip2')}></p>
              </div>
            </div>

            <div class="p-3 bg-gradient-to-r from-orange-50 to-orange-100/50 dark:from-orange-900/30 dark:to-orange-800/20 rounded-lg border-l-4 border-orange-500 shadow-sm hover:shadow-md transition-all">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 bg-orange-500 rounded-lg flex items-center justify-center text-lg shadow-sm">
                  🏆
                </div>
                <p class="flex-1 text-xs sm:text-sm text-slate-800 dark:text-gray-200 leading-relaxed text-balance" set:html={t('modal.onboarding.keyTip3')}></p>
              </div>
            </div>

            <div class="p-3 bg-gradient-to-r from-pink-50 to-pink-100/50 dark:from-pink-900/30 dark:to-pink-800/20 rounded-lg border-l-4 border-pink-500 shadow-sm hover:shadow-md transition-all">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 bg-pink-500 rounded-lg flex items-center justify-center text-lg shadow-sm">
                  ⏳
                </div>
                <p class="flex-1 text-xs sm:text-sm text-slate-800 dark:text-gray-200 leading-relaxed text-balance" set:html={t('modal.onboarding.keyTip4')}></p>
              </div>
            </div>

            <div class="p-3 bg-gradient-to-r from-red-50 to-red-100/50 dark:from-red-900/30 dark:to-red-800/20 rounded-lg border-l-4 border-red-500 shadow-sm hover:shadow-md transition-all">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 bg-red-500 rounded-lg flex items-center justify-center text-lg shadow-sm">
                  ⚠️
                </div>
                <p class="flex-1 text-xs sm:text-sm text-slate-800 dark:text-gray-200 leading-relaxed text-balance" set:html={t('modal.onboarding.keyTip5')}></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Preferences section -->
      <div class="onboarding-section">
        <div class="mb-4 p-3 sm:p-4 bg-slate-50 dark:bg-gray-900/50 rounded-lg border border-slate-200 dark:border-gray-700">
          <h3 class="text-sm sm:text-base font-bold text-slate-800 dark:text-gray-100 mb-3 flex items-center gap-2">
            ⚙️ {t('preferences.title')}
          </h3>

          <!-- Level Selector -->
          <div class="mb-3">
            <span class="text-xs sm:text-sm text-slate-700 dark:text-gray-300 font-semibold block mb-3">
              🎚️ {t('levels.selectLevel')}
            </span>
            <LevelSelector
              client:visible
              levels={[
                { key: 'principiante', label: t('levels.beginner'), desc: t('levels.beginnerDescription'), icon: '🌱', gradient: 'from-green-50 to-emerald-50', border: 'border-green-400', ring: 'ring-green-400', text: 'text-green-700', textLight: 'text-green-600' },
                { key: 'intermedio', label: t('levels.intermediate'), desc: t('levels.intermediateDescription'), icon: '🔥', gradient: 'from-orange-50 to-amber-50', border: 'border-orange-400', ring: 'ring-orange-400', text: 'text-orange-700', textLight: 'text-orange-600' },
                { key: 'avanzado', label: t('levels.advanced'), desc: t('levels.advancedDescription'), icon: '⚡', gradient: 'from-purple-50 to-violet-50', border: 'border-purple-400', ring: 'ring-purple-400', text: 'text-purple-700', textLight: 'text-purple-600' }
              ]}
            />
            <p class="text-xs text-slate-600 dark:text-gray-400 italic">
              {t('levels.description')}
            </p>
          </div>

          <!-- Language Selector -->
          <div class="mb-3">
            <label for="language-select" class="text-xs sm:text-sm text-slate-700 dark:text-gray-300 font-semibold block mb-2">
              🌐 {t('language.selector')}
            </label>
            <select
              id="language-select"
              class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-slate-700 dark:text-gray-200 font-medium text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
            >
              {Object.entries(languages).map(([code, name]) => (
                <option value={code} selected={code === lang}>
                  {name}
                </option>
              ))}
            </select>
          </div>

          <!-- Dark Mode Toggle - DISABLED -->
          <div class="opacity-60">
            <label class="text-xs sm:text-sm text-slate-700 dark:text-gray-300 font-semibold block mb-2">
              🌙 {t('darkMode.title')}
            </label>
            <button
              id="theme-toggle"
              disabled
              class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-gray-600 bg-slate-100 dark:bg-gray-700 text-slate-500 dark:text-gray-400 font-medium text-sm sm:text-base cursor-not-allowed transition-all flex items-center justify-between"
            >
              <span id="theme-toggle-text">{t('darkMode.light')}</span>
              <span class="text-xs italic">{t('common.comingSoon')}</span>
            </button>
          </div>
        </div>
      </div>

      <!-- References button -->
      <div class="onboarding-section">
        <button
          id="show-references-btn"
          class="relative w-full mb-4 px-4 sm:px-5 py-4 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 hover:from-indigo-600 hover:via-purple-600 hover:to-pink-600 text-white rounded-xl font-bold transition-all duration-300 flex items-center justify-center gap-2.5 text-sm sm:text-base shadow-lg hover:shadow-2xl hover:scale-105 group overflow-hidden"
        >
          <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
          <span class="relative text-2xl group-hover:rotate-12 transition-transform duration-300">📚</span>
          <span class="relative text-balance">{t('modal.onboarding.referencesButton')}</span>
        </button>
      </div>

      <!-- Reset progress button -->
      <div class="onboarding-section">
        <button
          id="reset-progress-btn"
          class="mt-3 w-full px-3 py-2 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 hover:border-red-300 transition-all text-xs sm:text-sm font-medium"
        >
          {t('modal.onboarding.resetProgress')}
        </button>

        <button
          id="close-onboarding-modal-btn"
          class="relative mt-3 w-full px-4 py-4 bg-gradient-to-r from-green-500 via-emerald-500 to-teal-500 hover:from-green-600 hover:via-emerald-600 hover:to-teal-600 text-white rounded-xl font-bold text-base sm:text-lg shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105 group overflow-hidden"
        >
          <div class="absolute inset-0 rounded-xl bg-green-400 opacity-0 group-hover:opacity-20 group-hover:animate-ping"></div>
          <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
          <span class="relative flex items-center justify-center gap-2">
            {t('modal.onboarding.startButton')}
            <span class="text-2xl group-hover:scale-125 transition-transform duration-300">🚀</span>
          </span>
        </button>
      </div>

    </div>
  </div>
</div>
