---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout
  title="Animation Tests - unslump!"
  description="Testing analogical celebration animations"
  lang="en"
>
  <div class="min-h-screen bg-gradient-to-br from-gray-900 to-gray-800 p-8">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-white text-4xl font-bold mb-4 text-center">Dopamine Machine 🎉</h1>
      <p class="text-gray-300 text-center mb-12">Analogical animations that mirror physiological actions</p>

      <!-- Exercise Complete Animations (Subtle) -->
      <div class="bg-white rounded-xl p-8 mb-8">
        <h2 class="text-gray-700 text-2xl font-bold mb-4 text-center">Level 1: Exercise Complete (Subtle)</h2>
        <p class="text-gray-600 text-sm text-center mb-8">Quick, subtle feedback when completing an individual exercise</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

          <!-- Phase 1: Soft Release -->
          <div class="flex flex-col items-center gap-4">
            <h3 class="text-indigo-600 text-sm font-bold">INHIBIR: Soft Release</h3>
            <p class="text-gray-500 text-xs text-center italic mb-2">Like releasing tension in a muscle</p>
            <div class="animation-container">
              <Logo size="large" showProgress={true} id="exercise-logo-1" />
            </div>
            <button onclick="triggerExercise1()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition text-sm">
              Trigger
            </button>
          </div>

          <!-- Phase 2: Gentle Stretch -->
          <div class="flex flex-col items-center gap-4">
            <h3 class="text-teal-500 text-sm font-bold">ALARGAR: Gentle Stretch</h3>
            <p class="text-gray-500 text-xs text-center italic mb-2">Like elongating a tight muscle</p>
            <div class="animation-container">
              <Logo size="large" showProgress={true} id="exercise-logo-2" />
            </div>
            <button onclick="triggerExercise2()" class="px-4 py-2 bg-teal-500 text-white rounded-lg hover:bg-teal-600 transition text-sm">
              Trigger
            </button>
          </div>

          <!-- Phase 3: Explosive Contraction -->
          <div class="flex flex-col items-center gap-4">
            <h3 class="text-orange-500 text-sm font-bold">ACTIVAR: Explosive Contraction</h3>
            <p class="text-gray-500 text-xs text-center italic mb-2">Like a rapid muscle contraction burst</p>
            <div class="animation-container">
              <Logo size="large" showProgress={true} id="exercise-logo-3" />
            </div>
            <button onclick="triggerExercise3()" class="px-4 py-2 bg-orange-500 text-white rounded-lg hover:bg-orange-600 transition text-sm">
              Trigger
            </button>
          </div>

          <!-- Phase 4: Subtle Flow -->
          <div class="flex flex-col items-center gap-4">
            <h3 class="text-pink-500 text-sm font-bold">INTEGRAR: Subtle Flow</h3>
            <p class="text-gray-500 text-xs text-center italic mb-2">Like coordinated movement</p>
            <div class="animation-container">
              <Logo size="large" showProgress={true} id="exercise-logo-4" />
            </div>
            <button onclick="triggerExercise4()" class="px-4 py-2 bg-pink-500 text-white rounded-lg hover:bg-pink-600 transition text-sm">
              Trigger
            </button>
          </div>

        </div>
      </div>

      <!-- Phase Complete Animations (Medium) -->
      <div class="bg-white rounded-xl p-8 mb-8">
        <h2 class="text-gray-700 text-2xl font-bold mb-4 text-center">Level 2: Phase Complete (Medium)</h2>
        <p class="text-gray-600 text-sm text-center mb-8">Celebrate completing an entire phase with confetti from letter edge</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

          <!-- Phase 1: INHIBIR -->
          <div class="flex flex-col items-center gap-4">
            <h3 class="text-indigo-600 text-lg font-bold">Phase 1: INHIBIR (un)</h3>
            <p class="text-gray-500 text-sm text-center italic">Compression → Release</p>
            <div class="animation-container-large relative">
              <Logo size="large" showProgress={true} id="phase-logo-1" />
              <canvas id="confetti-canvas-1" class="absolute inset-0 pointer-events-none"></canvas>
            </div>

            <!-- Progress Control -->
            <div class="w-full max-w-sm">
              <label class="text-gray-700 text-sm font-semibold flex items-center justify-between mb-2">
                <span>Progress</span>
                <span id="phase1-progress-value" class="text-indigo-600">0%</span>
              </label>
              <input type="range" id="phase1-progress" min="0" max="100" value="0" class="w-full accent-indigo-600" />
            </div>

            <div class="flex gap-2 w-full max-w-sm">
              <button onclick="resetPhase1()" class="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition text-sm font-semibold">
                Reset
              </button>
              <button onclick="triggerPhase1()" class="flex-1 px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-semibold">
                Complete
              </button>
            </div>
          </div>

          <!-- Phase 2: ALARGAR -->
          <div class="flex flex-col items-center gap-4">
            <h3 class="text-teal-500 text-lg font-bold">Phase 2: ALARGAR (sl)</h3>
            <p class="text-gray-500 text-sm text-center italic">Lateral Stretch</p>
            <div class="animation-container-large relative">
              <Logo size="large" showProgress={true} id="phase-logo-2" />
              <canvas id="confetti-canvas-2" class="absolute inset-0 pointer-events-none"></canvas>
            </div>

            <!-- Progress Control -->
            <div class="w-full max-w-sm">
              <label class="text-gray-700 text-sm font-semibold flex items-center justify-between mb-2">
                <span>Progress</span>
                <span id="phase2-progress-value" class="text-teal-500">0%</span>
              </label>
              <input type="range" id="phase2-progress" min="0" max="100" value="0" class="w-full accent-teal-500" />
            </div>

            <div class="flex gap-2 w-full max-w-sm">
              <button onclick="resetPhase2()" class="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition text-sm font-semibold">
                Reset
              </button>
              <button onclick="triggerPhase2()" class="flex-1 px-4 py-2 bg-teal-500 text-white rounded-lg hover:bg-teal-600 transition font-semibold">
                Complete
              </button>
            </div>
          </div>

          <!-- Phase 3: ACTIVAR -->
          <div class="flex flex-col items-center gap-4">
            <h3 class="text-orange-500 text-lg font-bold">Phase 3: ACTIVAR (um)</h3>
            <p class="text-gray-500 text-sm text-center italic">Rapid Activation Bursts</p>
            <div class="animation-container-large relative">
              <Logo size="large" showProgress={true} id="phase-logo-3" />
              <canvas id="confetti-canvas-3" class="absolute inset-0 pointer-events-none"></canvas>
            </div>

            <!-- Progress Control -->
            <div class="w-full max-w-sm">
              <label class="text-gray-700 text-sm font-semibold flex items-center justify-between mb-2">
                <span>Progress</span>
                <span id="phase3-progress-value" class="text-orange-500">0%</span>
              </label>
              <input type="range" id="phase3-progress" min="0" max="100" value="0" class="w-full accent-orange-500" />
            </div>

            <div class="flex gap-2 w-full max-w-sm">
              <button onclick="resetPhase3()" class="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition text-sm font-semibold">
                Reset
              </button>
              <button onclick="triggerPhase3()" class="flex-1 px-4 py-2 bg-orange-500 text-white rounded-lg hover:bg-orange-600 transition font-semibold">
                Complete
              </button>
            </div>
          </div>

          <!-- Phase 4: INTEGRAR -->
          <div class="flex flex-col items-center gap-4">
            <h3 class="text-pink-500 text-lg font-bold">Phase 4: INTEGRAR (p!)</h3>
            <p class="text-gray-500 text-sm text-center italic">Flowing Integration</p>
            <div class="animation-container-large relative">
              <Logo size="large" showProgress={true} id="phase-logo-4" />
              <canvas id="confetti-canvas-4" class="absolute inset-0 pointer-events-none"></canvas>
            </div>

            <!-- Progress Control -->
            <div class="w-full max-w-sm">
              <label class="text-gray-700 text-sm font-semibold flex items-center justify-between mb-2">
                <span>Progress</span>
                <span id="phase4-progress-value" class="text-pink-500">0%</span>
              </label>
              <input type="range" id="phase4-progress" min="0" max="100" value="0" class="w-full accent-pink-500" />
            </div>

            <div class="flex gap-2 w-full max-w-sm">
              <button onclick="resetPhase4()" class="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition text-sm font-semibold">
                Reset
              </button>
              <button onclick="triggerPhase4()" class="flex-1 px-4 py-2 bg-pink-500 text-white rounded-lg hover:bg-pink-600 transition font-semibold">
                Complete
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- Session Complete Animations (Epic) -->
      <div class="bg-white rounded-xl p-8">
        <h2 class="text-gray-700 text-3xl font-bold mb-4 text-center">Level 3: Session Complete (Epic)</h2>
        <p class="text-gray-600 text-sm text-center mb-8">Massive celebrations for completing all 4 phases!</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

          <!-- Sequential Story -->
          <div class="flex flex-col items-center gap-4 border-2 border-gray-200 rounded-xl p-6">
            <h3 class="text-gray-700 text-lg font-bold">Sequential Story</h3>
            <p class="text-gray-500 text-sm text-center italic">Each phase animates in sequence</p>
            <div class="animation-container-epic relative">
              <Logo size="xl" showProgress={true} id="session-logo-1" />
              <canvas id="confetti-canvas-session-1" class="absolute inset-0 pointer-events-none"></canvas>
            </div>

            <!-- Progress Control -->
            <div class="w-full max-w-sm">
              <label class="text-gray-700 text-sm font-semibold flex items-center justify-between mb-2">
                <span>Session Progress</span>
                <span id="session1-progress-value" class="text-purple-600">0%</span>
              </label>
              <input type="range" id="session1-progress" min="0" max="100" value="0" class="w-full accent-purple-600" />
            </div>

            <div class="flex gap-2 w-full max-w-sm">
              <button onclick="resetSession1()" class="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition text-sm font-semibold">
                Reset
              </button>
              <button onclick="triggerSession1()" class="flex-1 px-4 py-3 bg-gradient-to-r from-indigo-600 to-pink-600 text-white rounded-lg hover:opacity-90 transition font-bold shadow-lg">
                🎉 Complete
              </button>
            </div>
          </div>

          <!-- Transformation -->
          <div class="flex flex-col items-center gap-4 border-2 border-gray-200 rounded-xl p-6">
            <h3 class="text-gray-700 text-lg font-bold">Transformation</h3>
            <p class="text-gray-500 text-sm text-center italic">From bad to perfect posture</p>
            <div class="animation-container-epic relative">
              <Logo size="xl" showProgress={true} id="session-logo-2" />
              <canvas id="confetti-canvas-session-2" class="absolute inset-0 pointer-events-none"></canvas>
            </div>

            <!-- Progress Control -->
            <div class="w-full max-w-sm">
              <label class="text-gray-700 text-sm font-semibold flex items-center justify-between mb-2">
                <span>Session Progress</span>
                <span id="session2-progress-value" class="text-purple-600">0%</span>
              </label>
              <input type="range" id="session2-progress" min="0" max="100" value="0" class="w-full accent-purple-600" />
            </div>

            <div class="flex gap-2 w-full max-w-sm">
              <button onclick="resetSession2()" class="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition text-sm font-semibold">
                Reset
              </button>
              <button onclick="triggerSession2()" class="flex-1 px-4 py-3 bg-gradient-to-r from-indigo-600 to-pink-600 text-white rounded-lg hover:opacity-90 transition font-bold shadow-lg">
                ✨ Complete
              </button>
            </div>
          </div>

          <!-- Unity Wave -->
          <div class="flex flex-col items-center gap-4 border-2 border-gray-200 rounded-xl p-6">
            <h3 class="text-gray-700 text-lg font-bold">Unity Wave</h3>
            <p class="text-gray-500 text-sm text-center italic">Bouncing wave + synchronized rotation</p>
            <div class="animation-container-epic relative">
              <Logo size="xl" showProgress={true} id="session-logo-3" />
              <canvas id="confetti-canvas-session-3" class="absolute inset-0 pointer-events-none"></canvas>
            </div>

            <!-- Progress Control -->
            <div class="w-full max-w-sm">
              <label class="text-gray-700 text-sm font-semibold flex items-center justify-between mb-2">
                <span>Session Progress</span>
                <span id="session3-progress-value" class="text-purple-600">0%</span>
              </label>
              <input type="range" id="session3-progress" min="0" max="100" value="0" class="w-full accent-purple-600" />
            </div>

            <div class="flex gap-2 w-full max-w-sm">
              <button onclick="resetSession3()" class="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition text-sm font-semibold">
                Reset
              </button>
              <button onclick="triggerSession3()" class="flex-1 px-4 py-3 bg-gradient-to-r from-indigo-600 to-pink-600 text-white rounded-lg hover:opacity-90 transition font-bold shadow-lg">
                🌊 Complete
              </button>
            </div>
          </div>

          <!-- Dopamine Explosion -->
          <div class="flex flex-col items-center gap-4 border-2 border-gray-200 rounded-xl p-6">
            <h3 class="text-gray-700 text-lg font-bold">Dopamine Explosion</h3>
            <p class="text-gray-500 text-sm text-center italic">720° rotation with massive confetti</p>
            <div class="animation-container-epic relative">
              <Logo size="xl" showProgress={true} id="session-logo-4" />
              <canvas id="confetti-canvas-session-4" class="absolute inset-0 pointer-events-none"></canvas>
            </div>

            <!-- Progress Control -->
            <div class="w-full max-w-sm">
              <label class="text-gray-700 text-sm font-semibold flex items-center justify-between mb-2">
                <span>Session Progress</span>
                <span id="session4-progress-value" class="text-purple-600">0%</span>
              </label>
              <input type="range" id="session4-progress" min="0" max="100" value="0" class="w-full accent-purple-600" />
            </div>

            <div class="flex gap-2 w-full max-w-sm">
              <button onclick="resetSession4()" class="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition text-sm font-semibold">
                Reset
              </button>
              <button onclick="triggerSession4()" class="flex-1 px-4 py-3 bg-gradient-to-r from-indigo-600 to-pink-600 text-white rounded-lg hover:opacity-90 transition font-bold shadow-lg">
                💥 Complete
              </button>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <style>
    .animation-container {
      min-height: 150px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .animation-container-large {
      min-height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .animation-container-epic {
      min-height: 300px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    /* Keyframe for bounce (used in wave animation) */
    @keyframes bounceHigh {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-30px); }
    }

    /* Keyframe for rotation (used in wave animation) */
    @keyframes spin360 {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>

  <script>
    // @ts-nocheck
    import {
      animateExerciseComplete,
      animatePhaseComplete,
      resetPhaseProgress,
      setPhaseProgress,
      resetSessionProgress,
      setSessionProgress,
      animateSessionSequential,
      animateSessionTransformation,
      animateSessionWave,
      animateSessionExplosion,
    } from '../utils/celebrationAnimations';

    // Exercise animations
    function triggerExercise1() {
      animateExerciseComplete('exercise-logo-1', 'fase1');
    }

    function triggerExercise2() {
      animateExerciseComplete('exercise-logo-2', 'fase2');
    }

    function triggerExercise3() {
      animateExerciseComplete('exercise-logo-3', 'fase3');
    }

    function triggerExercise4() {
      animateExerciseComplete('exercise-logo-4', 'fase4');
    }

    // Phase animations
    function triggerPhase1() {
      animatePhaseComplete('phase-logo-1', 'fase1', 'confetti-canvas-1');
    }

    function triggerPhase2() {
      animatePhaseComplete('phase-logo-2', 'fase2', 'confetti-canvas-2');
    }

    function triggerPhase3() {
      animatePhaseComplete('phase-logo-3', 'fase3', 'confetti-canvas-3');
    }

    function triggerPhase4() {
      animatePhaseComplete('phase-logo-4', 'fase4', 'confetti-canvas-4');
    }

    // Phase reset functions
    function resetPhase1() {
      resetPhaseProgress('phase-logo-1', 'fase1');
      const slider = document.getElementById('phase1-progress') as HTMLInputElement;
      const value = document.getElementById('phase1-progress-value');
      if (slider) slider.value = '0';
      if (value) value.textContent = '0%';
    }

    function resetPhase2() {
      resetPhaseProgress('phase-logo-2', 'fase2');
      const slider = document.getElementById('phase2-progress') as HTMLInputElement;
      const value = document.getElementById('phase2-progress-value');
      if (slider) slider.value = '0';
      if (value) value.textContent = '0%';
    }

    function resetPhase3() {
      resetPhaseProgress('phase-logo-3', 'fase3');
      const slider = document.getElementById('phase3-progress') as HTMLInputElement;
      const value = document.getElementById('phase3-progress-value');
      if (slider) slider.value = '0';
      if (value) value.textContent = '0%';
    }

    function resetPhase4() {
      resetPhaseProgress('phase-logo-4', 'fase4');
      const slider = document.getElementById('phase4-progress') as HTMLInputElement;
      const value = document.getElementById('phase4-progress-value');
      if (slider) slider.value = '0';
      if (value) value.textContent = '0%';
    }

    // Phase progress sliders
    const phase1Slider = document.getElementById('phase1-progress') as HTMLInputElement;
    const phase1Value = document.getElementById('phase1-progress-value');
    if (phase1Slider && phase1Value) {
      phase1Slider.addEventListener('input', () => {
        const progress = parseInt(phase1Slider.value);
        phase1Value.textContent = `${progress}%`;
        setPhaseProgress('phase-logo-1', 'fase1', progress);
      });
    }

    const phase2Slider = document.getElementById('phase2-progress') as HTMLInputElement;
    const phase2Value = document.getElementById('phase2-progress-value');
    if (phase2Slider && phase2Value) {
      phase2Slider.addEventListener('input', () => {
        const progress = parseInt(phase2Slider.value);
        phase2Value.textContent = `${progress}%`;
        setPhaseProgress('phase-logo-2', 'fase2', progress);
      });
    }

    const phase3Slider = document.getElementById('phase3-progress') as HTMLInputElement;
    const phase3Value = document.getElementById('phase3-progress-value');
    if (phase3Slider && phase3Value) {
      phase3Slider.addEventListener('input', () => {
        const progress = parseInt(phase3Slider.value);
        phase3Value.textContent = `${progress}%`;
        setPhaseProgress('phase-logo-3', 'fase3', progress);
      });
    }

    const phase4Slider = document.getElementById('phase4-progress') as HTMLInputElement;
    const phase4Value = document.getElementById('phase4-progress-value');
    if (phase4Slider && phase4Value) {
      phase4Slider.addEventListener('input', () => {
        const progress = parseInt(phase4Slider.value);
        phase4Value.textContent = `${progress}%`;
        setPhaseProgress('phase-logo-4', 'fase4', progress);
      });
    }

    // Session animations
    function triggerSession1() {
      animateSessionSequential('session-logo-1', 'confetti-canvas-session-1');
    }

    function triggerSession2() {
      animateSessionTransformation('session-logo-2', 'confetti-canvas-session-2');
    }

    function triggerSession3() {
      animateSessionWave('session-logo-3', 'confetti-canvas-session-3');
    }

    function triggerSession4() {
      animateSessionExplosion('session-logo-4', 'confetti-canvas-session-4');
    }

    // Session reset functions
    function resetSession1() {
      resetSessionProgress('session-logo-1');
      const slider = document.getElementById('session1-progress') as HTMLInputElement;
      const value = document.getElementById('session1-progress-value');
      if (slider) slider.value = '0';
      if (value) value.textContent = '0%';
    }

    function resetSession2() {
      resetSessionProgress('session-logo-2');
      const slider = document.getElementById('session2-progress') as HTMLInputElement;
      const value = document.getElementById('session2-progress-value');
      if (slider) slider.value = '0';
      if (value) value.textContent = '0%';
    }

    function resetSession3() {
      resetSessionProgress('session-logo-3');
      const slider = document.getElementById('session3-progress') as HTMLInputElement;
      const value = document.getElementById('session3-progress-value');
      if (slider) slider.value = '0';
      if (value) value.textContent = '0%';
    }

    function resetSession4() {
      resetSessionProgress('session-logo-4');
      const slider = document.getElementById('session4-progress') as HTMLInputElement;
      const value = document.getElementById('session4-progress-value');
      if (slider) slider.value = '0';
      if (value) value.textContent = '0%';
    }

    // Session progress sliders
    const session1Slider = document.getElementById('session1-progress') as HTMLInputElement;
    const session1Value = document.getElementById('session1-progress-value');
    if (session1Slider && session1Value) {
      session1Slider.addEventListener('input', () => {
        const progress = parseInt(session1Slider.value);
        session1Value.textContent = `${progress}%`;
        setSessionProgress('session-logo-1', progress);
      });
    }

    const session2Slider = document.getElementById('session2-progress') as HTMLInputElement;
    const session2Value = document.getElementById('session2-progress-value');
    if (session2Slider && session2Value) {
      session2Slider.addEventListener('input', () => {
        const progress = parseInt(session2Slider.value);
        session2Value.textContent = `${progress}%`;
        setSessionProgress('session-logo-2', progress);
      });
    }

    const session3Slider = document.getElementById('session3-progress') as HTMLInputElement;
    const session3Value = document.getElementById('session3-progress-value');
    if (session3Slider && session3Value) {
      session3Slider.addEventListener('input', () => {
        const progress = parseInt(session3Slider.value);
        session3Value.textContent = `${progress}%`;
        setSessionProgress('session-logo-3', progress);
      });
    }

    const session4Slider = document.getElementById('session4-progress') as HTMLInputElement;
    const session4Value = document.getElementById('session4-progress-value');
    if (session4Slider && session4Value) {
      session4Slider.addEventListener('input', () => {
        const progress = parseInt(session4Slider.value);
        session4Value.textContent = `${progress}%`;
        setSessionProgress('session-logo-4', progress);
      });
    }

    // Make functions global for onclick handlers
    window.triggerExercise1 = triggerExercise1;
    window.triggerExercise2 = triggerExercise2;
    window.triggerExercise3 = triggerExercise3;
    window.triggerExercise4 = triggerExercise4;
    window.triggerPhase1 = triggerPhase1;
    window.triggerPhase2 = triggerPhase2;
    window.triggerPhase3 = triggerPhase3;
    window.triggerPhase4 = triggerPhase4;
    window.resetPhase1 = resetPhase1;
    window.resetPhase2 = resetPhase2;
    window.resetPhase3 = resetPhase3;
    window.resetPhase4 = resetPhase4;
    window.triggerSession1 = triggerSession1;
    window.triggerSession2 = triggerSession2;
    window.triggerSession3 = triggerSession3;
    window.triggerSession4 = triggerSession4;
    window.resetSession1 = resetSession1;
    window.resetSession2 = resetSession2;
    window.resetSession3 = resetSession3;
    window.resetSession4 = resetSession4;
  </script>
</BaseLayout>
