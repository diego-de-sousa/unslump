---
/**
 * Guided Workout Page
 * Full-screen automatic workout flow
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import WorkoutNavigator from '../../components/islands/WorkoutNavigator';
import PhaseTransition from '../../components/workout/PhaseTransition.astro';
import ExercisePrep from '../../components/workout/ExercisePrep.astro';
import FullscreenExercise from '../../components/workout/FullscreenExercise.astro';
import RestPeriod from '../../components/workout/RestPeriod.astro';
import WorkoutSettingsModal from '../../components/modals/WorkoutSettingsModal.astro';
import ReferencesModal from '../../components/modals/ReferencesModal.astro';
import WorkoutOnboardingModal from '../../components/modals/WorkoutOnboardingModal.astro';
import Toast from '../../components/Toast.astro';
import { getWorkout, getExerciseDetails, getReferences } from '../../data';
import { useTranslations, getLangFromUrl } from '../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'es' } }];
}

const lang = getLangFromUrl(Astro.url) as 'en' | 'es';
const t = useTranslations(lang);
const workout = getWorkout(lang);
const exerciseDetails = getExerciseDetails(lang);
const references = getReferences(lang);
const phases = Object.entries(workout);

const title = t('meta.title');
const description = t('meta.description');
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Workout Container -->
  <div id="workoutContainer" class="workout-container fixed inset-0 bg-white">
    <!-- Navigation Header -->
    <header class="workout-header fixed top-0 left-0 right-0 z-50 bg-white shadow-sm">
      <div class="flex items-center justify-between px-4 py-2">
        <!-- Left: Exit Button (most important action) -->
        <button
          id="exitButton"
          class="rounded-full bg-gray-100 p-2 hover:bg-gray-200 transition-colors"
          title={t('guidedWorkout.navigation.exit')}
        >
          <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <!-- Center: Interactive Progress Logo with Navigation -->
        <div class="flex-1 flex items-center justify-center">
          <button
            id="logoNavigationButton"
            class="transition-all duration-200 hover:opacity-80"
            title="Open workout navigation"
          >
            <Logo size="medium" showProgress={true} id="progressLogo" />
          </button>
        </div>

        <!-- Right: Settings Button -->
        <button
          id="settingsButton"
          class="rounded-full bg-gray-100 p-2 hover:bg-gray-200 transition-colors"
          title={t('guidedWorkout.navigation.settings')}
        >
          <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Navigation Buttons (Left side) - Only visible when paused -->
    <div id="navigationButtons" class="fixed bottom-6 left-4 z-50 flex-col gap-2 hidden">
      <!-- Previous Exercise Button -->
      <button
        id="previousButton"
        class="rounded-full bg-white/90 backdrop-blur p-3 shadow-lg hover:bg-white transition-all duration-200 hover:scale-105 active:scale-95"
        title={t('guidedWorkout.navigation.back')}
      >
        <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Complete Current Timer Button (for sides/sets) -->
      <button
        id="completeTimerButton"
        class="rounded-full bg-white/90 backdrop-blur p-3 shadow-lg hover:bg-white transition-all duration-200 hover:scale-105 active:scale-95"
        title={lang === 'es' ? 'Finalizar lado/serie actual' : 'Complete current side/set'}
      >
        <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Skip Exercise Button -->
      <button
        id="skipButton"
        class="rounded-full bg-white/90 backdrop-blur p-3 shadow-lg hover:bg-white transition-all duration-200 hover:scale-105 active:scale-95"
        title={t('guidedWorkout.navigation.skip')}
      >
        <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Floating Action Button (Pause/Play + Timer/Counter) - Right side -->
    <div class="fixed bottom-6 right-4 z-50">
      <!-- Side Indicators (Left/Right arrows for bilateral exercises) -->
      <div id="leftSideIndicator" class="absolute -top-1 left-0 hidden pointer-events-none">
        <svg id="leftSideArrow" class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" style="color: rgb(79, 70, 229);">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </div>

      <div id="rightSideIndicator" class="absolute -top-1 right-0 hidden pointer-events-none">
        <svg id="rightSideArrow" class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" style="color: rgb(79, 70, 229);">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </div>

      <!-- Set Counter (above FAB for exercises with sets) -->
      <div id="setCounterIndicator" class="absolute left-1/2 -translate-x-1/2 -top-10 hidden pointer-events-none">
        <span id="setCounterText" class="text-xs font-semibold text-gray-500 bg-white/80 backdrop-blur px-2 py-0.5 rounded-full">1/3</span>
      </div>

      <!-- FAB Container -->
      <div class="w-[88px] h-[88px]">
        <!-- Circular Progress Ring -->
        <svg id="fabProgressRing" class="absolute inset-0 w-full h-full -rotate-90 pointer-events-none hidden" viewBox="0 0 88 88">
          <!-- Background circle (pulsing) -->
          <circle
            id="fabProgressBg"
            cx="44"
            cy="44"
            r="40"
            fill="none"
            stroke="rgba(79, 70, 229, 0.2)"
            stroke-width="3"
            style="transition: all 0.15s ease-out;"
          />
          <!-- Progress circle -->
          <circle
            id="fabProgressCircle"
            cx="44"
            cy="44"
            r="40"
            fill="none"
            stroke="rgb(79, 70, 229)"
            stroke-width="3"
            stroke-linecap="round"
            stroke-dasharray="251.2"
            stroke-dashoffset="251.2"
            style="transition: stroke-dashoffset 1s linear, stroke-width 0.15s ease-out;"
          />
        </svg>

        <button
          id="pausePlayButton"
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full text-white shadow-xl transition-all duration-200 hover:scale-105 active:scale-95 flex flex-col items-center justify-center gap-1 p-4 w-[72px] h-[72px]"
          style="background-color: rgb(79, 70, 229);"
          title={t('guidedWorkout.navigation.pause')}
        >
          <!-- Timer/Counter Display (shown when active, in single line) -->
          <div id="fabTimerDisplay" class="text-center hidden">
            <div id="fabTimerText" class="font-mono text-xl font-bold leading-none" style="transition: transform 0.15s ease-out, font-size 0.2s ease-out, opacity 0.2s ease-out;">
              <span id="fabTimer">00</span>
            </div>
          </div>

          <!-- Pause Icon (smaller, shown when playing with timer) -->
          <svg id="pauseIcon" class="h-6 w-6 transition-all duration-200" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
          </svg>

          <!-- Check Icon (shown for manual completion) -->
          <svg id="checkIcon" class="h-7 w-7 hidden transition-all duration-200" fill="currentColor" viewBox="0 0 24 24">
            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
          </svg>

          <!-- Play Icon (shown when paused, larger) -->
          <svg id="playIcon" class="h-10 w-10 hidden transition-all duration-200" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Workout Navigator Panel -->
    <WorkoutNavigator lang={lang} client:load />

    <!-- Main Workout Content Area -->
    <main id="workoutContent" class="workout-content pt-12">
      <!-- Content will be dynamically rendered based on workout state -->
      <div id="stateContainer" class="h-full">
        <!-- Initial state: loading -->
        <div class="flex h-full items-center justify-center">
          <div class="text-center">
            <div class="mb-4 h-12 w-12 animate-spin rounded-full border-4 border-indigo-500 border-t-transparent mx-auto"></div>
            <p class="text-gray-600">{lang === 'es' ? 'Cargando...' : 'Loading...'}</p>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Settings Modal -->
  <WorkoutSettingsModal lang={lang} />

  <!-- References Modal -->
  <ReferencesModal lang={lang} references={references} />

  <!-- Onboarding Modal -->
  <WorkoutOnboardingModal lang={lang} />

  <!-- Toast Notifications -->
  <Toast />

  <!-- Resume Session Modal -->
  <div id="resumeModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50">
    <div class="mx-4 max-w-md rounded-2xl bg-white p-6 shadow-2xl">
      <h3 class="mb-4 text-xl font-bold">{t('guidedWorkout.resumeSession')}</h3>
      <div class="flex gap-3">
        <button id="resumeButton" class="flex-1 rounded-lg bg-indigo-600 px-4 py-3 font-bold text-white hover:bg-indigo-700">
          {t('guidedWorkout.resumeButton')}
        </button>
        <button id="startNewButton" class="flex-1 rounded-lg bg-gray-200 px-4 py-3 font-semibold text-gray-700 hover:bg-gray-300">
          {t('guidedWorkout.startNewButton')}
        </button>
      </div>
    </div>
  </div>

  <!-- Exercise Info Modal -->
  <div id="exerciseInfoModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4">
    <div class="relative max-h-[90vh] max-w-2xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
      <!-- Close Button -->
      <button id="closeExerciseInfoButton" class="absolute right-4 top-4 rounded-full bg-gray-100 p-2 hover:bg-gray-200 transition-colors">
        <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Modal Content (will be populated dynamically) -->
      <div id="exerciseInfoContent">
        <!-- Content injected by JavaScript -->
      </div>
    </div>
  </div>

  <!-- Pass data to the client-side script -->
  <script is:inline define:vars={{ workout, exerciseDetails, lang, exitConfirmText: t('guidedWorkout.navigation.exitConfirm'), resetConfirmText: t('progress.resetConfirm') }}>
    // Expose data globally for the module script
    window.__WORKOUT_DATA__ = workout;
    window.__EXERCISE_DETAILS__ = exerciseDetails;
    window.__WORKOUT_LANG__ = lang;
    window.__EXIT_CONFIRM_TEXT__ = exitConfirmText;
    window.__RESET_CONFIRM_TEXT__ = resetConfirmText;
  </script>

  <!-- Main workout script as module -->
  <script>
    import { initializeWorkoutController, startWorkout, loadSessionState, pauseWorkout, resumeFromPause, skipExercise, previousExercise, exitWorkout, workoutSession, overallProgress } from '../../stores/workoutController';
    import { toggleNavigator } from '../../stores/navigationStore';
    import { soundController } from '../../utils/soundController';
    import { initWorkoutOrchestrator } from '../../scripts/workoutOrchestrator';
    import { toast } from '../../utils/toast';

    // Get data from global
    const workout = (window as any).__WORKOUT_DATA__;
    const exerciseDetails = (window as any).__EXERCISE_DETAILS__;
    const lang = (window as any).__WORKOUT_LANG__;
    const exitConfirmText = (window as any).__EXIT_CONFIRM_TEXT__;
    const resetConfirmText = (window as any).__RESET_CONFIRM_TEXT__;

    let isPaused = false;
    let wasPausedBeforeModal = false;

    // Expose functions globally for orchestrator to call
    (window as any).showExerciseInfo = showExerciseInfo;
    (window as any).updatePauseUI = updatePauseUI;

    // Update pause UI elements
    function updatePauseUI(paused: boolean) {
      isPaused = paused;
      const pauseIcon = document.getElementById('pauseIcon');
      const playIcon = document.getElementById('playIcon');
      const checkIcon = document.getElementById('checkIcon');
      const navButtons = document.getElementById('navigationButtons');
      const fabTimerText = document.getElementById('fabTimerText');

      if (paused) {
        // Show play icon (LARGE) and nav buttons
        // KEEP timer and progress visible but frozen
        // Make timer smaller and play icon larger
        pauseIcon?.classList.add('hidden');
        checkIcon?.classList.add('hidden');
        playIcon?.classList.remove('hidden');
        navButtons?.classList.remove('hidden');
        navButtons?.classList.add('flex');

        // Make play icon LARGE (primary action)
        if (playIcon) {
          playIcon.style.width = '2.5rem'; // h-10
          playIcon.style.height = '2.5rem';
        }

        // Shrink timer text when paused (secondary info)
        if (fabTimerText) {
          fabTimerText.style.fontSize = '0.875rem'; // text-sm
          fabTimerText.style.opacity = '0.6';
        }
      } else {
        // Hide play icon and nav buttons
        playIcon?.classList.add('hidden');
        navButtons?.classList.remove('flex');
        navButtons?.classList.add('hidden');

        // Will show pause or check icon depending on exercise state
        // (decided in updateFabDisplay)

        // Restore timer text size when playing (primary info)
        if (fabTimerText) {
          fabTimerText.style.fontSize = '1.25rem'; // text-xl
          fabTimerText.style.opacity = '1';
        }
      }
    }

    // Track last time left for pulse animation
    let lastTimeLeft = -1;

    // Update FAB (Floating Action Button) timer/counter display
    function updateFabDisplay(state: any, timeLeft: number, currentSet?: number, totalSets?: number, totalDuration?: number, phaseColor?: string, currentSide?: number, totalSides?: number) {
      const fabTimerDisplay = document.getElementById('fabTimerDisplay');
      const fabTimer = document.getElementById('fabTimer');
      const pauseIcon = document.getElementById('pauseIcon');
      const checkIcon = document.getElementById('checkIcon');
      const playIcon = document.getElementById('playIcon');
      const progressRing = document.getElementById('fabProgressRing');
      const progressCircle = document.getElementById('fabProgressCircle');
      const progressBg = document.getElementById('fabProgressBg');
      const fabButton = document.getElementById('pausePlayButton');
      const leftSideIndicator = document.getElementById('leftSideIndicator');
      const rightSideIndicator = document.getElementById('rightSideIndicator');
      const leftSideArrow = document.getElementById('leftSideArrow');
      const rightSideArrow = document.getElementById('rightSideArrow');
      const setCounterIndicator = document.getElementById('setCounterIndicator');
      const setCounterText = document.getElementById('setCounterText');

      if (!fabTimerDisplay || !fabTimer || !pauseIcon || !checkIcon) return;

      const circumference = 2 * Math.PI * 40; // radius = 40

      // Use phase color if provided, otherwise default indigo
      const color = phaseColor || '#4f46e5';

      // Update button background color with phase color
      if (fabButton) {
        fabButton.style.backgroundColor = color;
      }

      // Update side arrows color with phase color
      if (leftSideArrow) {
        leftSideArrow.style.color = color;
      }
      if (rightSideArrow) {
        rightSideArrow.style.color = color;
      }

      // Update ring colors with phase color
      if (progressCircle && progressBg) {
        progressCircle.setAttribute('stroke', color);

        // Convert hex to rgba for background
        let bgColor = 'rgba(79, 70, 229, 0.2)';
        if (color.startsWith('#')) {
          // Hex color
          const hex = color.replace('#', '');
          const r = parseInt(hex.substring(0, 2), 16);
          const g = parseInt(hex.substring(2, 4), 16);
          const b = parseInt(hex.substring(4, 6), 16);
          bgColor = `rgba(${r}, ${g}, ${b}, 0.2)`;
        } else if (color.startsWith('rgb')) {
          // RGB color - extract numbers
          const rgbMatch = color.match(/\d+/g);
          if (rgbMatch && rgbMatch.length >= 3) {
            bgColor = `rgba(${rgbMatch[0]}, ${rgbMatch[1]}, ${rgbMatch[2]}, 0.2)`;
          }
        }
        progressBg.setAttribute('stroke', bgColor);
      }

      // Pulse animation when time changes (not paused, and has active timer)
      // Only pulse for exercises WITH timer (not for set counters)
      const hasActiveTimer = timeLeft > 0 && totalDuration;
      if (!isPaused && timeLeft !== lastTimeLeft && hasActiveTimer && progressCircle && progressBg) {
        lastTimeLeft = timeLeft;

        // Pulse effect on ring: briefly increase stroke width
        progressCircle.setAttribute('stroke-width', '5');
        progressBg.setAttribute('stroke-width', '5');

        // Pulse effect on timer number: scale up slightly
        const timerParent = fabTimer.parentElement as HTMLElement;
        if (timerParent) {
          timerParent.style.transform = 'scale(1.15)';
        }

        // Reset after animation
        setTimeout(() => {
          progressCircle.setAttribute('stroke-width', '3');
          progressBg.setAttribute('stroke-width', '3');
          if (timerParent) {
            timerParent.style.transform = 'scale(1)';
          }
        }, 150);
      }

      switch (state) {
        case 'EXERCISE_PREP':
          fabTimerDisplay.classList.remove('hidden');
          fabTimer.textContent = timeLeft.toString();
          pauseIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
          // Update progress ring (prep is usually 3 seconds)
          if (progressCircle && progressRing && totalDuration) {
            progressRing.classList.remove('hidden');
            const progress = (totalDuration - timeLeft) / totalDuration;
            const offset = circumference * (1 - progress);
            progressCircle.style.strokeDashoffset = offset.toString();
          }
          break;
        case 'EXERCISE_ACTIVE':
          // Check if exercise has sides (bilateral)
          if (totalSides && totalSides > 1) {
            // Exercise with sides (left/right)
            fabTimerDisplay.classList.remove('hidden');

            // Show appropriate side indicator
            const isLeftSide = currentSide === 1;
            leftSideIndicator?.classList.toggle('hidden', !isLeftSide);
            rightSideIndicator?.classList.toggle('hidden', isLeftSide);
            setCounterIndicator?.classList.add('hidden');

            if (timeLeft > 0) {
              // Sides WITH timer (e.g., 120s/side)
              // Show clean timer with pause icon
              fabTimer.textContent = timeLeft.toString();
              pauseIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');

              // Update progress ring based on timer
              if (progressCircle && progressRing && totalDuration) {
                progressRing.classList.remove('hidden');
                const progress = (totalDuration - timeLeft) / totalDuration;
                const offset = circumference * (1 - progress);
                progressCircle.style.strokeDashoffset = offset.toString();
              }
            } else {
              // Sides WITHOUT timer (manual completion per side)
              // Show side counter (1/2, 2/2) with check icon
              fabTimer.textContent = `${currentSide}/${totalSides}`;
              pauseIcon.classList.add('hidden');
              checkIcon.classList.remove('hidden');
              progressRing?.classList.add('hidden');
            }
          } else if (totalSets && totalSets > 1) {
            // Exercise with sets (series) - no sides
            fabTimerDisplay.classList.remove('hidden');
            leftSideIndicator?.classList.add('hidden');
            rightSideIndicator?.classList.add('hidden');

            // Show set counter above FAB
            if (setCounterIndicator && setCounterText) {
              setCounterIndicator.classList.remove('hidden');
              setCounterText.textContent = `${currentSet}/${totalSets}`;
            }

            if (timeLeft > 0) {
              // Series WITH timer (e.g., 3x30s plank)
              // Show clean timer with pause icon
              fabTimer.textContent = timeLeft.toString();
              pauseIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');

              // Update progress ring based on timer
              if (progressCircle && progressRing && totalDuration) {
                progressRing.classList.remove('hidden');
                const progress = (totalDuration - timeLeft) / totalDuration;
                const offset = circumference * (1 - progress);
                progressCircle.style.strokeDashoffset = offset.toString();
              }
            } else {
              // Series WITHOUT timer (e.g., 3x10 squats)
              // Show check icon for manual completion
              fabTimer.textContent = '';
              pauseIcon.classList.add('hidden');
              checkIcon.classList.remove('hidden');
              progressRing?.classList.add('hidden');
            }
          } else if (timeLeft > 0) {
            // Single exercise WITH timer (no sets, no sides)
            fabTimerDisplay.classList.remove('hidden');
            fabTimer.textContent = timeLeft.toString();
            pauseIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
            leftSideIndicator?.classList.add('hidden');
            rightSideIndicator?.classList.add('hidden');
            setCounterIndicator?.classList.add('hidden');

            // Update progress ring
            if (progressCircle && progressRing && totalDuration) {
              progressRing.classList.remove('hidden');
              const progress = (totalDuration - timeLeft) / totalDuration;
              const offset = circumference * (1 - progress);
              progressCircle.style.strokeDashoffset = offset.toString();
            }
          } else {
            // No timer, sets, or sides - manual completion
            fabTimerDisplay.classList.add('hidden');
            pauseIcon.classList.add('hidden');
            checkIcon.classList.remove('hidden');
            leftSideIndicator?.classList.add('hidden');
            rightSideIndicator?.classList.add('hidden');
            setCounterIndicator?.classList.add('hidden');
            progressRing?.classList.add('hidden');
          }
          break;
        case 'REST_PERIOD':
          fabTimerDisplay.classList.remove('hidden');
          fabTimer.textContent = timeLeft.toString();
          pauseIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
          // Update progress ring (rest is usually 5 seconds)
          if (progressCircle && progressRing && totalDuration) {
            progressRing.classList.remove('hidden');
            const progress = (totalDuration - timeLeft) / totalDuration;
            const offset = circumference * (1 - progress);
            progressCircle.style.strokeDashoffset = offset.toString();
          }
          break;
        default:
          fabTimerDisplay.classList.add('hidden');
          pauseIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
          progressRing?.classList.add('hidden');
      }
    }

    // Expose globally
    (window as any).updateFabDisplay = updateFabDisplay;

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', async () => {
      console.log('Workout page loaded');

      // Initialize workout controller with data
      initializeWorkoutController(workout);

      // Initialize orchestrator (connects state to UI)
      initWorkoutOrchestrator();

      // Load sound files (will fallback to synthesized if not found)
      soundController.loadSounds();

      // Check for existing session
      const savedSession = loadSessionState();
      if (savedSession && savedSession.workoutState !== 'IDLE') {
        // Show resume modal
        document.getElementById('resumeModal')?.classList.remove('hidden');
        document.getElementById('resumeModal')?.classList.add('flex');
      } else {
        // Start new workout
        startWorkout();
      }

      // Set up event listeners
      setupEventListeners();

      // Request wake lock
      requestWakeLock();
    });

    function setupEventListeners() {
      // Exit button
      document.getElementById('exitButton')?.addEventListener('click', handleExit);

      // Logo navigation button
      document.getElementById('logoNavigationButton')?.addEventListener('click', () => {
        toggleNavigator();
      });

      // Pause/Play button
      document.getElementById('pausePlayButton')?.addEventListener('click', handlePausePlay);

      // Settings button
      document.getElementById('settingsButton')?.addEventListener('click', handleSettings);

      // Navigation buttons
      document.getElementById('previousButton')?.addEventListener('click', handleBack);
      document.getElementById('completeTimerButton')?.addEventListener('click', handleCompleteTimer);
      document.getElementById('skipButton')?.addEventListener('click', handleSkip);

      // Modal buttons
      document.getElementById('closeSettingsButton')?.addEventListener('click', closeSettings);
      document.getElementById('closeExerciseInfoButton')?.addEventListener('click', closeExerciseInfo);
      document.getElementById('resumeButton')?.addEventListener('click', handleResume);
      document.getElementById('startNewButton')?.addEventListener('click', handleStartNew);

      // Settings modal - language selector
      document.getElementById('workout-language-select')?.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        if (confirm(lang === 'es' ? '¿Cambiar idioma?' : 'Change language?')) {
          window.location.href = `/${target.value}/workout`;
        }
      });

      // Settings modal - references button
      document.getElementById('show-references-btn-workout')?.addEventListener('click', () => {
        closeSettings();
        openReferencesModal();
      });

      // Settings modal - reset progress button
      document.getElementById('reset-progress-btn-workout')?.addEventListener('click', handleResetProgress);

      // References modal
      document.getElementById('close-references-modal')?.addEventListener('click', closeReferencesModal);
      document.getElementById('close-references-modal-btn')?.addEventListener('click', closeReferencesModal);

      // Onboarding modal
      document.getElementById('closeWorkoutOnboarding')?.addEventListener('click', closeOnboarding);
      document.getElementById('startWorkoutOnboarding')?.addEventListener('click', closeOnboarding);

      // Close modals on backdrop click
      document.getElementById('settingsModal')?.addEventListener('click', (e) => {
        if (e.target === document.getElementById('settingsModal')) {
          closeSettings();
        }
      });

      document.getElementById('references-modal')?.addEventListener('click', (e) => {
        if (e.target === document.getElementById('references-modal')) {
          closeReferencesModal();
        }
      });

      document.getElementById('workoutOnboardingModal')?.addEventListener('click', (e) => {
        if (e.target === document.getElementById('workoutOnboardingModal')) {
          closeOnboarding();
        }
      });

      // Check if this is the first time visiting workout mode
      checkOnboarding();
    }

    // Helper function to convert YouTube URLs to embed format
    function getYouTubeEmbedUrl(url: string): string | null {
      if (!url) return null;

      let videoId: string | null = null;

      // Handle YouTube Shorts
      const shortsMatch = url.match(/youtube\.com\/shorts\/([a-zA-Z0-9_-]+)/);
      if (shortsMatch) {
        videoId = shortsMatch[1];
      }

      // Handle regular YouTube
      if (!videoId) {
        const watchMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]+)/);
        if (watchMatch) {
          videoId = watchMatch[1];
        }
      }

      // If already an embed URL
      if (!videoId && url.includes('youtube.com/embed/')) {
        const embedMatch = url.match(/youtube\.com\/embed\/([a-zA-Z0-9_-]+)/);
        if (embedMatch) {
          videoId = embedMatch[1];
        }
      }

      if (!videoId) return null;

      const params = new URLSearchParams({
        autoplay: '0', // Don't autoplay in modal
        mute: '0',
        rel: '0'
      });

      return `https://www.youtube.com/embed/${videoId}?${params.toString()}`;
    }

    function showExerciseInfo(exerciseId: string) {
      const details = exerciseDetails[exerciseId];
      if (!details) return;

      // Pause workout if it's not already paused
      import('../../stores/workoutController').then(({ workoutSession }) => {
        const session = workoutSession.get();
        wasPausedBeforeModal = session.isPaused;
        if (!session.isPaused) {
          pauseWorkout();
          updatePauseUI(true);
        }
      });

      // Get current exercise for video
      import('../../stores/workoutController').then(({ currentExercise }) => {
        const exercise = currentExercise.get();

        // Get embed URL
        let embedUrl = exercise?.videoEmbedUrl ? getYouTubeEmbedUrl(exercise.videoEmbedUrl) : null;
        if (!embedUrl && exercise?.videoUrl) {
          embedUrl = getYouTubeEmbedUrl(exercise.videoUrl);
        }

        const isVerticalVideo = (exercise?.videoEmbedUrl?.includes('/shorts/') || exercise?.videoUrl?.includes('/shorts/')) || false;
        const aspectRatio = isVerticalVideo ? '177.78%' : '56.25%'; // 9:16 or 16:9

        // Build modal content
        const content = `
          <h2 class="mb-4 pr-10 text-2xl font-bold text-gray-800">${exercise?.name || ''}</h2>

          ${embedUrl ? `
            <div class="mb-6 overflow-hidden rounded-lg">
              <div class="relative w-full" style="padding-bottom: ${aspectRatio};">
                <iframe
                  src="${embedUrl}"
                  class="absolute inset-0 h-full w-full border-0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          ` : ''}

          <div class="space-y-4">
            ${details.muscles ? `
              <div>
                <h3 class="mb-2 font-bold text-gray-800">${lang === 'es' ? 'Músculos trabajados' : 'Muscles worked'}</h3>
                <p class="text-gray-700">${details.muscles}</p>
              </div>
            ` : ''}

            ${details.why ? `
              <div>
                <h3 class="mb-2 font-bold text-gray-800">${lang === 'es' ? 'Por qué es importante' : 'Why it matters'}</h3>
                <p class="text-gray-700">${details.why}</p>
              </div>
            ` : ''}

            ${details.evidence ? `
              <div>
                <h3 class="mb-2 font-bold text-gray-800">${lang === 'es' ? 'Evidencia científica' : 'Scientific evidence'}</h3>
                <p class="text-gray-700 text-sm">${details.evidence}</p>
              </div>
            ` : ''}

            ${details.tips ? `
              <div>
                <h3 class="mb-2 font-bold text-gray-800">${lang === 'es' ? 'Consejos técnicos' : 'Technical tips'}</h3>
                <ul class="list-disc list-inside space-y-1 text-gray-700">
                  ${details.tips.split('\n').map((tip: string) => `<li>${tip.replace(/^[-•]\s*/, '')}</li>`).join('')}
                </ul>
              </div>
            ` : ''}
          </div>
        `;

        const modalContent = document.getElementById('exerciseInfoContent');
        if (modalContent) {
          modalContent.innerHTML = content;
        }

        // Show modal
        document.getElementById('exerciseInfoModal')?.classList.remove('hidden');
        document.getElementById('exerciseInfoModal')?.classList.add('flex');
      });
    }

    function closeExerciseInfo() {
      // Hide modal
      document.getElementById('exerciseInfoModal')?.classList.remove('flex');
      document.getElementById('exerciseInfoModal')?.classList.add('hidden');

      // Resume workout if it wasn't paused before opening modal
      if (!wasPausedBeforeModal && isPaused) {
        resumeFromPause();
        updatePauseUI(false);
      }
    }

    function handleExit() {
      if (confirm(exitConfirmText)) {
        exitWorkout();
        window.location.href = `/${lang}/`;
      }
    }

    function handlePausePlay() {
      // Check if we're in a manual completion state (no active timer)
      import('../../stores/workoutController').then(({ workoutSession, currentExercise, completeCurrentExercise }) => {
        const session = workoutSession.get();
        const exercise = currentExercise.get();

        // If no timer is running and not paused, this is a manual completion button
        const hasActiveTimer = session.timeLeft > 0 && exercise?.duration && exercise.duration > 0;

        if (!hasActiveTimer && !isPaused) {
          // Manual completion
          completeCurrentExercise();
          return;
        }

        // Normal pause/play behavior
        if (isPaused) {
          // Resume
          resumeFromPause();
          updatePauseUI(false);
        } else {
          // Pause
          pauseWorkout();
          updatePauseUI(true);
        }
      });
    }

    function handleSettings() {
      // Pause workout if not already paused
      if (!isPaused) {
        pauseWorkout();
        updatePauseUI(true);
        wasPausedBeforeModal = false;
      } else {
        wasPausedBeforeModal = true;
      }

      document.getElementById('settingsModal')?.classList.remove('hidden');
      document.getElementById('settingsModal')?.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeSettings() {
      document.getElementById('settingsModal')?.classList.remove('flex');
      document.getElementById('settingsModal')?.classList.add('hidden');
      document.body.style.overflow = 'auto';

      // Resume workout if it wasn't paused before
      if (!wasPausedBeforeModal && isPaused) {
        resumeFromPause();
        updatePauseUI(false);
      }
    }

    function openReferencesModal() {
      const modal = document.getElementById('references-modal');
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeReferencesModal() {
      const modal = document.getElementById('references-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = 'auto';
      }
    }

    function handleResetProgress() {
      if (confirm(resetConfirmText)) {
        // Clear all localStorage data
        const keysToRemove = [];
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && (key.startsWith('unslump-') || key.startsWith('workout-'))) {
            keysToRemove.push(key);
          }
        }
        keysToRemove.forEach(key => localStorage.removeItem(key));

        // Show success toast
        toast.success(lang === 'es' ? '¡Progreso reseteado!' : 'Progress reset!', 2000);

        // Reload page after a short delay
        setTimeout(() => {
          window.location.reload();
        }, 2000);
      }
    }

    function checkOnboarding() {
      const hasSeenOnboarding = localStorage.getItem('unslump-workout-onboarding-seen');
      if (!hasSeenOnboarding) {
        // Show onboarding modal
        const modal = document.getElementById('workoutOnboardingModal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      }
    }

    function closeOnboarding() {
      const modal = document.getElementById('workoutOnboardingModal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        // Mark as seen
        localStorage.setItem('unslump-workout-onboarding-seen', 'true');
      }
    }

    function handleBack() {
      previousExercise();
    }

    function handleSkip() {
      skipExercise();
    }

    function handleCompleteTimer() {
      // Complete current timer/side and move to next side or finish exercise
      import('../../stores/workoutController').then(({ workoutSession }) => {
        const session = workoutSession.get();

        // Force timer to complete by setting timeLeft to 0
        // This will trigger handleTimerComplete which handles sides logic
        workoutSession.set({
          ...session,
          timeLeft: 0,
        });

        // Resume if paused to trigger the timer completion
        if (session.isPaused) {
          resumeFromPause();
        }
      });
    }

    function handleResume() {
      const savedSession = loadSessionState();
      document.getElementById('resumeModal')?.classList.add('hidden');
      if (savedSession) {
        import('../../stores/workoutController').then(({ resumeWorkout }) => {
          resumeWorkout(savedSession);
        });
      }
    }

    function handleStartNew() {
      document.getElementById('resumeModal')?.classList.add('hidden');
      startWorkout();
    }

    // Screen Wake Lock
    let wakeLock: any = null;
    async function requestWakeLock() {
      if ('wakeLock' in navigator) {
        try {
          wakeLock = await (navigator as any).wakeLock.request('screen');
          console.log('Wake lock acquired');
        } catch (err) {
          console.warn('Wake lock error:', err);
        }
      }
    }

    // Release wake lock when page is hidden
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && !wakeLock) {
        requestWakeLock();
      }
    });
  </script>

  <style>
    .workout-container {
      overflow: hidden;
    }

    .workout-content {
      /* Fallback for browsers that don't support dvh */
      height: calc(100vh - 3rem);
      /* Use dynamic viewport height to account for browser UI bars (Safari, Chrome 108+) */
      height: calc(100dvh - 3rem);
      overflow-y: hidden; /* No scroll - everything should fit */
    }

    /* Ensure container uses dynamic viewport too */
    .workout-container {
      height: 100vh; /* Fallback */
      height: 100dvh; /* Dynamic viewport height */
    }

    /* Ensure FABs don't interfere with safe area */
    #pausePlayButton,
    #previousButton,
    #skipButton {
      margin-bottom: env(safe-area-inset-bottom, 0);
    }

    .safe-area-bottom {
      padding-bottom: env(safe-area-inset-bottom);
    }

    /* Prevent pull-to-refresh on mobile */
    html, body {
      overscroll-behavior: none;
    }

    /* View Transitions - Keep video and title during transitions */
    @supports (view-transition-name: none) {
      #exerciseVideoWrapper {
        view-transition-name: exercise-video;
      }

      [style*="view-transition-name: exercise-title"] {
        view-transition-name: exercise-title;
      }
    }

    /* Smooth transitions for the video */
    ::view-transition-old(exercise-video),
    ::view-transition-new(exercise-video) {
      animation-duration: 0.3s;
    }

    /* Keep video in same position during transition */
    ::view-transition-old(exercise-video) {
      animation: none;
      mix-blend-mode: normal;
    }

    ::view-transition-new(exercise-video) {
      animation: none;
      mix-blend-mode: normal;
    }
  </style>
</BaseLayout>
