---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorkout, getExerciseDetails, getReferences } from '../../data/index';
import { useTranslations, type Language } from '../../i18n/utils';

// Refactored Components
import StickyHeader from '../../components/StickyHeader.astro';
import PhaseCard from '../../components/PhaseCard.astro';
import CompletionCelebration from '../../components/CompletionCelebration.astro';
import HelpFAB from '../../components/HelpFAB.astro';
import Toast from '../../components/Toast.astro';

// Modals
import ExerciseInfoModal from '../../components/modals/ExerciseInfoModal.astro';
import ReferencesModal from '../../components/modals/ReferencesModal.astro';
import OnboardingModal from '../../components/modals/OnboardingModal.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

// Load localized data
const workout = getWorkout(lang);
const exerciseDetails = getExerciseDetails(lang);
const references = getReferences(lang);
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
>
  <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 dark:from-gray-900 dark:to-gray-800">
    <!-- Sticky Header with Progress Logo -->
    <StickyHeader />

    <div class="max-w-4xl mx-auto px-4">

      <!-- Guided mode navigation -->
      <div class="mt-6 mb-8">
        <a
          href={`/${lang}/workout`}
          aria-label={t('workoutModes.switchToGuided')}
          class="guided-workout-button block w-full overflow-hidden rounded-2xl border-2 border-indigo-200 bg-white p-6 shadow-sm transition-all duration-300 hover:border-indigo-500 hover:shadow-lg"
        >
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <svg class="h-8 w-8 text-indigo-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h2 class="font-['Barriecito'] text-2xl font-bold text-gray-900">
                  {t('workoutModes.guided.action')}
                </h2>
              </div>
              <p class="text-sm text-gray-600">
                {t('workoutModes.guided.description')}
              </p>
            </div>
            <svg class="ml-4 h-6 w-6 flex-shrink-0 text-indigo-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>

      </div>

      <!-- Phases -->
      {Object.entries(workout).map(([phaseId, phase]) => (
        <PhaseCard
          phaseId={phaseId}
          phase={phase}
          lang={lang}
        />
      ))}

      <!-- Completion Celebration -->
      <CompletionCelebration lang={lang} />
    </div>
  </div>

  <style>
    .logo-font {
      font-family: 'Tilt Warp Variable', system-ui, sans-serif;
      font-weight: 400;
      font-variation-settings: 'XROT' 0, 'YROT' 0;
    }

    .letter-group {
      letter-spacing: -0.02em;
    }

    .color-layer {
      will-change: clip-path;
    }

    .base-layer {
      display: inline-block;
    }

    .phase-description {
      text-wrap: balance;
      max-width: 50ch;
    }

    /* Initial animation states */
    #progress-logo,
    .letter-group,
    .phase-container {
      opacity: 0;
    }

    /* Onboarding section initial state for stagger animation */
    .onboarding-section {
      opacity: 0;
      transform: translateY(20px);
    }

    /* FAB animation initial state */
    #show-onboarding-btn {
      opacity: 0;
      transform: scale(0.8);
    }

    /* FAB hover effect */
    #show-onboarding-btn:hover {
      transform: scale(1.1);
    }

    #show-onboarding-btn:active {
      transform: scale(0.95);
    }

    /* Micro-interaction enhancements */
    button, .exercise-card {
      transition: transform 0.15s ease-out;
    }

    button:active:not(:disabled) {
      transform: scale(0.97);
    }

    .exercise-card:active {
      transform: scale(0.995);
    }

    /* Smooth hover effects */
    .phase-toggle:hover {
      transform: translateY(-1px);
    }

    .complete-btn:hover:not(:disabled) {
      transform: scale(1.1);
    }

    .info-btn:hover {
      transform: scale(1.1) rotate(5deg);
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.6;
    }

    /* Key tips typography */
    #onboarding-modal strong {
      font-weight: 700;
      color: rgb(15, 23, 42); /* slate-900 */
    }

    #onboarding-modal em {
      font-style: italic;
      color: rgb(30, 41, 59); /* slate-800 */
    }
  </style>

  <script>
    import { animate, stagger } from "motion";

    // Expose Motion functions globally so the inline script can use them
    (window as any).motionAnimate = animate;
    (window as any).motionStagger = stagger;
  </script>

  <!-- Main app script with store integration -->
  <script src="../../scripts/app.ts"></script>

  <script is:inline define:vars={{
    exerciseDetails,
    workout,
    resetConfirmMsg: t('progress.resetConfirm'),
    darkModeLight: t('darkMode.light'),
    darkModeDark: t('darkMode.dark'),
    phaseSequenceWarnings: t('progress.phaseSequenceWarnings')
  }}>
    // Pass Astro data to the app script
    window.workoutData = workout;
    window.exerciseDetailsData = exerciseDetails;
    window.resetConfirmMsg = resetConfirmMsg;
    window.phaseSequenceWarnings = phaseSequenceWarnings;

    // Event Listeners - wire up UI to app.ts functions
    document.addEventListener('DOMContentLoaded', () => {
      // Reset buttons
      const resetBtn = document.getElementById('reset-progress-btn');
      if (resetBtn) resetBtn.addEventListener('click', () => window.resetProgressFn());

      const resetSessionBtn = document.getElementById('reset-session-btn');
      if (resetSessionBtn) resetSessionBtn.addEventListener('click', () => window.resetProgressFn());

      // Language selector
      const languageSelect = document.getElementById('language-select');
      if (languageSelect) {
        languageSelect.addEventListener('change', (e) => {
          window.location.href = `/${e.target.value}/app`;
        });
      }

      // Level buttons
      document.querySelectorAll('.level-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const level = btn.dataset.level;
          if (level) window.handleLevelSelectFn(level);
        });
      });

      // Phase toggles
      document.querySelectorAll('.phase-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const phaseId = btn.dataset.phaseId;
          if (phaseId) window.handlePhaseToggleFn(phaseId);
        });
      });

      // Exercise completion - complete buttons
      document.querySelectorAll('.complete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const phaseId = btn.dataset.phaseId;
          const exerciseId = btn.dataset.exerciseId;
          if (phaseId && exerciseId) window.toggleExerciseCompletionFn(phaseId, exerciseId);
        });
      });

      // Exercise completion - card clicks
      document.querySelectorAll('.exercise-card').forEach(card => {
        card.addEventListener('click', (e) => {
          // Don't activate if clicking interactive elements
          if (
            e.target.closest('.info-btn') ||
            e.target.closest('.timer-container') ||
            e.target.closest('.sets-counter') ||
            e.target.closest('.complete-btn')
          ) {
            return;
          }

          const phaseId = card.dataset.phaseId;
          const exerciseId = card.dataset.exerciseId;
          if (phaseId && exerciseId) window.toggleExerciseCompletionFn(phaseId, exerciseId);
        });
      });

      // Exercise info buttons
      document.querySelectorAll('.info-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const exerciseId = btn.dataset.exerciseId;
          if (exerciseId) window.handleExerciseInfoFn(exerciseId);
        });
      });

      // Exercise info modal - close buttons
      const closeInfoModal = document.getElementById('close-info-modal');
      if (closeInfoModal) closeInfoModal.addEventListener('click', () => window.closeExerciseInfoModalFn());

      const closeInfoModalBtn = document.getElementById('close-info-modal-btn');
      if (closeInfoModalBtn) closeInfoModalBtn.addEventListener('click', () => window.closeExerciseInfoModalFn());

      // References modal
      const showReferencesBtn = document.getElementById('show-references-btn');
      if (showReferencesBtn) {
        showReferencesBtn.addEventListener('click', () => window.openModalFn('references-modal'));
      }

      const closeReferencesModal = document.getElementById('close-references-modal');
      if (closeReferencesModal) {
        closeReferencesModal.addEventListener('click', () => window.closeModalFn('references-modal'));
      }

      const closeReferencesModalBtn = document.getElementById('close-references-modal-btn');
      if (closeReferencesModalBtn) {
        closeReferencesModalBtn.addEventListener('click', () => window.closeModalFn('references-modal'));
      }

      // Onboarding modal
      const showOnboardingBtn = document.getElementById('show-onboarding-btn');
      if (showOnboardingBtn) {
        showOnboardingBtn.addEventListener('click', () => window.openModalFn('onboarding-modal'));
      }

      const closeOnboardingModal = () => {
        window.closeModalFn('onboarding-modal', () => window.markOnboardingSeenFn());
      };

      const closeOnboardingModalEl = document.getElementById('close-onboarding-modal');
      if (closeOnboardingModalEl) closeOnboardingModalEl.addEventListener('click', closeOnboardingModal);

      const closeOnboardingModalBtn = document.getElementById('close-onboarding-modal-btn');
      if (closeOnboardingModalBtn) closeOnboardingModalBtn.addEventListener('click', closeOnboardingModal);

      // Close modals on backdrop click
      document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            const callback = modal.id === 'onboarding-modal' ? () => window.markOnboardingSeenFn() : undefined;
            window.closeModalFn(modal.id, callback);
          }
        });
      });

    });
  </script>

  <!-- Refactored Modals -->
  <ExerciseInfoModal lang={lang} />
  <ReferencesModal lang={lang} references={references} />
  <OnboardingModal lang={lang} />

  <!-- Help FAB -->
  <HelpFAB lang={lang} />

  <!-- Toast Notifications -->
  <Toast />
</BaseLayout>
