---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorkout, getExerciseDetails, getReferences } from '../../data/index';
import { useTranslations, type Language, languages } from '../../i18n/utils';

// Components
import Logo from '../../components/Logo.astro';

// Icons
import Play from '../../components/icons/Play.astro';
import Pause from '../../components/icons/Pause.astro';
import RotateCcw from '../../components/icons/RotateCcw.astro';
import Check from '../../components/icons/Check.astro';
import ChevronDown from '../../components/icons/ChevronDown.astro';
import ChevronUp from '../../components/icons/ChevronUp.astro';
import Info from '../../components/icons/Info.astro';
import BookOpen from '../../components/icons/BookOpen.astro';
import X from '../../components/icons/X.astro';
import HelpCircle from '../../components/icons/HelpCircle.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

// Load localized data
const workout = getWorkout(lang);
const exerciseDetails = getExerciseDetails(lang);
const references = getReferences(lang);
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
>
  <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
    <!-- Progress Logo (Sticky) -->
    <div class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm shadow-md mb-4">
      <div class="relative py-4 sm:py-5">
        <div class="max-w-4xl mx-auto px-4">
          <div class="flex items-center justify-center">
            <!-- Logo con efecto de llenado -->
            <Logo id="progress-logo" showProgress={true} size="large" />
          </div>
        </div>

        <!-- Barra de progreso por fases en el borde inferior -->
        <div class="absolute bottom-0 left-0 right-0 h-1 grid grid-cols-4 gap-2 bg-slate-200">
          <!-- Fase 1 -->
          <div class="phase-progress-bar relative bg-slate-200 overflow-hidden" data-phase="fase1">
            <div class="absolute inset-0 transition-transform duration-500 origin-left" style="background-color: #4f46e5; transform: scaleX(0);"></div>
          </div>
          <!-- Fase 2 -->
          <div class="phase-progress-bar relative bg-slate-200 overflow-hidden" data-phase="fase2">
            <div class="absolute inset-0 transition-transform duration-500 origin-left" style="background-color: #14b8a6; transform: scaleX(0);"></div>
          </div>
          <!-- Fase 3 -->
          <div class="phase-progress-bar relative bg-slate-200 overflow-hidden" data-phase="fase3">
            <div class="absolute inset-0 transition-transform duration-500 origin-left" style="background-color: #f97316; transform: scaleX(0);"></div>
          </div>
          <!-- Fase 4 -->
          <div class="phase-progress-bar relative bg-slate-200 overflow-hidden" data-phase="fase4">
            <div class="absolute inset-0 transition-transform duration-500 origin-left" style="background-color: #ec4899; transform: scaleX(0);"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4">

      <!-- Phases -->
      {Object.entries(workout).map(([phaseId, phase]) => (
        <div class="mb-4 phase-container" data-phase-id={phaseId}>
          <div class="sticky top-[100px] z-[5] mb-2">
            <button
              class="phase-toggle w-full border-2 rounded-lg pt-3 sm:pt-4 px-3 sm:px-4 pb-1 hover:shadow-xl transition-all shadow-lg backdrop-blur-md relative"
              style={`background: linear-gradient(135deg, white 0%, ${phase.colorLightHex} 100%); border-color: ${phase.colorBorderHex};`}
              data-phase-id={phaseId}
            >
              <!-- Phase Number Badge -->
              <div
                class="absolute top-2 right-2 sm:top-3 sm:right-3 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-md font-bold text-xs sm:text-sm shadow-sm"
                style={`background-color: ${phase.colorPrimaryHex}; color: white;`}
              >
                #{phaseId.replace('fase', '')}
              </div>

              <div>
                <div class="text-left mb-3">
                  <h2 class="text-lg sm:text-2xl font-extrabold leading-tight mb-1 pr-10 sm:pr-12" style={`color: ${phase.colorPrimaryHex};`}>
                    {phase.name.includes(':') ? phase.name.split(':')[1].trim() : phase.name}
                  </h2>
                  <p class="phase-description text-xs sm:text-sm text-slate-600/90 leading-relaxed max-w-prose mb-2 pr-10 sm:pr-12">{phase.description}</p>
                  <div class="flex justify-end">
                    <span class="text-xs text-slate-500 font-medium whitespace-nowrap">{phase.time}</span>
                  </div>
                </div>

                <!-- Chevron centrado abajo -->
                <div class="flex justify-center pb-1 -mb-1">
                  <div class="relative w-5 h-5 opacity-60">
                    <div class="chevron-down absolute inset-0 opacity-100 transition-opacity duration-200" style={`color: ${phase.colorPrimaryHex};`}>
                      <ChevronDown size={20} />
                    </div>
                    <div class="chevron-up absolute inset-0 opacity-0 transition-opacity duration-200" style={`color: ${phase.colorPrimaryHex};`}>
                      <ChevronUp size={20} />
                    </div>
                  </div>
                </div>
              </div>
            </button>
          </div>

          <div class="phase-content hidden bg-white rounded-b-lg shadow-lg p-3 sm:p-4 mt-2 space-y-3">
            {phase.exercises.map(exercise => (
                <div
                  class="exercise-card border-2 border-slate-200 bg-white rounded-lg p-3 sm:p-4 transition-all cursor-pointer hover:shadow-lg"
                  data-phase-id={phaseId}
                  data-exercise-id={exercise.id}
                  data-duration={exercise.duration}
                >
                  <div class="flex justify-between items-start gap-2 mb-2">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        <h3 class="font-bold text-lg sm:text-xl text-slate-800 flex-1 min-w-0 break-words">{exercise.name}</h3>
                        <button
                          class="info-btn p-2 border rounded-full transition-all flex-shrink-0 shadow-sm hover:shadow-md"
                          style={`background-color: ${phase.colorLightHex}; border-color: ${phase.colorBorderHex};`}
                          data-exercise-id={exercise.id}
                          title={t('common.moreInfo')}
                        >
                          <Info size={20} style={`color: ${phase.colorPrimaryHex};`} />
                        </button>
                      </div>
                      <p class="text-sm sm:text-base font-semibold text-slate-700 mb-2">{exercise.reps}</p>
                      <p class="text-xs sm:text-sm text-slate-700">{exercise.instructions}</p>

                      {exercise.levels && (
                        <div class="level-info mt-2 p-2 border rounded text-xs sm:text-sm" style={`background-color: ${phase.colorLightHex}; border-color: ${phase.colorBorderHex};`} data-levels={JSON.stringify(exercise.levels)}>
                          <span class="font-semibold" style={`color: ${phase.colorPrimaryHex};`}>{t('levels.intermediate')}:</span>{' '}
                          <span class="text-slate-800 level-text">{exercise.levels.intermedio}</span>
                        </div>
                      )}
                    </div>

                    <button
                      class="complete-btn ml-2 sm:ml-4 p-1.5 sm:p-2 rounded-full transition-all bg-slate-200 text-slate-500 hover:bg-slate-300 flex-shrink-0"
                      data-phase-id={phaseId}
                      data-exercise-id={exercise.id}
                    >
                      <Check size={18} />
                    </button>
                  </div>

                  {exercise.duration > 0 && (
                    <div class="timer-container mt-3 p-2 sm:p-3 border rounded-lg" style={`background-color: ${phase.colorLightHex}; border-color: ${phase.colorBorderHex};`}>
                      <div class="flex items-center justify-between gap-2">
                        <div class="timer-display text-xl sm:text-2xl font-bold" style={`color: ${phase.colorPrimaryHex};`}>
                          {Math.floor(exercise.duration / 60)}:{(exercise.duration % 60).toString().padStart(2, '0')}
                        </div>
                        <div class="timer-controls flex gap-1.5 sm:gap-2">
                          <button
                            class="start-timer-btn px-3 sm:px-4 py-1.5 sm:py-2 text-white rounded-lg hover:opacity-90 transition-all font-medium text-xs sm:text-sm shadow-md"
                            style={`background-color: ${phase.colorPrimaryHex};`}
                            data-phase-id={phaseId}
                            data-exercise-id={exercise.id}
                            data-duration={exercise.duration}
                          >
                            {t('common.start')}
                          </button>
                          <button
                            class="pause-timer-btn hidden p-1.5 sm:p-2 text-white rounded-lg hover:opacity-90 transition-all shadow-md"
                            style={`background-color: ${phase.colorPrimaryHex};`}
                          >
                            <Pause size={18} />
                          </button>
                          <button
                            class="play-timer-btn hidden p-1.5 sm:p-2 text-white rounded-lg hover:opacity-90 transition-all shadow-md"
                            style={`background-color: ${phase.colorPrimaryHex};`}
                          >
                            <Play size={18} />
                          </button>
                          <button
                            class="reset-timer-btn hidden p-1.5 sm:p-2 bg-slate-500 text-white rounded-lg hover:bg-slate-600 transition-all"
                            data-duration={exercise.duration}
                          >
                            <RotateCcw size={18} />
                          </button>
                        </div>
                      </div>
                    </div>
                  )}

                  {exercise.sets && exercise.sets > 0 && (
                    <div class="sets-counter mt-3 p-2 sm:p-3 rounded-lg border-2" style={`background-color: ${phase.colorLightHex}; border-color: ${phase.colorBorderHex};`}>
                      <div class="flex items-center justify-between gap-2">
                        <div class="text-sm sm:text-base font-semibold" style={`color: ${phase.colorPrimaryHex};`}>
                          {t('timer.completed')}
                        </div>
                        <div class="flex items-center gap-2">
                          <span class="current-set text-2xl sm:text-3xl font-bold" style={`color: ${phase.colorPrimaryHex};`}>0</span>
                          <span class="text-lg sm:text-xl opacity-70" style={`color: ${phase.colorPrimaryHex};`}>/</span>
                          <span class="total-sets text-2xl sm:text-3xl font-bold" style={`color: ${phase.colorPrimaryHex};`}>{exercise.sets}</span>
                        </div>
                      </div>
                      <div class="flex gap-2 mt-2">
                        <button
                          class="increment-set-btn flex-1 px-3 py-2 text-white rounded-lg hover:opacity-90 transition-all font-medium text-sm shadow-md"
                          style={`background-color: ${phase.colorPrimaryHex};`}
                          data-phase-id={phaseId}
                          data-exercise-id={exercise.id}
                          data-total-sets={exercise.sets}
                        >
                          {t('timer.addSet')}
                        </button>
                        <button
                          class="reset-set-btn px-3 py-2 bg-slate-400 text-white rounded-lg hover:bg-slate-500 transition-all text-sm"
                          data-phase-id={phaseId}
                          data-exercise-id={exercise.id}
                        >
                          <RotateCcw size={18} />
                        </button>
                      </div>
                    </div>
                  )}
                </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Exercise Info Modal -->
    <div id="exercise-info-modal" class="modal fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-3 sm:p-4 z-50 hidden">
      <div class="bg-white rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto p-4 sm:p-6">
        <div class="flex justify-between items-start gap-2 mb-4">
          <h2 id="modal-title" class="text-xl sm:text-2xl font-bold text-slate-800 flex-1 min-w-0"></h2>
          <button id="close-info-modal" class="p-1.5 sm:p-2 hover:bg-slate-100 rounded-full transition-all flex-shrink-0">
            <X size={20} />
          </button>
        </div>

        <!-- Video Container -->
        <div id="modal-video-container" class="mb-4 hidden">
          <div class="aspect-video rounded-lg overflow-hidden shadow-md bg-slate-100 flex items-center justify-center">
            <iframe
              id="modal-video-iframe"
              width="100%"
              height="100%"
              src=""
              title={t('modal.exerciseInfo.videoTutorial')}
              frameborder="0"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="w-full h-full"
            ></iframe>
          </div>
        </div>

        <div class="space-y-3 sm:space-y-4">
          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 mb-1 flex items-center gap-2">
              🎯 {t('modal.exerciseInfo.muscles')}
            </h3>
            <p id="modal-muscles" class="text-xs sm:text-sm text-slate-600"></p>
          </div>

          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 mb-1 flex items-center gap-2">
              ❓ {t('modal.exerciseInfo.why')}
            </h3>
            <p id="modal-why" class="text-xs sm:text-sm text-slate-600"></p>
          </div>

          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 mb-1 flex items-center gap-2">
              🔬 {t('modal.exerciseInfo.evidence')}
            </h3>
            <p id="modal-evidence" class="text-xs sm:text-sm text-slate-600"></p>
          </div>

          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 mb-1 flex items-center gap-2">
              💡 {t('modal.exerciseInfo.tips')}
            </h3>
            <p id="modal-tips" class="text-xs sm:text-sm text-slate-600"></p>
          </div>
        </div>

        <button
          id="close-info-modal-btn"
          class="mt-4 sm:mt-6 w-full px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all font-medium text-sm sm:text-base"
        >
          {t('common.understood')}
        </button>
      </div>
    </div>

    <!-- References Modal -->
    <div id="references-modal" class="modal fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-3 sm:p-4 z-[60] hidden">
      <div class="bg-white rounded-lg max-w-4xl w-full max-h-[90vh] overflow-y-auto p-4 sm:p-6">
        <div class="flex justify-between items-start gap-2 mb-4">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-800 flex-1 min-w-0">{t('modal.references.title')}</h2>
          <button id="close-references-modal" class="p-1.5 sm:p-2 hover:bg-slate-100 rounded-full transition-all flex-shrink-0">
            <X size={20} />
          </button>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 mb-4 sm:mb-6">
          {t('modal.references.description')}
        </p>

        <div class="space-y-4 sm:space-y-6">
          {references.map((section) => (
            <div>
              <h3 class="text-base sm:text-lg font-bold text-slate-800 mb-2 sm:mb-3 pb-2 border-b-2 border-slate-200">
                {section.category}
              </h3>
              <ul class="space-y-2 sm:space-y-3">
                {section.studies.map((study) => (
                  <li class="text-xs sm:text-sm text-slate-700 pl-3 sm:pl-4 border-l-2 border-blue-300 leading-relaxed">
                    {study}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="mt-4 sm:mt-6 p-3 sm:p-4 bg-blue-50 rounded-lg">
          <h3 class="font-bold text-sm sm:text-base text-blue-900 mb-2">📚 {t('modal.references.accessTitle')}</h3>
          <p class="text-xs sm:text-sm text-blue-800">
            {t('modal.references.accessDescription')}
          </p>
        </div>

        <button
          id="close-references-modal-btn"
          class="mt-4 sm:mt-6 w-full px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all font-medium text-sm sm:text-base"
        >
          {t('common.close')}
        </button>
      </div>
    </div>

    <!-- Onboarding Modal -->
    <div id="onboarding-modal" class="modal fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-3 sm:p-4 z-50 hidden">
      <div class="bg-white rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto p-4 sm:p-6">
        <!-- Header del modal con logo -->
        <div class="flex items-center justify-between gap-3 mb-4">
          <Logo size="medium" />
          <button id="close-onboarding-modal" class="p-1.5 sm:p-2 hover:bg-slate-100 rounded-full transition-all flex-shrink-0">
            <X size={20} />
          </button>
        </div>

        <!-- Descripción de la app - MÁS DESTACADA -->
        <div class="mb-4 p-4 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-lg border-2 border-blue-200">
          <p class="text-sm sm:text-base text-slate-800 mb-2 font-semibold leading-relaxed">
            {t('modal.onboarding.subtitle')}
          </p>
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
            {t('modal.onboarding.description')}
          </p>
        </div>

        <!-- Preferencias (nivel + idioma) AGRUPADAS -->
        <div class="mb-4 p-3 sm:p-4 bg-slate-50 rounded-lg border border-slate-200">
          <h3 class="text-sm sm:text-base font-bold text-slate-800 mb-3 flex items-center gap-2">
            ⚙️ {t('preferences.title')}
          </h3>

          <!-- Level Selector con descripción incluida -->
          <div class="mb-3">
            <span class="text-xs sm:text-sm text-slate-700 font-semibold block mb-2">🎚️ {t('levels.selectLevel')}</span>
            <div class="grid grid-cols-3 gap-2 mb-2">
              {['principiante', 'intermedio', 'avanzado'].map(l => (
                <button
                  data-level={l}
                  class={`level-btn px-2 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all whitespace-nowrap ${
                    l === 'intermedio'
                      ? 'bg-blue-500 text-white shadow-md'
                      : 'bg-slate-200 text-slate-700 hover:bg-slate-300'
                  }`}
                >
                  <span class="hidden sm:inline">{t(`levels.${l === 'principiante' ? 'beginner' : l === 'intermedio' ? 'intermediate' : 'advanced'}`)}</span>
                  <span class="sm:hidden">{t(`levels.${l === 'principiante' ? 'basic' : l === 'intermedio' ? 'medium' : 'advanc'}`)}</span>
                </button>
              ))}
            </div>
            <p class="text-xs text-slate-600 italic">
              {t('levels.description')}
            </p>
          </div>

          <!-- Language Selector -->
          <div>
            <label for="language-select" class="text-xs sm:text-sm text-slate-700 font-semibold block mb-2">
              🌐 {t('language.selector')}
            </label>
            <select
              id="language-select"
              class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white text-slate-700 font-medium text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
            >
              {Object.entries(languages).map(([code, name]) => (
                <option value={code} selected={code === lang}>
                  {name}
                </option>
              ))}
            </select>
          </div>
        </div>

        <!-- Cómo usar la app - SIMPLIFICADO -->
        <h3 class="text-base sm:text-lg font-bold text-slate-800 mb-3">📖 {t('modal.onboarding.howToUse')}</h3>

        <div class="space-y-2.5 sm:space-y-3 mb-4">
          <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 hover:border-blue-300 hover:bg-blue-50/50 transition-all">
            <h4 class="font-semibold text-sm sm:text-base text-slate-900 mb-1 flex items-center gap-2">
              🔘 {t('modal.onboarding.completeTitle')}
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {t('modal.onboarding.completeDescription')}
            </p>
          </div>

          <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 hover:border-blue-300 hover:bg-blue-50/50 transition-all">
            <h4 class="font-semibold text-sm sm:text-base text-slate-900 mb-1 flex items-center gap-2">
              ℹ️ {t('modal.onboarding.infoTitle')}
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {t('modal.onboarding.infoDescription')}
            </p>
          </div>
        </div>

        <!-- Referencias Button MOVIDO AQUÍ -->
        <button
          id="show-references-btn"
          class="w-full mb-4 px-3 sm:px-4 py-3 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-lg font-semibold transition-all flex items-center justify-center gap-2 text-xs sm:text-sm border border-indigo-200 hover:border-indigo-300 text-balance"
        >
          {t('modal.onboarding.referencesButton')}
        </button>

        <!-- Consejos clave -->
        <div class="mt-4 p-4 sm:p-5 bg-gradient-to-br from-amber-50/80 to-yellow-50/60 rounded-lg border-2 border-amber-200/60">
          <h4 class="font-bold text-base sm:text-lg text-slate-900 mb-3 flex items-center gap-2">
            💡 {t('modal.onboarding.keyTipsTitle')}
          </h4>
          <ul class="space-y-2.5 sm:space-y-3">
            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 leading-relaxed text-balance">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500 mt-1.5 flex-shrink-0" aria-hidden="true"></span>
              <span set:html={t('modal.onboarding.keyTip1')}></span>
            </li>
            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 leading-relaxed text-balance">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500 mt-1.5 flex-shrink-0" aria-hidden="true"></span>
              <span set:html={t('modal.onboarding.keyTip2')}></span>
            </li>
            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 leading-relaxed text-balance">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500 mt-1.5 flex-shrink-0" aria-hidden="true"></span>
              <span set:html={t('modal.onboarding.keyTip3')}></span>
            </li>
            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 leading-relaxed text-balance">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500 mt-1.5 flex-shrink-0" aria-hidden="true"></span>
              <span set:html={t('modal.onboarding.keyTip4')}></span>
            </li>
            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 leading-relaxed text-balance">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500 mt-1.5 flex-shrink-0" aria-hidden="true"></span>
              <span set:html={t('modal.onboarding.keyTip5')}></span>
            </li>
          </ul>
        </div>

        <!-- Reset Progress Button -->
        <button
          id="reset-progress-btn"
          class="mt-3 w-full px-3 py-2 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 hover:border-red-300 transition-all text-xs sm:text-sm font-medium"
        >
          {t('modal.onboarding.resetProgress')}
        </button>

        <button
          id="close-onboarding-modal-btn"
          class="mt-3 w-full px-4 py-2.5 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all font-medium text-sm sm:text-base shadow-sm hover:shadow-md"
        >
          {t('modal.onboarding.startButton')}
        </button>
      </div>
    </div>

    <!-- FAB - Botón de Ayuda Flotante -->
    <button
      id="show-onboarding-btn"
      class="fixed bottom-6 left-6 z-50 w-14 h-14 bg-blue-500 hover:bg-blue-600 text-white rounded-full shadow-lg hover:shadow-xl transition-all flex items-center justify-center group"
      title={t('modal.onboarding.helpTitle')}
      aria-label={t('common.help')}
    >
      <HelpCircle size={24} class="text-white" />
      <span class="absolute left-full ml-3 px-3 py-1.5 bg-slate-800 text-white text-sm rounded-lg opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap">
        {t('modal.onboarding.helpTooltip')}
      </span>
    </button>
  </div>

  <style>
    .logo-font {
      font-family: 'Barriecito', cursive;
      font-weight: 400;
    }

    .letter-group {
      letter-spacing: -0.02em;
    }

    .color-layer {
      will-change: clip-path;
    }

    .base-layer {
      display: inline-block;
    }

    .phase-description {
      text-wrap: balance;
      max-width: 50ch;
    }

    /* Initial animation states */
    #progress-logo,
    .letter-group,
    .phase-container {
      opacity: 0;
    }

    /* FAB animation initial state */
    #show-onboarding-btn {
      opacity: 0;
      transform: scale(0.8);
    }

    /* FAB hover effect */
    #show-onboarding-btn:hover {
      transform: scale(1.1);
    }

    #show-onboarding-btn:active {
      transform: scale(0.95);
    }

    /* Micro-interaction enhancements */
    button, .exercise-card {
      transition: transform 0.15s ease-out;
    }

    button:active:not(:disabled) {
      transform: scale(0.97);
    }

    .exercise-card:active {
      transform: scale(0.995);
    }

    /* Smooth hover effects */
    .phase-toggle:hover {
      transform: translateY(-1px);
    }

    .complete-btn:hover:not(:disabled) {
      transform: scale(1.1);
    }

    .info-btn:hover {
      transform: scale(1.1) rotate(5deg);
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.6;
    }

    /* Key tips typography */
    #onboarding-modal strong {
      font-weight: 700;
      color: rgb(15, 23, 42); /* slate-900 */
    }

    #onboarding-modal em {
      font-style: italic;
      color: rgb(30, 41, 59); /* slate-800 */
    }
  </style>

  <script>
    import { animate, stagger } from "motion";

    // Expose Motion functions globally so the inline script can use them
    
    (window as any).motionAnimate = animate;
    (window as any).motionStagger = stagger;
  </script>

  <script is:inline define:vars={{ exerciseDetails, workout, resetConfirmMsg: t('progress.resetConfirm') }}>
    // Wait for Motion to be available
    const waitForMotion = () => {
      return new Promise((resolve) => {
        if (window.motionAnimate) {
          resolve();
        } else {
          setTimeout(() => waitForMotion().then(resolve), 50);
        }
      });
    };

    // Motion aliases (will be set after Motion loads)
    let animate, stagger;

    // App State
    let currentLevel = 'intermedio';
    let completedExercises = new Set();
    let activeTimer = null;
    let timerInterval = null;

    // Color mapping for phases (Energía Progresiva palette)
    const phaseColors = {
      fase1: { border: 'border-indigo-400', bg: 'bg-indigo-50', btnBg: 'bg-indigo-600', text: 'text-white' },
      fase2: { border: 'border-teal-400', bg: 'bg-teal-50', btnBg: 'bg-teal-500', text: 'text-white' },
      fase3: { border: 'border-orange-400', bg: 'bg-orange-50', btnBg: 'bg-orange-500', text: 'text-white' },
      fase4: { border: 'border-pink-400', bg: 'bg-pink-50', btnBg: 'bg-pink-500', text: 'text-white' }
    };

    // Load state from localStorage
    const loadState = () => {
      const saved = localStorage.getItem('unslump-progress');
      if (saved) {
        try {
          const data = JSON.parse(saved);
          completedExercises = new Set(data.completed || []);
          currentLevel = data.level || 'intermedio';

          // Update UI after DOM is fully painted
          requestAnimationFrame(() => {
            completedExercises.forEach(key => {
              // Split solo en el PRIMER guion para preservar IDs con guiones como "pectoral-stretch"
              const firstDashIndex = key.indexOf('-');
              const phaseId = key.substring(0, firstDashIndex);
              const exerciseId = key.substring(firstDashIndex + 1);
              // Selector más específico para asegurar que encontramos la tarjeta del ejercicio
              const card = document.querySelector(`.exercise-card[data-phase-id="${phaseId}"][data-exercise-id="${exerciseId}"]`);
              if (card) {
                const colors = phaseColors[phaseId] || phaseColors.fase1;
                card.classList.add(colors.border, colors.bg);
                card.classList.remove('border-slate-200', 'bg-white');
                const btn = card.querySelector('.complete-btn');
                if (btn) {
                  btn.classList.add(colors.btnBg, colors.text);
                  btn.classList.remove('bg-slate-200', 'text-slate-500');
                }
              }
            });
          });

          updateProgress();
          updateLevelButtons();
          updateLevelInfo();
        } catch (e) {
          console.error('Error loading state:', e);
        }
      }
    };

    // Save state to localStorage
    const saveState = () => {
      localStorage.setItem('unslump-progress', JSON.stringify({
        completed: Array.from(completedExercises),
        level: currentLevel
      }));
    };

    // Track which phases have already been celebrated
    let celebratedPhases = new Set();

    // Confetti desde una parte específica del logo
    const celebratePhase = (phaseId) => {
      const letterGroup = document.querySelector(`.letter-group[data-phase="${phaseId}"]`);
      if (!letterGroup) return;

      // Motion animation for the letter group (only if Motion is loaded)
      if (animate) {
        animate(
          letterGroup,
          { scale: [1, 1.15, 1], rotate: [0, -3, 3, 0], y: [0, -10, 0] },
          { duration: 0.8, easing: "ease-out" }
        );
      }

      // Confetti celebration - single burst
      if (typeof confetti !== 'undefined') {
        const rect = letterGroup.getBoundingClientRect();
        const originX = (rect.left + rect.width / 2) / window.innerWidth;
        const originY = (rect.top + rect.height / 2) / window.innerHeight;

        // Colores por fase
        const phaseColorMap = {
          fase1: ['#4f46e5', '#6366f1', '#818cf8'], // indigo
          fase2: ['#14b8a6', '#2dd4bf', '#5eead4'], // teal
          fase3: ['#f97316', '#fb923c', '#fdba74'], // orange
          fase4: ['#ec4899', '#f472b6', '#f9a8d4']  // pink
        };

        const colors = phaseColorMap[phaseId] || phaseColorMap.fase1;

        // Un solo disparo de confetti
        confetti({
          origin: { x: originX, y: originY },
          colors,
          angle: 270, // Disparar hacia abajo
          particleCount: 80,
          spread: 80,
          startVelocity: 50,
          decay: 0.91,
          scalar: 1
        });
      }
    };

    // Confetti espectacular final desde todas las partes del logo
    const celebrateComplete = () => {
      const phaseIds = ['fase1', 'fase2', 'fase3', 'fase4'];
      const phaseColorMap = {
        fase1: ['#4f46e5', '#6366f1', '#818cf8'],
        fase2: ['#14b8a6', '#2dd4bf', '#5eead4'],
        fase3: ['#f97316', '#fb923c', '#fdba74'],
        fase4: ['#ec4899', '#f472b6', '#f9a8d4']
      };

      // Animate each letter group with the same animation as phase completion (only if Motion is loaded)
      if (animate && stagger) {
        // Animate each letter group in sequence with bounce (same as phase celebration)
        const letterGroups = document.querySelectorAll('.letter-group');
        if (letterGroups.length > 0) {
          animate(
            letterGroups,
            { scale: [1, 1.15, 1], rotate: [0, -3, 3, 0], y: [0, -10, 0] },
            {
              duration: 0.8,
              delay: stagger(0.15),
              easing: "ease-out"
            }
          );
        }
      }

      // Confetti celebration - single burst per phase
      if (typeof confetti !== 'undefined') {
        phaseIds.forEach((phaseId, index) => {
          setTimeout(() => {
            const letterGroup = document.querySelector(`.letter-group[data-phase="${phaseId}"]`);
            if (!letterGroup) return;

            const rect = letterGroup.getBoundingClientRect();
            const originX = (rect.left + rect.width / 2) / window.innerWidth;
            const originY = (rect.top + rect.height / 2) / window.innerHeight;
            const colors = phaseColorMap[phaseId];

            // Un solo disparo de confetti por fase
            confetti({
              origin: { x: originX, y: originY },
              colors,
              angle: 270, // Disparar hacia abajo
              particleCount: 100,
              spread: 90,
              startVelocity: 55,
              decay: 0.91,
              scalar: 1.1
            });
          }, index * 150); // Escalonar las explosiones
        });
      }
    };

    // Update progress bar
    const updateProgress = () => {
      const total = Object.values(workout).reduce((sum, phase) => sum + phase.exercises.length, 0);
      const completed = completedExercises.size;

      // Actualizar cada grupo de letras con clip-path
      ['fase1', 'fase2', 'fase3', 'fase4'].forEach(phaseId => {
        const phase = workout[phaseId];
        const phaseTotal = phase.exercises.length;

        // Contar ejercicios completados de esta fase
        const phaseCompleted = phase.exercises.filter(ex =>
          completedExercises.has(`${phaseId}-${ex.id}`)
        ).length;

        // Calcular el progreso de la fase (0-1)
        const phaseProgress = phaseCompleted / phaseTotal;

        // Calcular el porcentaje que queda oculto (de derecha a izquierda)
        const hiddenPercent = 100 - (phaseProgress * 100);

        // Actualizar clip-path de la capa de color del logo
        const letterGroup = document.querySelector(`.letter-group[data-phase="${phaseId}"]`);
        if (letterGroup) {
          const colorLayer = letterGroup.querySelector('.color-layer');
          if (colorLayer) {
            // Para fase4 (la "p" tiene descender), usar valores negativos en top/bottom
            if (phaseId === 'fase4') {
              colorLayer.style.clipPath = `inset(-10% ${hiddenPercent}% -10% 0)`;
            } else {
              colorLayer.style.clipPath = `inset(0 ${hiddenPercent}% 0 0)`;
            }
          }
        }

        // Actualizar barra de progreso inferior
        const progressBar = document.querySelector(`.phase-progress-bar[data-phase="${phaseId}"]`);
        if (progressBar) {
          const progressFill = progressBar.querySelector('.absolute');
          if (progressFill) {
            progressFill.style.transform = `scaleX(${phaseProgress})`;
          }
        }

        // Celebrar si la fase se acaba de completar
        if (phaseProgress === 1 && !celebratedPhases.has(phaseId)) {
          celebratedPhases.add(phaseId);
          setTimeout(() => {
            celebratePhase(phaseId);

            // Scroll automático a la siguiente fase después del confetti
            setTimeout(() => {
              // Encontrar la siguiente fase
              const phaseOrder = ['fase1', 'fase2', 'fase3', 'fase4'];
              const currentIndex = phaseOrder.indexOf(phaseId);
              const nextPhaseId = phaseOrder[currentIndex + 1];

              if (nextPhaseId) {
                const nextContainer = document.querySelector(`.phase-container[data-phase-id="${nextPhaseId}"]`);
                if (nextContainer) {
                  const nextToggle = nextContainer.querySelector('.phase-toggle');
                  const nextContent = nextContainer.querySelector('.phase-content');

                  // Expandir la siguiente fase si está colapsada
                  if (nextContent && nextContent.classList.contains('hidden')) {
                    nextToggle?.click();
                  }

                  // Scroll suave a la siguiente fase con offset para el sticky header
                  setTimeout(() => {
                    if (nextToggle) {
                      // Calcular posición con offset para el header sticky (~120px)
                      const yOffset = -120;
                      const elementPosition = nextToggle.getBoundingClientRect().top;
                      const offsetPosition = elementPosition + window.pageYOffset + yOffset;

                      window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                      });
                    }
                  }, 100);
                }
              }
            }, 800); // Esperar a que termine el confetti
          }, 300);
        } else if (phaseProgress < 1 && celebratedPhases.has(phaseId)) {
          // Si la fase ya no está completa, permitir celebrarla de nuevo
          celebratedPhases.delete(phaseId);
        }
      });

      // Celebrate completion with confetti espectacular!
      if (completed === total && completed > 0) {
        setTimeout(() => {
          celebrateComplete();
        }, 400);
      }
    };

    // Update level buttons
    const updateLevelButtons = () => {
      document.querySelectorAll('.level-btn').forEach(btn => {
        const level = btn.dataset.level;
        if (level === currentLevel) {
          btn.classList.add('bg-blue-500', 'text-white', 'shadow-md');
          btn.classList.remove('bg-slate-200', 'text-slate-700');
        } else {
          btn.classList.remove('bg-blue-500', 'text-white', 'shadow-md');
          btn.classList.add('bg-slate-200', 'text-slate-700');
        }
      });
    };

    // Update level info in exercise cards
    const updateLevelInfo = () => {
      document.querySelectorAll('.level-info').forEach(info => {
        const levels = JSON.parse(info.dataset.levels || '{}');
        const levelText = info.querySelector('.level-text');
        const levelLabel = info.querySelector('.font-semibold');

        if (levels[currentLevel] && levelText && levelLabel) {
          levelText.textContent = levels[currentLevel];
          levelLabel.textContent = currentLevel.charAt(0).toUpperCase() + currentLevel.slice(1) + ':';
        }
      });
    };

    // Format time
    const formatTime = (seconds) => {
      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      return `${mins}:${secs.toString().padStart(2, '0')}`;
    };

    // Timer functions
    const startTimer = (card, duration) => {
      if (activeTimer && activeTimer.card !== card) {
        stopTimer(activeTimer.card);
      }

      const display = card.querySelector('.timer-display');
      const startBtn = card.querySelector('.start-timer-btn');
      const pauseBtn = card.querySelector('.pause-timer-btn');
      const resetBtn = card.querySelector('.reset-timer-btn');

      startBtn.classList.add('hidden');
      pauseBtn.classList.remove('hidden');
      resetBtn.classList.remove('hidden');

      // Animate timer start
      if (animate) {
        animate(display, { scale: [1, 1.1, 1] }, { duration: 0.4, easing: "ease-out" });
      }

      let timeLeft = duration;
      activeTimer = { card, timeLeft };

      timerInterval = setInterval(() => {
        timeLeft--;
        activeTimer.timeLeft = timeLeft;
        display.textContent = formatTime(timeLeft);

        // Pulse animation when time is running low (last 10 seconds)
        if (timeLeft <= 10 && timeLeft > 0 && animate) {
          animate(
            display,
            { scale: [1, 1.08, 1] },
            { duration: 0.5, easing: "ease-out" }
          );
        }

        if (timeLeft <= 0) {
          // Completion animation
          if (animate) {
            animate(
              display,
              { scale: [1, 1.2, 1], rotate: [0, 5, -5, 0] },
              { duration: 0.6, easing: "ease-out" }
            );
          }
          stopTimer(card);
        }
      }, 1000);
    };

    const pauseTimer = (card) => {
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }

      const pauseBtn = card.querySelector('.pause-timer-btn');
      const playBtn = card.querySelector('.play-timer-btn');

      pauseBtn.classList.add('hidden');
      playBtn.classList.remove('hidden');
    };

    const resumeTimer = (card) => {
      if (!activeTimer || activeTimer.card !== card) return;

      const display = card.querySelector('.timer-display');
      const pauseBtn = card.querySelector('.pause-timer-btn');
      const playBtn = card.querySelector('.play-timer-btn');

      playBtn.classList.add('hidden');
      pauseBtn.classList.remove('hidden');

      let timeLeft = activeTimer.timeLeft;

      timerInterval = setInterval(() => {
        timeLeft--;
        activeTimer.timeLeft = timeLeft;
        display.textContent = formatTime(timeLeft);

        if (timeLeft <= 0) {
          stopTimer(card);
        }
      }, 1000);
    };

    const stopTimer = (card) => {
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }

      const display = card.querySelector('.timer-display');
      const startBtn = card.querySelector('.start-timer-btn');
      const pauseBtn = card.querySelector('.pause-timer-btn');
      const playBtn = card.querySelector('.play-timer-btn');
      const resetBtn = card.querySelector('.reset-timer-btn');
      const duration = parseInt(card.dataset.duration || '0');

      display.textContent = formatTime(duration);
      startBtn.classList.remove('hidden');
      pauseBtn.classList.add('hidden');
      playBtn.classList.add('hidden');
      resetBtn.classList.add('hidden');

      if (activeTimer && activeTimer.card === card) {
        activeTimer = null;
      }
    };

    const resetTimer = (card) => {
      stopTimer(card);
      const duration = parseInt(card.dataset.duration || '0');
      const display = card.querySelector('.timer-display');
      display.textContent = formatTime(duration);
    };

    // Reset progress
    const resetProgress = () => {
      if (confirm(resetConfirmMsg)) {
        completedExercises.clear();
        celebratedPhases.clear();

        // Reset UI
        document.querySelectorAll('.exercise-card').forEach(card => {
          card.classList.remove('border-green-400', 'bg-green-50');
          card.classList.add('border-slate-200', 'bg-white');
          const btn = card.querySelector('.complete-btn');
          if (btn) {
            btn.classList.remove('bg-green-500', 'text-white');
            btn.classList.add('bg-slate-200', 'text-slate-500');
          }
        });

        updateProgress();
        saveState();
      }
    };

    // Check and show onboarding on first visit
    const checkOnboarding = () => {
      const hasSeenOnboarding = localStorage.getItem('unslump-onboarding-shown');
      if (!hasSeenOnboarding) {
        // Show onboarding modal after a short delay to let the page settle
        setTimeout(() => {
          openModal('onboarding-modal');
        }, 500);
      }
    };

    // Mark onboarding as seen
    const markOnboardingAsSeen = () => {
      localStorage.setItem('unslump-onboarding-shown', 'true');
    };

    // Modal animation helpers
    const openModal = (modalId) => {
      const modal = document.getElementById(modalId);
      if (!modal) return;

      modal.classList.remove('hidden');
      const content = modal.querySelector('.bg-white');

      // Ocultar el FAB cuando se abre el modal de onboarding
      if (modalId === 'onboarding-modal') {
        const fab = document.getElementById('show-onboarding-btn');
        if (fab && animate) {
          animate(fab, { opacity: [1, 0], scale: [1, 0.8] }, { duration: 0.2 }).finished.then(() => {
            fab.style.display = 'none';
          });
        } else if (fab) {
          fab.style.display = 'none';
        }
      }

      if (animate) {
        // Animate backdrop
        animate(modal, { opacity: [0, 1] }, { duration: 0.2 });

        // Animate modal content
        if (content) {
          animate(
            content,
            { opacity: [0, 1], scale: [0.95, 1], y: [20, 0] },
            { duration: 0.3, delay: 0.1, easing: "ease-out" }
          );
        }
      }
    };

    const closeModal = (modalId, callback) => {
      const modal = document.getElementById(modalId);
      if (!modal) return;

      const content = modal.querySelector('.bg-white');

      if (animate) {
        // Animate content out
        if (content) {
          animate(content, { opacity: [1, 0], scale: [1, 0.95], y: [0, 10] }, { duration: 0.2 });
        }

        // Animate backdrop out
        animate(modal, { opacity: [1, 0] }, { duration: 0.2, delay: 0.1 }).finished.then(() => {
          modal.classList.add('hidden');
          if (callback) callback();

          // Mostrar el FAB cuando se cierra el modal de onboarding
          if (modalId === 'onboarding-modal') {
            const fab = document.getElementById('show-onboarding-btn');
            if (fab) {
              fab.style.display = 'flex';
              animate(fab, { opacity: [0, 1], scale: [0.8, 1] }, { duration: 0.3 });
            }
          }
        });
      } else {
        // Fallback without animation
        modal.classList.add('hidden');
        if (callback) callback();

        // Mostrar el FAB cuando se cierra el modal de onboarding
        if (modalId === 'onboarding-modal') {
          const fab = document.getElementById('show-onboarding-btn');
          if (fab) {
            fab.style.display = 'flex';
          }
        }
      }
    };

    // Initial animations
    const runInitialAnimations = () => {
      if (!animate || !stagger) {
        console.warn('Motion not loaded yet');
        return;
      }

      // Animate logo entrance
      const logo = document.getElementById('progress-logo');
      if (logo) {
        animate(
          logo,
          { opacity: [0, 1], y: [-20, 0] },
          { duration: 0.8, easing: "ease-out" }
        );
      }

      // Animate letter groups with stagger
      const letterGroups = document.querySelectorAll('.letter-group');
      if (letterGroups.length > 0) {
        animate(
          letterGroups,
          { opacity: [0, 1], scale: [0.8, 1] },
          { duration: 0.6, delay: stagger(0.1, { start: 0.3 }), easing: "ease-out" }
        );
      }

      // Animate phase containers with stagger
      const phaseContainers = document.querySelectorAll('.phase-container');
      if (phaseContainers.length > 0) {
        animate(
          phaseContainers,
          { opacity: [0, 1], y: [30, 0] },
          { duration: 0.5, delay: stagger(0.15, { start: 0.5 }), easing: [0.22, 1, 0.36, 1] }
        );
      }

      // Animate FAB help button
      const helpBtn = document.getElementById('show-onboarding-btn');
      if (helpBtn) {
        animate(
          helpBtn,
          { opacity: [0, 1], scale: [0, 1.1, 1] },
          { duration: 0.6, delay: 1.2, easing: [0.34, 1.56, 0.64, 1] }
        );
      }
    };

    // Event Listeners
    document.addEventListener('DOMContentLoaded', async () => {
      // Wait for Motion to load and set aliases
      await waitForMotion();
      animate = window.motionAnimate;
      stagger = window.motionStagger;

      loadState();
      checkOnboarding();

      // Run initial animations after a short delay to let the page settle
      setTimeout(runInitialAnimations, 100);

      // Reset button
      const resetBtn = document.getElementById('reset-progress-btn');
      if (resetBtn) {
        resetBtn.addEventListener('click', resetProgress);
      }

      // Language selector
      const languageSelect = document.getElementById('language-select');
      if (languageSelect) {
        languageSelect.addEventListener('change', (e) => {
          const newLang = e.target.value;
          // Navigate to the new language URL
          window.location.href = `/${newLang}/`;
        });
      }

      // Level buttons
      document.querySelectorAll('.level-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          // Pulse animation on click
          if (animate) {
            animate(
              btn,
              { scale: [1, 1.15, 1] },
              { duration: 0.4, easing: "ease-out" }
            );
          }

          currentLevel = btn.dataset.level;
          updateLevelButtons();
          updateLevelInfo();
          saveState();

          // Animate level info updates
          if (animate) {
            document.querySelectorAll('.level-info').forEach(info => {
              animate(info, { opacity: [0.6, 1], x: [-5, 0] }, { duration: 0.3 });
            });
          }
        });

        // Hover effect
        btn.addEventListener('mouseenter', () => {
          if (animate && btn.dataset.level !== currentLevel) {
            animate(btn, { scale: 1.05 }, { duration: 0.2 });
          }
        });

        btn.addEventListener('mouseleave', () => {
          if (animate && btn.dataset.level !== currentLevel) {
            animate(btn, { scale: 1 }, { duration: 0.2 });
          }
        });
      });

      // Phase toggles
      document.querySelectorAll('.phase-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const phaseId = btn.dataset.phaseId;
          const container = document.querySelector(`.phase-container[data-phase-id="${phaseId}"]`);
          const content = container.querySelector('.phase-content');
          const chevronDown = container.querySelector('.chevron-down');
          const chevronUp = container.querySelector('.chevron-up');
          const isExpanded = !content.classList.contains('hidden');

          // Get phase colors
          const phase = workout[phaseId];

          if (isExpanded) {
            // Collapsing
            const exerciseCards = content.querySelectorAll('.exercise-card');

            if (animate && stagger) {
              // Animate cards out
              animate(
                exerciseCards,
                { opacity: [1, 0], y: [0, -10] },
                { duration: 0.2, delay: stagger(0.03, { from: 'first' }) }
              ).finished.then(() => {
                content.classList.add('hidden');
              });

              // Animate chevrons
              chevronUp.classList.remove('opacity-100');
              chevronUp.classList.add('opacity-0');
              chevronDown.classList.remove('opacity-0');
              chevronDown.classList.add('opacity-100');
            } else {
              // Fallback without animation
              content.classList.add('hidden');
              chevronUp.classList.remove('opacity-100');
              chevronUp.classList.add('opacity-0');
              chevronDown.classList.remove('opacity-0');
              chevronDown.classList.add('opacity-100');
            }

            // Update button style
            if (phase) {
              btn.style.background = `linear-gradient(135deg, white 0%, ${phase.colorLightHex} 100%)`;
              btn.classList.remove('shadow-xl', 'ring-2');
              btn.classList.add('shadow-lg');
            }
          } else {
            // Expanding
            content.classList.remove('hidden');
            const exerciseCards = content.querySelectorAll('.exercise-card');

            if (animate && stagger) {
              // Animate cards in
              animate(
                exerciseCards,
                { opacity: [0, 1], y: [10, 0] },
                { duration: 0.3, delay: stagger(0.05, { from: 'first', start: 0.1 }), easing: "ease-out" }
              );

              // Animate chevrons
              chevronDown.classList.remove('opacity-100');
              chevronDown.classList.add('opacity-0');
              chevronUp.classList.remove('opacity-0');
              chevronUp.classList.add('opacity-100');
            } else {
              // Fallback without animation
              chevronDown.classList.remove('opacity-100');
              chevronDown.classList.add('opacity-0');
              chevronUp.classList.remove('opacity-0');
              chevronUp.classList.add('opacity-100');
            }

            // Update button style
            if (phase) {
              btn.style.background = `linear-gradient(135deg, white 0%, ${phase.colorLightHex} 50%, ${phase.colorPrimaryHex}15 100%)`;
              btn.classList.remove('shadow-lg');
              btn.classList.add('shadow-xl', 'ring-2');
              btn.style.setProperty('--tw-ring-color', phase.colorBorderHex);
            }
          }
        });
      });

      // Toggle exercise completion (función reutilizable)
      const toggleExerciseCompletion = (phaseId, exerciseId) => {
        const key = `${phaseId}-${exerciseId}`;
        const card = document.querySelector(`.exercise-card[data-phase-id="${phaseId}"][data-exercise-id="${exerciseId}"]`);
        const btn = card?.querySelector('.complete-btn');

        if (!card) return;

        const colors = phaseColors[phaseId] || phaseColors.fase1;

        if (completedExercises.has(key)) {
          // Uncomplete animation
          completedExercises.delete(key);
          card.classList.remove(colors.border, colors.bg);
          card.classList.add('border-slate-200', 'bg-white');
          if (btn) {
            btn.classList.remove(colors.btnBg, colors.text);
            btn.classList.add('bg-slate-200', 'text-slate-500');
            // Subtle scale animation
            if (animate) {
              animate(btn, { scale: [1.2, 1] }, { duration: 0.3, easing: "ease-out" });
            }
          }
          // Card bounce back
          if (animate) {
            animate(card, { scale: [0.98, 1] }, { duration: 0.4, easing: "ease-out" });
          }
        } else {
          // Complete animation
          completedExercises.add(key);
          card.classList.add(colors.border, colors.bg);
          card.classList.remove('border-slate-200', 'bg-white');
          if (btn) {
            btn.classList.add(colors.btnBg, colors.text);
            btn.classList.remove('bg-slate-200', 'text-slate-500');
            // Celebratory pulse
            if (animate) {
              animate(btn, { scale: [1, 1.3, 1] }, { duration: 0.5, easing: "ease-out" });
            }
          }
          // Card success animation
          if (animate) {
            animate(
              card,
              { scale: [1, 1.02, 1], y: [0, -4, 0] },
              { duration: 0.6, easing: "ease-out" }
            );
          }
        }

        updateProgress();
        saveState();
      };

      // Complete buttons
      document.querySelectorAll('.complete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const phaseId = btn.dataset.phaseId;
          const exerciseId = btn.dataset.exerciseId;
          toggleExerciseCompletion(phaseId, exerciseId);
        });
      });

      // Exercise cards - hacer clic en la tarjeta para completar
      document.querySelectorAll('.exercise-card').forEach(card => {
        card.addEventListener('click', (e) => {
          // No activar si se hace clic en elementos interactivos
          if (
            e.target.closest('.info-btn') ||
            e.target.closest('.timer-container') ||
            e.target.closest('.sets-counter') ||
            e.target.closest('.complete-btn')
          ) {
            return;
          }

          const phaseId = card.dataset.phaseId;
          const exerciseId = card.dataset.exerciseId;
          toggleExerciseCompletion(phaseId, exerciseId);
        });
      });

      // Timer buttons
      document.querySelectorAll('.start-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          const duration = parseInt(btn.dataset.duration || '0');
          startTimer(card, duration);
        });
      });

      document.querySelectorAll('.pause-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          pauseTimer(card);
        });
      });

      document.querySelectorAll('.play-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          resumeTimer(card);
        });
      });

      document.querySelectorAll('.reset-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          resetTimer(card);
        });
      });

      // Sets counter buttons
      document.querySelectorAll('.increment-set-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const card = btn.closest('.exercise-card');
          const counter = card.querySelector('.sets-counter');
          const currentSetSpan = counter.querySelector('.current-set');
          const totalSets = parseInt(btn.dataset.totalSets || '0');
          const phaseId = btn.dataset.phaseId;
          const exerciseId = btn.dataset.exerciseId;

          let currentSet = parseInt(currentSetSpan.textContent || '0');
          if (currentSet < totalSets) {
            currentSet++;
            currentSetSpan.textContent = currentSet;

            // Animate counter increment
            if (animate) {
              animate(
                currentSetSpan,
                { scale: [1, 1.4, 1], rotate: [0, 5, 0] },
                { duration: 0.5, easing: "ease-out" }
              );

              // Pulse button feedback
              animate(btn, { scale: [1, 0.95, 1] }, { duration: 0.3 });
            }

            // Visual feedback when all sets are completed
            if (currentSet === totalSets) {
              // Celebration animation for completing all sets
              if (animate) {
                animate(
                  counter,
                  { scale: [1, 1.05, 1], y: [0, -5, 0] },
                  { duration: 0.6, easing: "ease-out" }
                );
              }

              counter.classList.add('ring-2', 'ring-green-400', 'shadow-lg');
              btn.disabled = true;
              btn.classList.add('opacity-50', 'cursor-not-allowed');

              // Auto-complete the exercise
              setTimeout(() => toggleExerciseCompletion(phaseId, exerciseId), 300);
            }
          }
        });
      });

      document.querySelectorAll('.reset-set-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const card = btn.closest('.exercise-card');
          const counter = card.querySelector('.sets-counter');
          const currentSetSpan = counter.querySelector('.current-set');
          const incrementBtn = card.querySelector('.increment-set-btn');
          const phaseId = btn.dataset.phaseId;
          const exerciseId = btn.dataset.exerciseId;
          const key = `${phaseId}-${exerciseId}`;

          // Reset animation
          if (animate) {
            animate(
              currentSetSpan,
              { scale: [1, 0.5, 1], rotate: [0, -180, -360] },
              { duration: 0.5, easing: "ease-out" }
            );
          }

          currentSetSpan.textContent = '0';
          counter.classList.remove('ring-2', 'ring-green-400', 'shadow-lg');

          if (incrementBtn) {
            incrementBtn.disabled = false;
            incrementBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          }

          // Uncomplete the exercise if it was completed
          if (completedExercises.has(key)) {
            toggleExerciseCompletion(phaseId, exerciseId);
          }
        });
      });

      // Info buttons
      document.querySelectorAll('.info-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();

          // Bounce animation on click
          if (animate) {
            animate(
              btn,
              { scale: [1, 0.9, 1.1, 1], rotate: [0, -10, 10, 0] },
              { duration: 0.5, easing: "ease-out" }
            );
          }

          const exerciseId = btn.dataset.exerciseId;
          const details = exerciseDetails[exerciseId];

          if (details) {
            // Find exercise name and video URL
            let exerciseName = '';
            let videoUrl = '';
            for (const phase of Object.values(workout)) {
              const exercise = phase.exercises.find(ex => ex.id === exerciseId);
              if (exercise) {
                exerciseName = exercise.name;
                videoUrl = exercise.videoUrl || '';
                break;
              }
            }

            document.getElementById('modal-title').textContent = exerciseName;
            document.getElementById('modal-muscles').textContent = details.muscles;
            document.getElementById('modal-why').textContent = details.why;
            document.getElementById('modal-evidence').textContent = details.evidence;
            document.getElementById('modal-tips').textContent = details.tips;

            // Handle video display
            const videoContainer = document.getElementById('modal-video-container');
            const videoIframe = document.getElementById('modal-video-iframe');

            if (videoUrl) {
              // Convert YouTube watch URL to embed URL
              const videoId = videoUrl.includes('watch?v=')
                ? videoUrl.split('watch?v=')[1].split('&')[0]
                : videoUrl.split('/').pop();
              const embedUrl = `https://www.youtube.com/embed/${videoId}`;

              videoIframe.src = embedUrl;
              videoContainer.classList.remove('hidden');
            } else {
              videoContainer.classList.add('hidden');
              videoIframe.src = '';
            }

            openModal('exercise-info-modal');
          }
        });
      });

      // Close info modal
      const closeInfoModal = () => {
        closeModal('exercise-info-modal', () => {
          // Stop video playback by clearing the iframe src
          document.getElementById('modal-video-iframe').src = '';
        });
      };

      document.getElementById('close-info-modal').addEventListener('click', closeInfoModal);
      document.getElementById('close-info-modal-btn').addEventListener('click', closeInfoModal);

      // References modal
      document.getElementById('show-references-btn').addEventListener('click', () => {
        openModal('references-modal');
      });

      document.getElementById('close-references-modal').addEventListener('click', () => {
        closeModal('references-modal');
      });

      document.getElementById('close-references-modal-btn').addEventListener('click', () => {
        closeModal('references-modal');
      });

      // Onboarding modal
      document.getElementById('show-onboarding-btn').addEventListener('click', () => {
        openModal('onboarding-modal');
      });

      const closeOnboardingModal = () => {
        closeModal('onboarding-modal', () => {
          markOnboardingAsSeen();
        });
      };

      document.getElementById('close-onboarding-modal').addEventListener('click', closeOnboardingModal);
      document.getElementById('close-onboarding-modal-btn').addEventListener('click', closeOnboardingModal);

      // Close modals on backdrop click
      document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            const callback = modal.id === 'onboarding-modal' ? markOnboardingAsSeen : undefined;
            closeModal(modal.id, callback);
          }
        });
      });
    });
  </script>
</BaseLayout>
