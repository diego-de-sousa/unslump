---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatTranslation, useTranslations, type Language } from '../../i18n/utils';

// Landing components
import Hero from '../../components/landing/Hero.astro';
import ProblemSection from '../../components/landing/ProblemSection.astro';
import PhaseSystemSection from '../../components/landing/PhaseSystemSection.astro';
import HowItWorksSection from '../../components/landing/HowItWorksSection.astro';
import TrustBadges from '../../components/landing/TrustBadges.astro';

// Modals (for references button)
import ReferencesModal from '../../components/modals/ReferencesModal.astro';

import { getReferences } from '../../data/index';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);
const references = getReferences(lang);
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
>
  <!-- Language selector - bottom left -->
  <details id="landing-language-menu" class="fixed bottom-6 left-6 z-50">
    <summary
      id="landing-language-toggle"
      role="button"
      aria-label={`${t('language.select')}. ${t('language.current')}: ${lang.toUpperCase()}`}
      aria-controls="landing-language-options"
      aria-expanded="false"
      class="flex h-12 w-12 cursor-pointer list-none items-center justify-center rounded-full border-2 border-indigo-500 bg-white text-sm font-bold text-indigo-600 shadow-lg transition-all duration-300 hover:scale-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
    >
      {lang.toUpperCase()}
    </summary>

    <div
      id="landing-language-options"
      class="absolute bottom-14 left-0 overflow-hidden rounded-xl border-2 border-gray-200 bg-white shadow-xl"
    >
      {['en', 'es'].filter(l => l !== lang).map((l) => (
        <a
          href={`/${l}/`}
          class="block px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors min-w-[60px] text-center"
          aria-label={formatTranslation(lang, 'language.switchTo', {
            language: l === 'en' ? 'English' : 'Español',
          })}
        >
          {l.toUpperCase()}
        </a>
      ))}
    </div>
  </details>

  <!-- Hero Section -->
  <Hero lang={lang} />

  <!-- Problem Section -->
  <ProblemSection lang={lang} />

  <!-- Phase System Section (fusión de Solution + Phase Showcase) -->
  <PhaseSystemSection lang={lang} />

  <!-- How It Works Section -->
  <HowItWorksSection lang={lang} />

  <!-- Trust Badges Section -->
  <TrustBadges lang={lang} />

  <!-- Final CTA Section -->
  <section class="final-cta py-16 sm:py-24 bg-indigo-600">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6 text-balance">
        {lang === 'en' ? 'Your posture will thank you 🙌' : 'Tu postura te lo agradecerá 🙌'}
      </h2>

      <p class="text-lg sm:text-xl text-white/90 mb-10 max-w-2xl mx-auto text-pretty">
        {lang === 'en'
          ? '25 minutes, 3 times a week. That\'s all it takes to counteract hours of sitting.'
          : '25 minutos, 3 veces por semana. Eso es todo lo que necesitas para contrarrestar las horas sentado.'}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center items-center">
        <a
          href={`/${lang}/workout`}
          class="inline-flex items-center gap-3 px-10 py-5 text-xl font-bold text-gray-900 bg-white rounded-2xl shadow-2xl hover:shadow-white/30 hover:scale-105 transition-all duration-300"
        >
          <svg class="h-7 w-7 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {t('landing.hero.ctaPrimary')}
        </a>

        <a
          href={`/${lang}/app`}
          class="inline-flex items-center gap-2 px-6 py-3 text-lg font-medium text-white border-2 border-white/50 rounded-2xl hover:bg-white/10 hover:border-white transition-all duration-300"
        >
          {lang === 'en' ? 'Browse exercises' : 'Ver ejercicios'}
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Footer note -->
      <p class="mt-12 text-sm sm:text-base text-white/90 text-pretty">
        {lang === 'en'
          ? 'No equipment needed. No excuses accepted. 💪'
          : 'No se necesita equipo. No se aceptan excusas. 💪'}
      </p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-8 bg-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-sm text-gray-600 text-pretty">
        {lang === 'en'
          ? 'Made with science and care for office workers everywhere 🧪❤️'
          : 'Hecho con ciencia y cariño para oficinistas de todo el mundo 🧪❤️'}
      </p>
      <p class="text-xs text-gray-500 mt-2 text-pretty">
        © {new Date().getFullYear()} unslump!
      </p>
    </div>
  </footer>

  <!-- References Modal -->
  <ReferencesModal lang={lang} references={references} />

  <!-- Modal handlers script -->
  <script>
    // Handle references modal
    window.addEventListener('open-references-modal', () => {
      const modal = document.getElementById('references-modal');
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    });

    // Close references modal
    const closeReferencesModal = () => {
      const modal = document.getElementById('references-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = 'auto';
      }
    };

    document.addEventListener('DOMContentLoaded', () => {
      const languageMenu = document.getElementById('landing-language-menu') as HTMLDetailsElement | null;
      const languageToggle = document.getElementById('landing-language-toggle');

      languageMenu?.addEventListener('toggle', () => {
        languageToggle?.setAttribute('aria-expanded', String(languageMenu.open));
      });

      const closeBtn = document.getElementById('close-references-modal');
      const closeModalBtn = document.getElementById('close-references-modal-btn');

      if (closeBtn) closeBtn.addEventListener('click', closeReferencesModal);
      if (closeModalBtn) closeModalBtn.addEventListener('click', closeReferencesModal);

      // Close on backdrop click
      const modal = document.getElementById('references-modal');
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            closeReferencesModal();
          }
        });
      }

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (languageMenu) languageMenu.open = false;
          closeReferencesModal();
        }
      });
    });
  </script>

  <style>
    /* Smooth scroll behavior */
    html {
      scroll-behavior: smooth;
    }

    /* Ensure modals are above everything */
    .modal {
      z-index: 9999;
    }
  </style>
</BaseLayout>
