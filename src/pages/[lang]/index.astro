      cursor: not-allowed;
      opacity: 0.6;
    }

    /* Key tips typography */
    #onboarding-modal strong {
      font-weight: 700;
      color: rgb(15, 23, 42); /* slate-900 */
    }

    #onboarding-modal em {
      font-style: italic;
      color: rgb(30, 41, 59); /* slate-800 */
    }
  </style>

  <script>
    import { animate, stagger } from "motion";

    // Expose Motion functions globally so the inline script can use them
    (window as any).motionAnimate = animate;
    (window as any).motionStagger = stagger;
  </script>

  <script is:inline define:vars={{
    exerciseDetails,
    workout,
    resetConfirmMsg: t('progress.resetConfirm'),
    darkModeLight: t('darkMode.light'),
    darkModeDark: t('darkMode.dark')
  }}>
    // Wait for Motion to be available
    const waitForMotion = () => {
      return new Promise((resolve) => {
        if (window.motionAnimate) {
          resolve();
        } else {
          setTimeout(() => waitForMotion().then(resolve), 50);
        }
      });
    };

    // Motion aliases (will be set after Motion loads)
    let animate, stagger;

    // App State
    let currentLevel = 'principiante';
    let completedExercises = new Set();
    let activeTimer = null;
    let timerInterval = null;
    let sessionLocked = false; // Track if session is locked (all exercises completed)

    // Color mapping for phases (Energía Progresiva palette)
    const phaseColors = {
      fase1: { border: 'border-indigo-400', bg: 'bg-indigo-50', btnBg: 'bg-indigo-600', text: 'text-white' },
      fase2: { border: 'border-teal-400', bg: 'bg-teal-50', btnBg: 'bg-teal-500', text: 'text-white' },
      fase3: { border: 'border-orange-400', bg: 'bg-orange-50', btnBg: 'bg-orange-500', text: 'text-white' },
      fase4: { border: 'border-pink-400', bg: 'bg-pink-50', btnBg: 'bg-pink-500', text: 'text-white' }
    };

    // Check if it's a new day and reset if needed
    const checkAndResetIfNewDay = () => {
      const saved = localStorage.getItem('unslump-progress');
      if (!saved) return false;

      try {
        const data = JSON.parse(saved);
        const lastSessionDate = data.lastSessionDate;

        if (!lastSessionDate) return false;

        const today = new Date().toDateString();
        const lastSession = new Date(lastSessionDate).toDateString();

        // If it's a new day, reset the session
        if (today !== lastSession) {
          completedExercises.clear();
          sessionLocked = false;
          saveState();
          return true;
        }

        // Check if session was completed (locked)
        if (data.sessionLocked) {
          sessionLocked = true;
        }
      } catch (e) {
        console.error('Error checking date:', e);
      }
      return false;
    };

    // Load state from localStorage
    const loadState = () => {
      // First check if we need to reset for a new day
      const wasReset = checkAndResetIfNewDay();

      const saved = localStorage.getItem('unslump-progress');
      if (saved) {
        try {
          const data = JSON.parse(saved);
          completedExercises = new Set(data.completed || []);
          currentLevel = data.level || 'principiante';

          // Update UI after DOM is fully painted
          requestAnimationFrame(() => {
            completedExercises.forEach(key => {
              // Split solo en el PRIMER guion para preservar IDs con guiones como "pectoral-stretch"
              const firstDashIndex = key.indexOf('-');
              const phaseId = key.substring(0, firstDashIndex);
              const exerciseId = key.substring(firstDashIndex + 1);
              // Selector más específico para asegurar que encontramos la tarjeta del ejercicio
              const card = document.querySelector(`.exercise-card[data-phase-id="${phaseId}"][data-exercise-id="${exerciseId}"]`);
              if (card) {
                const colors = phaseColors[phaseId] || phaseColors.fase1;
                card.classList.add(colors.border, colors.bg);
                card.classList.remove('border-slate-200', 'bg-white');
                const btn = card.querySelector('.complete-btn');
                if (btn) {
                  btn.classList.add(colors.btnBg, colors.text);
                  btn.classList.remove('bg-slate-200', 'text-slate-500');
                }
              }
            });
          });

          updateProgress();
          updateLevelButtons();
          updateLevelInfo();
        } catch (e) {
          console.error('Error loading state:', e);
        }
      }
    };

    // Save state to localStorage
    const saveState = () => {
      const total = Object.values(workout).reduce((sum, phase) => sum + phase.exercises.length, 0);
      const completed = completedExercises.size;

      // Lock session if all exercises are completed
      if (completed === total && completed > 0) {
        sessionLocked = true;
      }

      localStorage.setItem('unslump-progress', JSON.stringify({
        completed: Array.from(completedExercises),
        level: currentLevel,
        sessionLocked: sessionLocked,
        lastSessionDate: new Date().toISOString()
      }));
    };

    // Track which phases have already been celebrated
    let celebratedPhases = new Set();

    // Confetti desde una parte específica del logo
    const celebratePhase = (phaseId) => {
      const letterGroup = document.querySelector(`.letter-group[data-phase="${phaseId}"]`);
      if (!letterGroup) return;

      // Motion animation for the letter group (only if Motion is loaded)
      if (animate) {
        animate(
          letterGroup,
          { scale: [1, 1.15, 1], rotate: [0, -3, 3, 0], y: [0, -10, 0] },
          { duration: 0.8, easing: "ease-out" }
        );
      }

      // Confetti celebration - single burst
      if (typeof confetti !== 'undefined') {
        const rect = letterGroup.getBoundingClientRect();
        const originX = (rect.left + rect.width / 2) / window.innerWidth;
        const originY = (rect.top + rect.height / 2) / window.innerHeight;

        // Colores por fase
        const phaseColorMap = {
          fase1: ['#4f46e5', '#6366f1', '#818cf8'], // indigo
          fase2: ['#14b8a6', '#2dd4bf', '#5eead4'], // teal
          fase3: ['#f97316', '#fb923c', '#fdba74'], // orange
          fase4: ['#ec4899', '#f472b6', '#f9a8d4']  // pink
        };

        const colors = phaseColorMap[phaseId] || phaseColorMap.fase1;

        // Un solo disparo de confetti
        confetti({
          origin: { x: originX, y: originY },
          colors,
          angle: 270, // Disparar hacia abajo
          particleCount: 80,
          spread: 80,
          startVelocity: 50,
          decay: 0.91,
          scalar: 1
        });
      }
    };

    // Confetti espectacular final desde todas las partes del logo
    const celebrateComplete = () => {
      const phaseIds = ['fase1', 'fase2', 'fase3', 'fase4'];
      const phaseColorMap = {
        fase1: ['#4f46e5', '#6366f1', '#818cf8'],
        fase2: ['#14b8a6', '#2dd4bf', '#5eead4'],
        fase3: ['#f97316', '#fb923c', '#fdba74'],
        fase4: ['#ec4899', '#f472b6', '#f9a8d4']
      };

      // Animate each letter group with the same animation as phase completion (only if Motion is loaded)
      if (animate && stagger) {
        // Animate each letter group in sequence with bounce (same as phase celebration)
        const letterGroups = document.querySelectorAll('.letter-group');
        if (letterGroups.length > 0) {
          animate(
            letterGroups,
            { scale: [1, 1.15, 1], rotate: [0, -3, 3, 0], y: [0, -10, 0] },
            {
              duration: 0.8,
              delay: stagger(0.15),
              easing: "ease-out"
            }
          );
        }
      }

      // Confetti celebration - single burst per phase
      if (typeof confetti !== 'undefined') {
        phaseIds.forEach((phaseId, index) => {
          setTimeout(() => {
            const letterGroup = document.querySelector(`.letter-group[data-phase="${phaseId}"]`);
            if (!letterGroup) return;

            const rect = letterGroup.getBoundingClientRect();
            const originX = (rect.left + rect.width / 2) / window.innerWidth;
            const originY = (rect.top + rect.height / 2) / window.innerHeight;
            const colors = phaseColorMap[phaseId];

            // Un solo disparo de confetti por fase
            confetti({
              origin: { x: originX, y: originY },
              colors,
              angle: 270, // Disparar hacia abajo
              particleCount: 100,
              spread: 90,
              startVelocity: 55,
              decay: 0.91,
              scalar: 1.1
            });
          }, index * 150); // Escalonar las explosiones
        });
      }
    };

    // Show/hide completion section
    const updateCompletionSection = () => {
      const total = Object.values(workout).reduce((sum, phase) => sum + phase.exercises.length, 0);
      const completed = completedExercises.size;
      const completionSection = document.getElementById('completion-section');

      if (completed === total && completed > 0) {
        // All exercises completed - show completion section
        if (completionSection.classList.contains('hidden')) {
          completionSection.classList.remove('hidden');

          // Smooth scroll to completion section with offset for sticky header
          setTimeout(() => {
            const yOffset = -120;
            const elementPosition = completionSection.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset + yOffset;

            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }, 1000); // Wait for confetti to finish

          // Animate section entrance
          if (animate) {
            animate(
              completionSection,
              { opacity: [0, 1], y: [30, 0], scale: [0.95, 1] },
              { duration: 0.6, easing: "ease-out" }
            );
          }
        }
      } else {
        // Not all exercises completed - hide completion section
        completionSection.classList.add('hidden');
      }
    };

    // Update progress bar
    const updateProgress = () => {
      const total = Object.values(workout).reduce((sum, phase) => sum + phase.exercises.length, 0);
      const completed = completedExercises.size;

      // Actualizar cada grupo de letras con clip-path
      ['fase1', 'fase2', 'fase3', 'fase4'].forEach(phaseId => {
        const phase = workout[phaseId];
        const phaseTotal = phase.exercises.length;

        // Contar ejercicios completados de esta fase
        const phaseCompleted = phase.exercises.filter(ex =>
          completedExercises.has(`${phaseId}-${ex.id}`)
        ).length;

        // Calcular el progreso de la fase (0-1)
        const phaseProgress = phaseCompleted / phaseTotal;

        // Calcular el porcentaje que queda oculto (de derecha a izquierda)
        const hiddenPercent = 100 - (phaseProgress * 100);

        // Actualizar clip-path y rotaciones de la capa de color de TODOS los logos
        const letterGroups = document.querySelectorAll(`.letter-group[data-phase="${phaseId}"]`);
        letterGroups.forEach(letterGroup => {
          const colorLayer = letterGroup.querySelector('.color-layer');
          const baseLayer = letterGroup.querySelector('.base-layer');

          if (colorLayer && baseLayer) {
            // Animar gradualmente las rotaciones de "encorvado" a "recto" según el progreso
            // XROT: 25 (encorvado hacia atrás) -> 0 (recto)
            // YROT: -15 (inclinado lateral al otro lado) -> 0 (recto)
            const xrotValue = 25 - (phaseProgress * 25);
            const yrotValue = -15 + (phaseProgress * 15);

            // Actualizar custom properties para animar las rotaciones
            colorLayer.style.setProperty('--xrot', xrotValue);
            baseLayer.style.setProperty('--xrot', xrotValue);
            colorLayer.style.setProperty('--yrot', yrotValue);
            baseLayer.style.setProperty('--yrot', yrotValue);

            // Para fase4 (la "p" tiene descender), usar valores negativos en top/bottom
            if (phaseId === 'fase4') {
              colorLayer.style.clipPath = `inset(-10% ${hiddenPercent}% -10% 0)`;
            } else {
              colorLayer.style.clipPath = `inset(0 ${hiddenPercent}% 0 0)`;
            }
          }
        });

        // Actualizar barra de progreso inferior
        const progressBar = document.querySelector(`.phase-progress-bar[data-phase="${phaseId}"]`);
        if (progressBar) {
          const progressFill = progressBar.querySelector('.absolute');
          if (progressFill) {
            progressFill.style.transform = `scaleX(${phaseProgress})`;
          }
        }

        // Celebrar si la fase se acaba de completar
        if (phaseProgress === 1 && !celebratedPhases.has(phaseId)) {
          celebratedPhases.add(phaseId);
          setTimeout(() => {
            celebratePhase(phaseId);

            // Scroll automático a la siguiente fase después del confetti
            setTimeout(() => {
              // Encontrar la siguiente fase
              const phaseOrder = ['fase1', 'fase2', 'fase3', 'fase4'];
              const currentIndex = phaseOrder.indexOf(phaseId);
              const nextPhaseId = phaseOrder[currentIndex + 1];

              if (nextPhaseId) {
                const nextContainer = document.querySelector(`.phase-container[data-phase-id="${nextPhaseId}"]`);
                if (nextContainer) {
                  const nextToggle = nextContainer.querySelector('.phase-toggle');
                  const nextContent = nextContainer.querySelector('.phase-content');

                  // Expandir la siguiente fase si está colapsada
                  if (nextContent && nextContent.classList.contains('hidden')) {
                    nextToggle?.click();
                  }

                  // Scroll suave a la siguiente fase con offset para el sticky header
                  setTimeout(() => {
                    if (nextToggle) {
                      // Calcular posición con offset para el header sticky (~120px)
                      const yOffset = -120;
                      const elementPosition = nextToggle.getBoundingClientRect().top;
                      const offsetPosition = elementPosition + window.pageYOffset + yOffset;

                      window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                      });
                    }
                  }, 100);
                }
              }
            }, 800); // Esperar a que termine el confetti
          }, 300);
        } else if (phaseProgress < 1 && celebratedPhases.has(phaseId)) {
          // Si la fase ya no está completa, permitir celebrarla de nuevo
          celebratedPhases.delete(phaseId);
        }
      });

      // Celebrate completion with confetti espectacular!
      if (completed === total && completed > 0) {
        setTimeout(() => {
          celebrateComplete();
        }, 400);
      }

      // Update completion section visibility
      updateCompletionSection();
    };

    // Update level buttons (cards)
    const updateLevelButtons = () => {
      document.querySelectorAll('.level-btn').forEach(btn => {
        const level = btn.dataset.level;
        const iconEl = btn.querySelector('.level-icon');
        const titleEl = btn.querySelector('.level-title');
        const descEl = btn.querySelector('.level-desc');

        if (level === currentLevel) {
          // Selected state - use level-specific colors
          const gradient = btn.dataset.gradient;
          const border = btn.dataset.border;
          const ring = btn.dataset.ring;
          const text = btn.dataset.text;
          const textLight = btn.dataset.textLight;

          // Remove all possible gradient classes first
          btn.classList.remove('bg-white', 'dark:bg-gray-800', 'border-slate-200', 'dark:border-gray-700');
          btn.classList.remove('from-green-50', 'to-emerald-50', 'from-orange-50', 'to-amber-50', 'from-purple-50', 'to-violet-50');
          btn.classList.remove('border-green-400', 'border-orange-400', 'border-purple-400');
          btn.classList.remove('ring-green-400', 'ring-orange-400', 'ring-purple-400');
          btn.classList.remove('shadow-md', 'shadow-lg', 'scale-105', 'ring-2', 'ring-offset-2');

          // Apply selected state
          btn.classList.add('bg-gradient-to-br', 'dark:bg-opacity-30', 'shadow-lg', 'scale-105', 'ring-2', 'ring-offset-2');
          gradient.split(' ').forEach(cls => btn.classList.add(cls));
          btn.classList.add(border);
          btn.classList.add(ring);

          // Icon scale
          if (iconEl) {
            iconEl.classList.add('scale-110');
          }

          // Title colors
          if (titleEl) {
            titleEl.classList.remove('text-slate-800', 'dark:text-gray-200', 'group-hover:text-blue-600', 'dark:group-hover:text-blue-400');
            titleEl.classList.remove('text-green-700', 'text-orange-700', 'text-purple-700');
            titleEl.classList.add(text, 'dark:text-blue-300');
          }

          // Description colors
          if (descEl) {
            descEl.classList.remove('text-slate-600', 'dark:text-gray-400', 'group-hover:text-slate-700', 'dark:group-hover:text-gray-300');
            descEl.classList.remove('text-green-600', 'text-orange-600', 'text-purple-600');
            descEl.classList.add(textLight, 'dark:text-blue-400');
          }
        } else {
          // Unselected state - reset to default
          btn.classList.remove('bg-gradient-to-br', 'dark:bg-opacity-30', 'shadow-lg', 'scale-105', 'ring-2', 'ring-offset-2');
          btn.classList.remove('from-green-50', 'to-emerald-50', 'from-orange-50', 'to-amber-50', 'from-purple-50', 'to-violet-50');
          btn.classList.remove('border-green-400', 'border-orange-400', 'border-purple-400');
          btn.classList.remove('ring-green-400', 'ring-orange-400', 'ring-purple-400');
          btn.classList.add('bg-white', 'dark:bg-gray-800', 'border-slate-200', 'dark:border-gray-700');

          // Icon reset
          if (iconEl) {
            iconEl.classList.remove('scale-110');
          }

          // Title reset
          if (titleEl) {
            titleEl.classList.remove('text-green-700', 'text-orange-700', 'text-purple-700', 'dark:text-blue-300');
            titleEl.classList.add('text-slate-800', 'dark:text-gray-200', 'group-hover:text-blue-600', 'dark:group-hover:text-blue-400');
          }

          // Description reset
          if (descEl) {
            descEl.classList.remove('text-green-600', 'text-orange-600', 'text-purple-600', 'dark:text-blue-400');
            descEl.classList.add('text-slate-600', 'dark:text-gray-400', 'group-hover:text-slate-700', 'dark:group-hover:text-gray-300');
          }
        }
      });
    };

    // Update level info in exercise cards
    const updateLevelInfo = () => {
      document.querySelectorAll('.level-info').forEach(info => {
        const levels = JSON.parse(info.dataset.levels || '{}');
        const levelText = info.querySelector('.level-text');
        const levelLabel = info.querySelector('.font-semibold');

        if (levels[currentLevel] && levelText && levelLabel) {
          levelText.textContent = levels[currentLevel];
          levelLabel.textContent = currentLevel.charAt(0).toUpperCase() + currentLevel.slice(1) + ':';
        }
      });
    };

    // Format time
    const formatTime = (seconds) => {
      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      return `${mins}:${secs.toString().padStart(2, '0')}`;
    };

    // Timer functions
    const startTimer = (card, duration) => {
      if (activeTimer && activeTimer.card !== card) {
        stopTimer(activeTimer.card);
      }

      const display = card.querySelector('.timer-display');
      const startBtn = card.querySelector('.start-timer-btn');
      const pauseBtn = card.querySelector('.pause-timer-btn');
      const resetBtn = card.querySelector('.reset-timer-btn');

      startBtn.classList.add('hidden');
      pauseBtn.classList.remove('hidden');
      resetBtn.classList.remove('hidden');

      // Animate timer start
      if (animate) {
        animate(display, { scale: [1, 1.1, 1] }, { duration: 0.4, easing: "ease-out" });
      }

      let timeLeft = duration;
      activeTimer = { card, timeLeft };

      timerInterval = setInterval(() => {
        timeLeft--;
        activeTimer.timeLeft = timeLeft;
        display.textContent = formatTime(timeLeft);

        // Pulse animation when time is running low (last 10 seconds)
        if (timeLeft <= 10 && timeLeft > 0 && animate) {
          animate(
            display,
            { scale: [1, 1.08, 1] },
            { duration: 0.5, easing: "ease-out" }
          );
        }

        if (timeLeft <= 0) {
          // Completion animation
          if (animate) {
            animate(
              display,
              { scale: [1, 1.2, 1], rotate: [0, 5, -5, 0] },
              { duration: 0.6, easing: "ease-out" }
            );
          }
          stopTimer(card);
        }
      }, 1000);
    };

    const pauseTimer = (card) => {
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }

      const pauseBtn = card.querySelector('.pause-timer-btn');
      const playBtn = card.querySelector('.play-timer-btn');

      pauseBtn.classList.add('hidden');
      playBtn.classList.remove('hidden');
    };

    const resumeTimer = (card) => {
      if (!activeTimer || activeTimer.card !== card) return;

      const display = card.querySelector('.timer-display');
      const pauseBtn = card.querySelector('.pause-timer-btn');
      const playBtn = card.querySelector('.play-timer-btn');

      playBtn.classList.add('hidden');
      pauseBtn.classList.remove('hidden');

      let timeLeft = activeTimer.timeLeft;

      timerInterval = setInterval(() => {
        timeLeft--;
        activeTimer.timeLeft = timeLeft;
        display.textContent = formatTime(timeLeft);

        if (timeLeft <= 0) {
          stopTimer(card);
        }
      }, 1000);
    };

    const stopTimer = (card) => {
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }

      const display = card.querySelector('.timer-display');
      const startBtn = card.querySelector('.start-timer-btn');
      const pauseBtn = card.querySelector('.pause-timer-btn');
      const playBtn = card.querySelector('.play-timer-btn');
      const resetBtn = card.querySelector('.reset-timer-btn');
      const duration = parseInt(card.dataset.duration || '0');

      display.textContent = formatTime(duration);
      startBtn.classList.remove('hidden');
      pauseBtn.classList.add('hidden');
      playBtn.classList.add('hidden');
      resetBtn.classList.add('hidden');

      if (activeTimer && activeTimer.card === card) {
        activeTimer = null;
      }
    };

    const resetTimer = (card) => {
      stopTimer(card);
      const duration = parseInt(card.dataset.duration || '0');
      const display = card.querySelector('.timer-display');
      display.textContent = formatTime(duration);
    };

    // Reset progress
    const resetProgress = () => {
      if (confirm(resetConfirmMsg)) {
        completedExercises.clear();
        celebratedPhases.clear();
        sessionLocked = false; // Unlock session on manual reset

        // Reset UI with phase colors
        document.querySelectorAll('.exercise-card').forEach(card => {
          const phaseId = card.dataset.phaseId;
          const colors = phaseColors[phaseId] || phaseColors.fase1;

          card.classList.remove(colors.border, colors.bg);
          card.classList.add('border-slate-200', 'bg-white');
          const btn = card.querySelector('.complete-btn');
          if (btn) {
            btn.classList.remove(colors.btnBg, colors.text);
            btn.classList.add('bg-slate-200', 'text-slate-500');
          }
        });

        // Scroll to top smoothly
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });

        updateProgress();
        saveState();
      }
    };

    // Check and show onboarding on first visit
    const checkOnboarding = () => {
      const hasSeenOnboarding = localStorage.getItem('unslump-onboarding-shown');
      if (!hasSeenOnboarding) {
        // Show onboarding modal after a short delay to let the page settle
        setTimeout(() => {
          openModal('onboarding-modal');
        }, 500);
      }
    };

    // Mark onboarding as seen
    const markOnboardingAsSeen = () => {
      localStorage.setItem('unslump-onboarding-shown', 'true');
    };

    // Modal animation helpers
    const openModal = (modalId) => {
      const modal = document.getElementById(modalId);
      if (!modal) return;

      modal.classList.remove('hidden');
      const content = modal.querySelector('.bg-white');

      // Ocultar el FAB cuando se abre el modal de onboarding
      if (modalId === 'onboarding-modal') {
        const fab = document.getElementById('show-onboarding-btn');
        if (fab && animate) {
          animate(fab, { opacity: [1, 0], scale: [1, 0.8] }, { duration: 0.2 }).finished.then(() => {
            fab.style.display = 'none';
          });
        } else if (fab) {
          fab.style.display = 'none';
        }
      }

      if (animate) {
        // Animate backdrop
        animate(modal, { opacity: [0, 1] }, { duration: 0.2 });

        // Animate modal content
        if (content) {
          animate(
            content,
            { opacity: [0, 1], scale: [0.95, 1], y: [20, 0] },
            { duration: 0.3, delay: 0.1, easing: "ease-out" }
          );
        }

        // Stagger animation for onboarding sections
        if (modalId === 'onboarding-modal') {
          const sections = modal.querySelectorAll('.onboarding-section');
          if (sections.length > 0) {
            animate(
              sections,
              { opacity: [0, 1], y: [20, 0] },
              {
                duration: 0.4,
                delay: stagger(0.08, { start: 0.3 }),
                easing: "ease-out"
              }
            );
          }
        }
      }
    };

    const closeModal = (modalId, callback) => {
      const modal = document.getElementById(modalId);
      if (!modal) return;

      const content = modal.querySelector('.bg-white');

      if (animate) {
        // Animate content out
        if (content) {
          animate(content, { opacity: [1, 0], scale: [1, 0.95], y: [0, 10] }, { duration: 0.2 });
        }

        // Animate backdrop out
        animate(modal, { opacity: [1, 0] }, { duration: 0.2, delay: 0.1 }).finished.then(() => {
          modal.classList.add('hidden');
          if (callback) callback();

          // Mostrar el FAB cuando se cierra el modal de onboarding
          if (modalId === 'onboarding-modal') {
            const fab = document.getElementById('show-onboarding-btn');
            if (fab) {
              fab.style.display = 'flex';
              animate(fab, { opacity: [0, 1], scale: [0.8, 1] }, { duration: 0.3 });
            }
          }
        });
      } else {
        // Fallback without animation
        modal.classList.add('hidden');
        if (callback) callback();

        // Mostrar el FAB cuando se cierra el modal de onboarding
        if (modalId === 'onboarding-modal') {
          const fab = document.getElementById('show-onboarding-btn');
          if (fab) {
            fab.style.display = 'flex';
          }
        }
      }
    };

    // Initial animations
    const runInitialAnimations = () => {
      if (!animate || !stagger) {
        console.warn('Motion not loaded yet');
        return;
      }

      // Animate logo entrance
      const logo = document.getElementById('progress-logo');
      if (logo) {
        animate(
          logo,
          { opacity: [0, 1], y: [-20, 0] },
          { duration: 0.8, easing: "ease-out" }
        );
      }

      // Animate letter groups with stagger
      const letterGroups = document.querySelectorAll('.letter-group');
      if (letterGroups.length > 0) {
        animate(
          letterGroups,
          { opacity: [0, 1], scale: [0.8, 1] },
          { duration: 0.6, delay: stagger(0.1, { start: 0.3 }), easing: "ease-out" }
        );
      }

      // Animate phase containers with stagger
      const phaseContainers = document.querySelectorAll('.phase-container');
      if (phaseContainers.length > 0) {
        animate(
          phaseContainers,
          { opacity: [0, 1], y: [30, 0] },
          { duration: 0.5, delay: stagger(0.15, { start: 0.5 }), easing: [0.22, 1, 0.36, 1] }
        );
      }

      // Animate FAB help button
      const helpBtn = document.getElementById('show-onboarding-btn');
      if (helpBtn) {
        animate(
          helpBtn,
          { opacity: [0, 1], scale: [0, 1.1, 1] },
          { duration: 0.6, delay: 1.2, easing: [0.34, 1.56, 0.64, 1] }
        );
      }
    };

    // Event Listeners
    document.addEventListener('DOMContentLoaded', async () => {
      // Wait for Motion to load and set aliases
      await waitForMotion();
      animate = window.motionAnimate;
      stagger = window.motionStagger;

      loadState();
      checkOnboarding();

      // Listen for exercise completion from islands (Timer, SetCounter)
      window.addEventListener('exercise-complete', (event) => {
        const { phaseId, exerciseId } = event.detail;
        toggleExerciseCompletion(phaseId, exerciseId);
      });

      // Listen for exercise un-completion from islands (SetCounter reset)
      window.addEventListener('exercise-uncomplete', (event) => {
        const { phaseId, exerciseId } = event.detail;
        const key = `${phaseId}-${exerciseId}`;

        // Only uncomplete if it was completed
        if (completedExercises.has(key)) {
          toggleExerciseCompletion(phaseId, exerciseId);
        }
      });

      // Run initial animations after a short delay to let the page settle
      setTimeout(runInitialAnimations, 100);

      // Reset button
      const resetBtn = document.getElementById('reset-progress-btn');
      if (resetBtn) {
        resetBtn.addEventListener('click', resetProgress);
      }

      // Reset session button (in completion section)
      const resetSessionBtn = document.getElementById('reset-session-btn');
      if (resetSessionBtn) {
        resetSessionBtn.addEventListener('click', resetProgress);
      }

      // Language selector
      const languageSelect = document.getElementById('language-select');
      if (languageSelect) {
        languageSelect.addEventListener('change', (e) => {
          const newLang = e.target.value;
          // Navigate to the new language URL
          window.location.href = `/${newLang}/`;
        });
      }

      // Dark mode toggle - DISABLED FOR NOW
      // const themeToggle = document.getElementById('theme-toggle');
      // const themeToggleText = document.getElementById('theme-toggle-text');
      // const themeToggleIcon = document.getElementById('theme-toggle-icon');

      // function updateThemeToggle() {
      //   const isDark = document.documentElement.classList.contains('dark');
      //   if (themeToggleText) {
      //     themeToggleText.textContent = isDark ? darkModeDark : darkModeLight;
      //   }
      //   if (themeToggleIcon) {
      //     themeToggleIcon.textContent = isDark ? '🌙' : '🌞';
      //   }
      // }

      // if (themeToggle) {
      //   updateThemeToggle();

      //   themeToggle.addEventListener('click', () => {
      //     const isDark = document.documentElement.classList.contains('dark');

      //     if (isDark) {
      //       document.documentElement.classList.remove('dark');
      //       localStorage.setItem('theme', 'light');
      //     } else {
      //       document.documentElement.classList.add('dark');
      //       localStorage.setItem('theme', 'dark');
      //     }

      //     updateThemeToggle();
      //   });
      // }

      // Level buttons
      document.querySelectorAll('.level-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          // Pulse animation on click
          if (animate) {
            animate(
              btn,
              { scale: [1, 1.15, 1] },
              { duration: 0.4, easing: "ease-out" }
            );
          }

          currentLevel = btn.dataset.level;
          updateLevelButtons();
          updateLevelInfo();
          saveState();

          // Animate level info updates
          if (animate) {
            document.querySelectorAll('.level-info').forEach(info => {
              animate(info, { opacity: [0.6, 1], x: [-5, 0] }, { duration: 0.3 });
            });
          }
        });

        // Hover effect
        btn.addEventListener('mouseenter', () => {
          if (animate && btn.dataset.level !== currentLevel) {
            animate(btn, { scale: 1.05 }, { duration: 0.2 });
          }
        });

        btn.addEventListener('mouseleave', () => {
          if (animate && btn.dataset.level !== currentLevel) {
            animate(btn, { scale: 1 }, { duration: 0.2 });
          }
        });
      });

      // Phase toggles
      document.querySelectorAll('.phase-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const phaseId = btn.dataset.phaseId;
          const container = document.querySelector(`.phase-container[data-phase-id="${phaseId}"]`);
          const content = container.querySelector('.phase-content');
          const chevronDown = container.querySelector('.chevron-down');
          const chevronUp = container.querySelector('.chevron-up');
          const isExpanded = !content.classList.contains('hidden');

          // Get phase colors
          const phase = workout[phaseId];

          if (isExpanded) {
            // Collapsing
            const exerciseCards = content.querySelectorAll('.exercise-card');

            if (animate && stagger) {
              // Animate cards out
              animate(
                exerciseCards,
                { opacity: [1, 0], y: [0, -10] },
                { duration: 0.2, delay: stagger(0.03, { from: 'first' }) }
              ).finished.then(() => {
                content.classList.add('hidden');
              });

              // Animate chevrons
              chevronUp.classList.remove('opacity-100');
              chevronUp.classList.add('opacity-0');
              chevronDown.classList.remove('opacity-0');
              chevronDown.classList.add('opacity-100');
            } else {
              // Fallback without animation
              content.classList.add('hidden');
              chevronUp.classList.remove('opacity-100');
              chevronUp.classList.add('opacity-0');
              chevronDown.classList.remove('opacity-0');
              chevronDown.classList.add('opacity-100');
            }

            // Update button style
            if (phase) {
              btn.style.background = `linear-gradient(135deg, white 0%, ${phase.colorLightHex} 100%)`;
              btn.classList.remove('shadow-xl', 'ring-2');
              btn.classList.add('shadow-lg');
            }
          } else {
            // Expanding
            content.classList.remove('hidden');
            const exerciseCards = content.querySelectorAll('.exercise-card');

            if (animate && stagger) {
              // Animate cards in
              animate(
                exerciseCards,
                { opacity: [0, 1], y: [10, 0] },
                { duration: 0.3, delay: stagger(0.05, { from: 'first', start: 0.1 }), easing: "ease-out" }
              );

              // Animate chevrons
              chevronDown.classList.remove('opacity-100');
              chevronDown.classList.add('opacity-0');
              chevronUp.classList.remove('opacity-0');
              chevronUp.classList.add('opacity-100');
            } else {
              // Fallback without animation
              chevronDown.classList.remove('opacity-100');
              chevronDown.classList.add('opacity-0');
              chevronUp.classList.remove('opacity-0');
              chevronUp.classList.add('opacity-100');
            }

            // Update button style
            if (phase) {
              btn.style.background = `linear-gradient(135deg, white 0%, ${phase.colorLightHex} 50%, ${phase.colorPrimaryHex}15 100%)`;
              btn.classList.remove('shadow-lg');
              btn.classList.add('shadow-xl', 'ring-2');
              btn.style.setProperty('--tw-ring-color', phase.colorBorderHex);
            }
          }
        });
      });

      // Toggle exercise completion (función reutilizable)
      const toggleExerciseCompletion = (phaseId, exerciseId) => {
        const key = `${phaseId}-${exerciseId}`;
        const card = document.querySelector(`.exercise-card[data-phase-id="${phaseId}"][data-exercise-id="${exerciseId}"]`);
        const btn = card?.querySelector('.complete-btn');

        if (!card) return;

        const colors = phaseColors[phaseId] || phaseColors.fase1;

        if (completedExercises.has(key)) {
          // BLOCK UNCOMPLETE if session is locked (all exercises completed)
          if (sessionLocked) {
            // Show visual feedback that action is blocked
            if (animate) {
              animate(
                card,
                { x: [-5, 5, -5, 5, 0] },
                { duration: 0.4, easing: "ease-out" }
              );
            }
            return; // Don't allow uncomplete
          }

          // Uncomplete animation
          completedExercises.delete(key);
          card.classList.remove(colors.border, colors.bg);
          card.classList.add('border-slate-200', 'bg-white');
          if (btn) {
            btn.classList.remove(colors.btnBg, colors.text);
            btn.classList.add('bg-slate-200', 'text-slate-500');
            // Subtle scale animation
            if (animate) {
              animate(btn, { scale: [1.2, 1] }, { duration: 0.3, easing: "ease-out" });
            }
          }
          // Card bounce back
          if (animate) {
            animate(card, { scale: [0.98, 1] }, { duration: 0.4, easing: "ease-out" });
          }
        } else {
          // Complete animation
          completedExercises.add(key);
          card.classList.add(colors.border, colors.bg);
          card.classList.remove('border-slate-200', 'bg-white');
          if (btn) {
            btn.classList.add(colors.btnBg, colors.text);
            btn.classList.remove('bg-slate-200', 'text-slate-500');
            // Celebratory pulse
            if (animate) {
              animate(btn, { scale: [1, 1.3, 1] }, { duration: 0.5, easing: "ease-out" });
            }
          }
          // Card success animation
          if (animate) {
            animate(
              card,
              { scale: [1, 1.02, 1], y: [0, -4, 0] },
              { duration: 0.6, easing: "ease-out" }
            );
          }
        }

        updateProgress();
        saveState();
      };

      // Complete buttons
      document.querySelectorAll('.complete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const phaseId = btn.dataset.phaseId;
          const exerciseId = btn.dataset.exerciseId;
          toggleExerciseCompletion(phaseId, exerciseId);
        });
      });

      // Exercise cards - hacer clic en la tarjeta para completar
      document.querySelectorAll('.exercise-card').forEach(card => {
        card.addEventListener('click', (e) => {
          // No activar si se hace clic en elementos interactivos
          if (
            e.target.closest('.info-btn') ||
            e.target.closest('.timer-container') ||
            e.target.closest('.sets-counter') ||
            e.target.closest('.complete-btn')
          ) {
            return;
          }

          const phaseId = card.dataset.phaseId;
          const exerciseId = card.dataset.exerciseId;
          toggleExerciseCompletion(phaseId, exerciseId);
        });
      });

      // Timer buttons
      document.querySelectorAll('.start-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          const duration = parseInt(btn.dataset.duration || '0');
          startTimer(card, duration);
        });
      });

      document.querySelectorAll('.pause-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          pauseTimer(card);
        });
      });

      document.querySelectorAll('.play-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          resumeTimer(card);
        });
      });

      document.querySelectorAll('.reset-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          resetTimer(card);
        });
      });

      // Sets counter buttons
      document.querySelectorAll('.increment-set-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const card = btn.closest('.exercise-card');
          const counter = card.querySelector('.sets-counter');
          const currentSetSpan = counter.querySelector('.current-set');
          const totalSets = parseInt(btn.dataset.totalSets || '0');
          const phaseId = btn.dataset.phaseId;
          const exerciseId = btn.dataset.exerciseId;

          let currentSet = parseInt(currentSetSpan.textContent || '0');
          if (currentSet < totalSets) {
            currentSet++;
            currentSetSpan.textContent = currentSet;

            // Animate counter increment
            if (animate) {
              animate(
                currentSetSpan,
                { scale: [1, 1.4, 1], rotate: [0, 5, 0] },
                { duration: 0.5, easing: "ease-out" }
              );

              // Pulse button feedback
              animate(btn, { scale: [1, 0.95, 1] }, { duration: 0.3 });
            }

            // Visual feedback when all sets are completed
            if (currentSet === totalSets) {
              // Celebration animation for completing all sets
              if (animate) {
                animate(
                  counter,
                  { scale: [1, 1.05, 1], y: [0, -5, 0] },
                  { duration: 0.6, easing: "ease-out" }
                );
              }

              counter.classList.add('ring-2', 'ring-green-400', 'shadow-lg');
              btn.disabled = true;
              btn.classList.add('opacity-50', 'cursor-not-allowed');

              // Auto-complete the exercise
              setTimeout(() => toggleExerciseCompletion(phaseId, exerciseId), 300);
            }
          }
        });
      });

      document.querySelectorAll('.reset-set-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();

          // Block reset if session is locked
          if (sessionLocked) {
            const card = btn.closest('.exercise-card');
            if (animate) {
              animate(
                card,
                { x: [-5, 5, -5, 5, 0] },
                { duration: 0.4, easing: "ease-out" }
              );
            }
            return;
          }

          const card = btn.closest('.exercise-card');
          const counter = card.querySelector('.sets-counter');
          const currentSetSpan = counter.querySelector('.current-set');
          const incrementBtn = card.querySelector('.increment-set-btn');
          const phaseId = btn.dataset.phaseId;
          const exerciseId = btn.dataset.exerciseId;
          const key = `${phaseId}-${exerciseId}`;

          // Reset animation
          if (animate) {
            animate(
              currentSetSpan,
              { scale: [1, 0.5, 1], rotate: [0, -180, -360] },
              { duration: 0.5, easing: "ease-out" }
            );
          }

          currentSetSpan.textContent = '0';
          counter.classList.remove('ring-2', 'ring-green-400', 'shadow-lg');

          if (incrementBtn) {
            incrementBtn.disabled = false;
            incrementBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          }

          // Uncomplete the exercise if it was completed
          if (completedExercises.has(key)) {
            toggleExerciseCompletion(phaseId, exerciseId);
          }
        });
      });

      // Info buttons
      document.querySelectorAll('.info-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();

          // Bounce animation on click
          if (animate) {
            animate(
              btn,
              { scale: [1, 0.9, 1.1, 1], rotate: [0, -10, 10, 0] },
              { duration: 0.5, easing: "ease-out" }
            );
          }

          const exerciseId = btn.dataset.exerciseId;
          const details = exerciseDetails[exerciseId];

          if (details) {
            // Find exercise name and video URL
            let exerciseName = '';
            let videoUrl = '';
            for (const phase of Object.values(workout)) {
              const exercise = phase.exercises.find(ex => ex.id === exerciseId);
              if (exercise) {
                exerciseName = exercise.name;
                videoUrl = exercise.videoUrl || '';
                break;
              }
            }

            document.getElementById('modal-title').textContent = exerciseName;
            document.getElementById('modal-muscles').textContent = details.muscles;
            document.getElementById('modal-why').textContent = details.why;
            document.getElementById('modal-evidence').textContent = details.evidence;
            document.getElementById('modal-tips').textContent = details.tips;

            // Handle video display
            const videoContainer = document.getElementById('modal-video-container');
            const videoIframe = document.getElementById('modal-video-iframe');

            if (videoUrl) {
              // Convert YouTube watch URL to embed URL
              const videoId = videoUrl.includes('watch?v=')
                ? videoUrl.split('watch?v=')[1].split('&')[0]
                : videoUrl.split('/').pop();
              const embedUrl = `https://www.youtube.com/embed/${videoId}`;

              videoIframe.src = embedUrl;
              videoContainer.classList.remove('hidden');
            } else {
              videoContainer.classList.add('hidden');
              videoIframe.src = '';
            }

            openModal('exercise-info-modal');
          }
        });
      });

      // Close info modal
      const closeInfoModal = () => {
        closeModal('exercise-info-modal', () => {
          // Stop video playback by clearing the iframe src
          document.getElementById('modal-video-iframe').src = '';
        });
      };

      document.getElementById('close-info-modal').addEventListener('click', closeInfoModal);
      document.getElementById('close-info-modal-btn').addEventListener('click', closeInfoModal);

      // References modal
      document.getElementById('show-references-btn').addEventListener('click', () => {
        openModal('references-modal');
      });

      document.getElementById('close-references-modal').addEventListener('click', () => {
        closeModal('references-modal');
      });

      document.getElementById('close-references-modal-btn').addEventListener('click', () => {
        closeModal('references-modal');
      });

      // Onboarding modal
      document.getElementById('show-onboarding-btn').addEventListener('click', () => {
        openModal('onboarding-modal');
      });

      const closeOnboardingModal = () => {
        closeModal('onboarding-modal', () => {
          markOnboardingAsSeen();
        });
      };

      document.getElementById('close-onboarding-modal').addEventListener('click', closeOnboardingModal);
      document.getElementById('close-onboarding-modal-btn').addEventListener('click', closeOnboardingModal);

      // Close modals on backdrop click
      document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            const callback = modal.id === 'onboarding-modal' ? markOnboardingAsSeen : undefined;
            closeModal(modal.id, callback);
          }
        });
      });
    });
  </script>
</BaseLayout>
