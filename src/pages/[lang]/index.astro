---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorkout, getExerciseDetails, getReferences } from '../../data/index';
import { useTranslations, type Language, languages } from '../../i18n/utils';

// Components
import Logo from '../../components/Logo.astro';

// Island Components
import ExerciseTimer from '../../components/islands/ExerciseTimer.tsx';
import SetCounter from '../../components/islands/SetCounter.tsx';
import LevelSelector from '../../components/islands/LevelSelector.tsx';
import LevelInfo from '../../components/islands/LevelInfo.tsx';

// Icons
import Play from '../../components/icons/Play.astro';
import Pause from '../../components/icons/Pause.astro';
import RotateCcw from '../../components/icons/RotateCcw.astro';
import Check from '../../components/icons/Check.astro';
import ChevronDown from '../../components/icons/ChevronDown.astro';
import ChevronUp from '../../components/icons/ChevronUp.astro';
import Info from '../../components/icons/Info.astro';
import BookOpen from '../../components/icons/BookOpen.astro';
import X from '../../components/icons/X.astro';
import HelpCircle from '../../components/icons/HelpCircle.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

// Load localized data
const workout = getWorkout(lang);
const exerciseDetails = getExerciseDetails(lang);
const references = getReferences(lang);
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
>
  <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 dark:from-gray-900 dark:to-gray-800">
    <!-- Progress Logo (Sticky) -->
    <div class="sticky top-0 z-10 bg-white/95 dark:bg-gray-800/95 backdrop-blur-sm shadow-md mb-4">
      <div class="relative py-4 sm:py-5">
        <div class="max-w-4xl mx-auto px-4">
          <div class="flex items-center justify-center">
            <!-- Logo con efecto de llenado -->
            <Logo id="progress-logo" showProgress={true} size="large" />
          </div>
        </div>

        <!-- Barra de progreso por fases en el borde inferior (OCULTA - Descomentar para restaurar) -->
        <!-- <div class="absolute bottom-0 left-0 right-0 h-1 grid grid-cols-4 bg-slate-200">
          <div class="phase-progress-bar relative bg-slate-200 overflow-hidden" data-phase="fase1">
            <div class="absolute inset-0 transition-transform duration-500 origin-left" style="background-color: #4f46e5; transform: scaleX(0);"></div>
          </div>
          <div class="phase-progress-bar relative bg-slate-200 overflow-hidden" data-phase="fase2">
            <div class="absolute inset-0 transition-transform duration-500 origin-left" style="background-color: #14b8a6; transform: scaleX(0);"></div>
          </div>
          <div class="phase-progress-bar relative bg-slate-200 overflow-hidden" data-phase="fase3">
            <div class="absolute inset-0 transition-transform duration-500 origin-left" style="background-color: #f97316; transform: scaleX(0);"></div>
          </div>
          <div class="phase-progress-bar relative bg-slate-200 overflow-hidden" data-phase="fase4">
            <div class="absolute inset-0 transition-transform duration-500 origin-left" style="background-color: #ec4899; transform: scaleX(0);"></div>
          </div>
        </div> -->
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4">

      <!-- Phases -->
      {Object.entries(workout).map(([phaseId, phase]) => (
        <div class="mb-4 phase-container" data-phase-id={phaseId}>
          <div class="sticky top-[100px] z-[5] mb-2">
            <button
              class="phase-toggle w-full border-2 rounded-lg pt-3 sm:pt-4 px-3 sm:px-4 pb-1 hover:shadow-xl transition-all shadow-lg backdrop-blur-md relative"
              style={`background: linear-gradient(135deg, white 0%, ${phase.colorLightHex} 100%); border-color: ${phase.colorBorderHex};`}
              data-phase-id={phaseId}
            >
              <!-- Phase Number Badge -->
              <div
                class="absolute top-2 right-2 sm:top-3 sm:right-3 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-md font-bold text-xs sm:text-sm shadow-sm"
                style={`background-color: ${phase.colorPrimaryHex}; color: white;`}
              >
                #{phaseId.replace('fase', '')}
              </div>

              <div>
                <div class="text-left mb-1">
                  <h2 class="text-lg sm:text-2xl font-extrabold leading-tight mb-1 pr-10 sm:pr-12" style={`color: ${phase.colorPrimaryHex};`}>
                    {phase.name.includes(':') ? phase.name.split(':')[1].trim() : phase.name}
                  </h2>
                  <p class="phase-description text-xs sm:text-sm text-slate-600/90 dark:text-gray-300/90 leading-relaxed max-w-prose mb-1 pr-10 sm:pr-12">{phase.description}</p>
                  <div class="flex justify-end">
                    <span class="text-xs text-slate-500 dark:text-gray-400 font-medium whitespace-nowrap">{phase.time}</span>
                  </div>
                </div>

                <!-- Chevron centrado abajo -->
                <div class="flex justify-center pb-1 -mb-1">
                  <div class="relative w-5 h-5 opacity-60">
                    <div class="chevron-down absolute inset-0 opacity-100 transition-opacity duration-200" style={`color: ${phase.colorPrimaryHex};`}>
                      <ChevronDown size={20} />
                    </div>
                    <div class="chevron-up absolute inset-0 opacity-0 transition-opacity duration-200" style={`color: ${phase.colorPrimaryHex};`}>
                      <ChevronUp size={20} />
                    </div>
                  </div>
                </div>
              </div>
            </button>
          </div>

          <div class="phase-content hidden p-3 sm:p-4 mt-2 space-y-3">
            {phase.exercises.map(exercise => (
                <div
                  class="exercise-card border-2 border-slate-200 dark:border-gray-700 bg-white dark:bg-gray-800 rounded-lg p-3 sm:p-4 transition-all cursor-pointer hover:shadow-lg"
                  data-phase-id={phaseId}
                  data-exercise-id={exercise.id}
                  data-duration={exercise.duration}
                >
                  <div class="flex justify-between items-start gap-2 mb-2">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-start gap-2 mb-1">
                        <h3 class="font-bold text-lg sm:text-xl text-slate-800 dark:text-gray-100 flex-1 min-w-0 break-words">{exercise.name}</h3>
                        <button
                          class="info-btn p-1.5 sm:p-2 border rounded-full transition-all flex-shrink-0 shadow-sm hover:shadow-md"
                          style={`background-color: ${phase.colorLightHex}; border-color: ${phase.colorBorderHex};`}
                          data-exercise-id={exercise.id}
                          title={t('common.moreInfo')}
                        >
                          <Info size={18} style={`color: ${phase.colorPrimaryHex};`} />
                        </button>
                      </div>
                      <p class="text-sm sm:text-base font-semibold text-slate-700 dark:text-gray-300 mb-2">{exercise.reps}</p>
                      <p class="text-xs sm:text-sm text-slate-700 dark:text-gray-300">{exercise.instructions}</p>

                      {exercise.levels && (
                        <LevelInfo
                          client:visible
                          levels={exercise.levels}
                          colorHex={phase.colorPrimaryHex}
                          colorLightHex={phase.colorLightHex}
                          colorBorderHex={phase.colorBorderHex}
                          labels={{
                            beginner: t('levels.beginner'),
                            intermediate: t('levels.intermediate'),
                            advanced: t('levels.advanced')
                          }}
                        />
                      )}
                    </div>

                    <button
                      class="complete-btn ml-2 sm:ml-4 p-1.5 sm:p-2 rounded-full transition-all bg-slate-200 text-slate-500 hover:bg-slate-300 flex-shrink-0"
                      data-phase-id={phaseId}
                      data-exercise-id={exercise.id}
                    >
                      <Check size={18} />
                    </button>
                  </div>

                  {exercise.duration > 0 && (
                    <ExerciseTimer
                      client:visible
                      exerciseId={exercise.id}
                      phaseId={phaseId}
                      duration={exercise.duration}
                      colorHex={phase.colorPrimaryHex}
                      colorLightHex={phase.colorLightHex}
                      colorBorderHex={phase.colorBorderHex}
                      startLabel={t('common.start')}
                    />
                  )}

                  {exercise.sets && exercise.sets > 0 && (
                    <SetCounter
                      client:visible
                      exerciseId={exercise.id}
                      phaseId={phaseId}
                      totalSets={exercise.sets}
                      colorHex={phase.colorPrimaryHex}
                      colorLightHex={phase.colorLightHex}
                      colorBorderHex={phase.colorBorderHex}
                      completedLabel={t('timer.completed')}
                      addSetLabel={t('timer.addSet')}
                    />
                  )}
                </div>
            ))}
          </div>
        </div>
      ))}

      <!-- Completion Celebration Section (shown only when all exercises are done) -->
      <div id="completion-section" class="hidden mb-8 mt-8">
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-300 rounded-xl p-6 sm:p-8 shadow-xl">
          <!-- Confetti background decoration -->
          <div class="text-center mb-6">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-green-700 mb-2">
              {t('completion.title')}
            </h2>
            <p class="text-lg sm:text-xl text-green-600 font-semibold mb-1">
              {t('completion.subtitle')}
            </p>
            <p class="text-sm sm:text-base text-slate-700">
              {t('completion.message')}
            </p>
          </div>

          <!-- Stats Grid -->
          <div class="mb-6">
            <h3 class="text-xl sm:text-2xl font-bold text-slate-800 mb-4 text-center">
              {t('completion.statsTitle')}
            </h3>
            <div class="grid grid-cols-2 gap-3 sm:gap-4 mb-4">
              <!-- Days This Week -->
              <div class="bg-white rounded-lg p-4 border-2 border-blue-200 shadow-md">
                <div class="text-center">
                  <div class="text-3xl sm:text-4xl font-bold text-blue-600 mb-1">3</div>
                  <div class="text-xs sm:text-sm text-slate-600 font-medium">
                    {t('completion.daysThisWeek')}
                  </div>
                </div>
              </div>

              <!-- Current Streak -->
              <div class="bg-white rounded-lg p-4 border-2 border-orange-200 shadow-md">
                <div class="text-center">
                  <div class="text-3xl sm:text-4xl font-bold text-orange-600 mb-1">5</div>
                  <div class="text-xs sm:text-sm text-slate-600 font-medium">
                    {t('completion.currentStreak')}
                  </div>
                  <div class="text-xs text-slate-500">{t('completion.days')}</div>
                </div>
              </div>

              <!-- Longest Streak -->
              <div class="bg-white rounded-lg p-4 border-2 border-purple-200 shadow-md">
                <div class="text-center">
                  <div class="text-3xl sm:text-4xl font-bold text-purple-600 mb-1">12</div>
                  <div class="text-xs sm:text-sm text-slate-600 font-medium">
                    {t('completion.longestStreak')}
                  </div>
                  <div class="text-xs text-slate-500">{t('completion.days')}</div>
                </div>
              </div>

              <!-- Total Sessions -->
              <div class="bg-white rounded-lg p-4 border-2 border-pink-200 shadow-md">
                <div class="text-center">
                  <div class="text-3xl sm:text-4xl font-bold text-pink-600 mb-1">24</div>
                  <div class="text-xs sm:text-sm text-slate-600 font-medium">
                    {t('completion.totalSessions')}
                  </div>
                  <div class="text-xs text-slate-500">{t('completion.sessions')}</div>
                </div>
              </div>
            </div>

            <!-- Placeholder Notice -->
            <div class="bg-yellow-50 border-2 border-yellow-200 rounded-lg p-4 mb-4">
              <p class="text-xs sm:text-sm text-yellow-800 text-center leading-relaxed">
                {t('completion.placeholderNote')}
              </p>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-3">
            <button
              id="reset-session-btn"
              class="flex-1 px-4 py-3 bg-green-500 hover:bg-green-600 text-white rounded-lg font-semibold text-sm sm:text-base transition-all shadow-md hover:shadow-lg"
            >
              {t('completion.resetButton')}
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Exercise Info Modal -->
    <div id="exercise-info-modal" class="modal fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-3 sm:p-4 z-50 hidden">
      <div class="bg-white dark:bg-gray-800 rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto p-4 sm:p-6">
        <div class="flex justify-between items-start gap-2 mb-4">
          <h2 id="modal-title" class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-gray-100 flex-1 min-w-0"></h2>
          <button id="close-info-modal" class="p-1.5 sm:p-2 hover:bg-slate-100 dark:hover:bg-gray-700 rounded-full transition-all flex-shrink-0">
            <X size={20} />
          </button>
        </div>

        <!-- Video Container -->
        <div id="modal-video-container" class="mb-4 hidden">
          <div class="aspect-video rounded-lg overflow-hidden shadow-md bg-slate-100 flex items-center justify-center">
            <iframe
              id="modal-video-iframe"
              width="100%"
              height="100%"
              src=""
              title={t('modal.exerciseInfo.videoTutorial')}
              frameborder="0"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="w-full h-full"
            ></iframe>
          </div>
        </div>

        <div class="space-y-3 sm:space-y-4">
          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 dark:text-gray-300 mb-1 flex items-center gap-2">
              🎯 {t('modal.exerciseInfo.muscles')}
            </h3>
            <p id="modal-muscles" class="text-xs sm:text-sm text-slate-600 dark:text-gray-400"></p>
          </div>

          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 dark:text-gray-300 mb-1 flex items-center gap-2">
              ❓ {t('modal.exerciseInfo.why')}
            </h3>
            <p id="modal-why" class="text-xs sm:text-sm text-slate-600 dark:text-gray-400"></p>
          </div>

          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 dark:text-gray-300 mb-1 flex items-center gap-2">
              🔬 {t('modal.exerciseInfo.evidence')}
            </h3>
            <p id="modal-evidence" class="text-xs sm:text-sm text-slate-600 dark:text-gray-400"></p>
          </div>

          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 dark:text-gray-300 mb-1 flex items-center gap-2">
              💡 {t('modal.exerciseInfo.tips')}
            </h3>
            <p id="modal-tips" class="text-xs sm:text-sm text-slate-600 dark:text-gray-400"></p>
          </div>
        </div>

        <button
          id="close-info-modal-btn"
          class="mt-4 sm:mt-6 w-full px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all font-medium text-sm sm:text-base"
        >
          {t('common.understood')}
        </button>
      </div>
    </div>

    <!-- References Modal -->
    <div id="references-modal" class="modal fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-3 sm:p-4 z-[60] hidden">
      <div class="bg-white dark:bg-gray-800 rounded-lg max-w-4xl w-full max-h-[90vh] overflow-y-auto p-4 sm:p-6">
        <div class="flex justify-between items-start gap-2 mb-4">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-gray-100 flex-1 min-w-0">{t('modal.references.title')}</h2>
          <button id="close-references-modal" class="p-1.5 sm:p-2 hover:bg-slate-100 dark:hover:bg-gray-700 rounded-full transition-all flex-shrink-0">
            <X size={20} />
          </button>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-gray-400 mb-4 sm:mb-6">
          {t('modal.references.description')}
        </p>

        <div class="space-y-4 sm:space-y-6">
          {references.map((section) => (
            <div>
              <h3 class="text-base sm:text-lg font-bold text-slate-800 dark:text-gray-200 mb-2 sm:mb-3 pb-2 border-b-2 border-slate-200 dark:border-gray-700">
                {section.category}
              </h3>
              <ul class="space-y-2 sm:space-y-3">
                {section.studies.map((study) => (
                  <li class="text-xs sm:text-sm text-slate-700 dark:text-gray-300 pl-3 sm:pl-4 border-l-2 border-blue-300 dark:border-blue-600 leading-relaxed">
                    {study}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="mt-4 sm:mt-6 p-3 sm:p-4 bg-blue-50 rounded-lg">
          <h3 class="font-bold text-sm sm:text-base text-blue-900 mb-2">📚 {t('modal.references.accessTitle')}</h3>
          <p class="text-xs sm:text-sm text-blue-800">
            {t('modal.references.accessDescription')}
          </p>
        </div>

        <button
          id="close-references-modal-btn"
          class="mt-4 sm:mt-6 w-full px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all font-medium text-sm sm:text-base"
        >
          {t('common.close')}
        </button>
      </div>
    </div>

    <!-- Onboarding Modal -->
    <div id="onboarding-modal" class="modal fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-3 sm:p-4 z-50 hidden">
      <div class="bg-white dark:bg-gray-800 rounded-lg max-w-2xl w-full max-h-[90vh] overflow-hidden flex flex-col relative">
        <!-- Header del modal con logo - STICKY -->
        <div class="flex-shrink-0 bg-white dark:bg-gray-800 px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between gap-3 border-b border-slate-200 dark:border-gray-700 rounded-t-lg">
          <Logo id="onboarding-logo" showProgress={true} size="medium" />
          <button id="close-onboarding-modal" class="p-1.5 sm:p-2 hover:bg-slate-100 dark:hover:bg-gray-700 rounded-full transition-all flex-shrink-0">
            <X size={20} />
          </button>
        </div>

        <!-- Contenido scrollable -->
        <div class="flex-1 overflow-y-auto px-4 sm:px-6 py-4">

        <!-- Descripción de la app - DISEÑO MEJORADO -->
        <div class="onboarding-section">
        <div class="mb-4 relative overflow-hidden rounded-xl border-2 border-blue-300 dark:border-blue-700 shadow-lg">
          <!-- Background gradient decorativo -->
          <div class="absolute inset-0 bg-gradient-to-br from-blue-100 via-indigo-50 to-purple-100 dark:from-blue-900/40 dark:via-indigo-900/30 dark:to-purple-900/40"></div>

          <!-- Elementos decorativos de fondo (círculos sutiles) -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-blue-200/30 dark:bg-blue-700/20 rounded-full -mr-16 -mt-16 blur-2xl"></div>
          <div class="absolute bottom-0 left-0 w-24 h-24 bg-indigo-200/30 dark:bg-indigo-700/20 rounded-full -ml-12 -mb-12 blur-2xl"></div>

          <!-- Contenido -->
          <div class="relative p-5 sm:p-6">
            <!-- Badge "25 min" -->
            <div class="inline-flex items-center gap-1.5 px-3 py-1 mb-3 bg-blue-500 text-white rounded-full text-xs font-bold shadow-md">
              <span>⏱️</span>
              <span>25 min</span>
            </div>

            <p class="text-base sm:text-lg text-slate-900 dark:text-gray-50 mb-3 font-bold leading-tight text-balance">
              {t('modal.onboarding.subtitle')}
            </p>

            <!-- Sistema de 4 fases con iconos -->
            <div class="mb-3 p-3 bg-white/60 dark:bg-gray-900/40 rounded-lg backdrop-blur-sm">
              <div class="grid grid-cols-4 gap-1.5 sm:gap-2">
                <div class="text-center p-2 bg-indigo-500/10 dark:bg-indigo-500/20 rounded-lg border border-indigo-300/50 dark:border-indigo-700/50">
                  <div class="text-lg sm:text-xl mb-0.5">🧘</div>
                  <div class="text-[10px] sm:text-xs font-bold text-indigo-700 dark:text-indigo-300 leading-tight">{lang === 'es' ? 'Inhibir' : 'Inhibit'}</div>
                </div>
                <div class="text-center p-2 bg-teal-500/10 dark:bg-teal-500/20 rounded-lg border border-teal-300/50 dark:border-teal-700/50">
                  <div class="text-lg sm:text-xl mb-0.5">🤸</div>
                  <div class="text-[10px] sm:text-xs font-bold text-teal-700 dark:text-teal-300 leading-tight">{lang === 'es' ? 'Alargar' : 'Lengthen'}</div>
                </div>
                <div class="text-center p-2 bg-orange-500/10 dark:bg-orange-500/20 rounded-lg border border-orange-300/50 dark:border-orange-700/50">
                  <div class="text-lg sm:text-xl mb-0.5">💪</div>
                  <div class="text-[10px] sm:text-xs font-bold text-orange-700 dark:text-orange-300 leading-tight">{lang === 'es' ? 'Activar' : 'Activate'}</div>
                </div>
                <div class="text-center p-2 bg-pink-500/10 dark:bg-pink-500/20 rounded-lg border border-pink-300/50 dark:border-pink-700/50">
                  <div class="text-lg sm:text-xl mb-0.5">🏃</div>
                  <div class="text-[10px] sm:text-xs font-bold text-pink-700 dark:text-pink-300 leading-tight">{lang === 'es' ? 'Integrar' : 'Integrate'}</div>
                </div>
              </div>
            </div>

            <!-- Badge de estudios -->
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/70 dark:bg-gray-800/70 backdrop-blur-sm border border-slate-300 dark:border-gray-600 rounded-lg">
              <span class="text-sm">📚</span>
              <span class="text-xs font-semibold text-slate-700 dark:text-gray-300">Basado en 30+ estudios peer-reviewed</span>
            </div>
          </div>
        </div>
        </div>

        <!-- Preferencias (nivel + idioma + modo oscuro) AGRUPADAS -->
        <div class="onboarding-section">
        <div class="mb-4 p-3 sm:p-4 bg-slate-50 dark:bg-gray-900/50 rounded-lg border border-slate-200 dark:border-gray-700">
          <h3 class="text-sm sm:text-base font-bold text-slate-800 dark:text-gray-100 mb-3 flex items-center gap-2">
            ⚙️ {t('preferences.title')}
          </h3>

          <!-- Level Selector con descripción incluida -->
          <div class="mb-3">
            <span class="text-xs sm:text-sm text-slate-700 dark:text-gray-300 font-semibold block mb-3">🎚️ {t('levels.selectLevel')}</span>
            <LevelSelector
              client:visible
              levels={[
                { key: 'principiante', label: t('levels.beginner'), desc: t('levels.beginnerDescription'), icon: '🌱', gradient: 'from-green-50 to-emerald-50', border: 'border-green-400', ring: 'ring-green-400', text: 'text-green-700', textLight: 'text-green-600' },
                { key: 'intermedio', label: t('levels.intermediate'), desc: t('levels.intermediateDescription'), icon: '🔥', gradient: 'from-orange-50 to-amber-50', border: 'border-orange-400', ring: 'ring-orange-400', text: 'text-orange-700', textLight: 'text-orange-600' },
                { key: 'avanzado', label: t('levels.advanced'), desc: t('levels.advancedDescription'), icon: '⚡', gradient: 'from-purple-50 to-violet-50', border: 'border-purple-400', ring: 'ring-purple-400', text: 'text-purple-700', textLight: 'text-purple-600' }
              ]}
            />
            <p class="text-xs text-slate-600 dark:text-gray-400 italic">
              {t('levels.description')}
            </p>
          </div>

          <!-- Language Selector -->
          <div class="mb-3">
