---
import BaseLayout from '../layouts/BaseLayout.astro';
import { workout } from '../data/workout';
import { exerciseDetails } from '../data/exerciseDetails';
import { references } from '../data/references';

// Icons
import Play from '../components/icons/Play.astro';
import Pause from '../components/icons/Pause.astro';
import RotateCcw from '../components/icons/RotateCcw.astro';
import Check from '../components/icons/Check.astro';
import ChevronDown from '../components/icons/ChevronDown.astro';
import ChevronUp from '../components/icons/ChevronUp.astro';
import Info from '../components/icons/Info.astro';
import BookOpen from '../components/icons/BookOpen.astro';
import X from '../components/icons/X.astro';

const totalExercises = Object.values(workout).reduce((sum, phase) => sum + phase.exercises.length, 0);
---

<BaseLayout>
  <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 pb-4">
    <!-- Header (non-sticky) -->
    <div class="max-w-4xl mx-auto px-4">
      <div class="bg-white rounded-lg shadow-lg p-4 sm:p-6 mb-4">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-800 mb-2">
          🧑‍💻 Desatrófiate
        </h1>
        <p class="text-sm sm:text-base text-slate-600 mb-4">
          25 minutos para contrarrestar las horas de ordenador y rescatar tu postura | Basada en 30+ estudios
        </p>

        <!-- Level Selector -->
        <div class="mb-4">
          <span class="text-xs sm:text-sm text-slate-600 block mb-2">Nivel:</span>
          <div class="grid grid-cols-3 gap-2">
            {['principiante', 'intermedio', 'avanzado'].map(l => (
              <button
                data-level={l}
                class={`level-btn px-2 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all whitespace-nowrap ${
                  l === 'intermedio'
                    ? 'bg-blue-500 text-white shadow-md'
                    : 'bg-slate-200 text-slate-700 hover:bg-slate-300'
                }`}
              >
                <span class="hidden sm:inline">{l.charAt(0).toUpperCase() + l.slice(1)}</span>
                <span class="sm:hidden">{l === 'principiante' ? 'Básico' : l === 'intermedio' ? 'Medio' : 'Avanz.'}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- References Button -->
        <button
          id="show-references-btn"
          class="w-full px-3 sm:px-4 py-3 bg-indigo-100 hover:bg-indigo-200 text-indigo-800 rounded-lg font-medium transition-all flex items-center justify-center gap-2 text-sm sm:text-base"
        >
          <BookOpen size={18} class="flex-shrink-0" />
          <span class="hidden sm:inline">Ver Referencias Científicas (30+ estudios)</span>
          <span class="sm:hidden">Referencias (30+ estudios)</span>
        </button>
      </div>
    </div>

    <!-- Progress Bar (Sticky) -->
    <div class="sticky top-0 z-20 bg-white/95 backdrop-blur-sm shadow-md py-3 mb-4">
      <div class="max-w-4xl mx-auto px-4">
        <div class="flex items-center justify-between text-xs sm:text-sm text-slate-600 mb-2">
          <span class="font-medium">Progreso</span>
          <span id="progress-text" class="font-semibold">0 / {totalExercises}</span>
        </div>
        <div class="w-full bg-slate-200 rounded-full h-2 flex overflow-hidden">
          <div id="progress-fase1" class="bg-blue-500 h-2 transition-all duration-300 first:rounded-l-full" style="width: 0%"></div>
          <div id="progress-fase2" class="bg-green-500 h-2 transition-all duration-300" style="width: 0%"></div>
          <div id="progress-fase3" class="bg-orange-500 h-2 transition-all duration-300" style="width: 0%"></div>
          <div id="progress-fase4" class="bg-purple-500 h-2 transition-all duration-300 last:rounded-r-full" style="width: 0%"></div>
        </div>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4">

      <!-- Phases -->
      {Object.entries(workout).map(([phaseId, phase]) => (
        <div class="mb-4 phase-container" data-phase-id={phaseId}>
          <div class="sticky top-[70px] z-10 mb-2">
            <button
              class="phase-toggle w-full border-2 rounded-lg p-3 sm:p-4 hover:shadow-md transition-all shadow-lg"
              class:list={[phase.color]}
              data-phase-id={phaseId}
            >
              <div class="flex justify-between items-center gap-2">
                <div class="text-left flex-1 min-w-0">
                  <h2 class="text-lg sm:text-xl font-bold text-slate-800 truncate">{phase.name}</h2>
                  <p class="text-xs sm:text-sm text-slate-600 line-clamp-2">{phase.time} • {phase.description}</p>
                </div>
                <div class="chevron-down flex-shrink-0">
                  <ChevronDown size={20} />
                </div>
                <div class="chevron-up hidden flex-shrink-0">
                  <ChevronUp size={20} />
                </div>
              </div>
            </button>
          </div>

          <div class="phase-content hidden bg-white rounded-b-lg shadow-lg p-3 sm:p-4 mt-2 space-y-3">
            {phase.exercises.map(exercise => (
                <div
                  class="exercise-card border-2 border-slate-200 bg-white rounded-lg p-3 sm:p-4 transition-all cursor-pointer hover:shadow-lg"
                  data-phase-id={phaseId}
                  data-exercise-id={exercise.id}
                  data-duration={exercise.duration}
                >
                  <div class="flex justify-between items-start gap-2 mb-2">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        <h3 class="font-bold text-sm sm:text-base text-slate-800 flex-1 min-w-0 break-words">{exercise.name}</h3>
                        <button
                          class="info-btn p-1 hover:bg-blue-100 rounded-full transition-all flex-shrink-0"
                          data-exercise-id={exercise.id}
                          title="Más información"
                        >
                          <Info size={16} class="text-blue-600" />
                        </button>
                      </div>
                      <p class="text-xs sm:text-sm text-slate-600 mb-2">{exercise.reps}</p>
                      <p class="text-xs sm:text-sm text-slate-700">{exercise.instructions}</p>

                      {exercise.levels && (
                        <div class="level-info mt-2 p-2 bg-blue-100 rounded text-xs sm:text-sm" data-levels={JSON.stringify(exercise.levels)}>
                          <span class="font-semibold text-blue-800">Intermedio:</span>{' '}
                          <span class="text-blue-900 level-text">{exercise.levels.intermedio}</span>
                        </div>
                      )}
                    </div>

                    <button
                      class="complete-btn ml-2 sm:ml-4 p-1.5 sm:p-2 rounded-full transition-all bg-slate-200 text-slate-500 hover:bg-slate-300 flex-shrink-0"
                      data-phase-id={phaseId}
                      data-exercise-id={exercise.id}
                    >
                      <Check size={18} />
                    </button>
                  </div>

                  {exercise.duration > 0 && (
                    <div class="timer-container mt-3 p-2 sm:p-3 bg-slate-100 rounded-lg">
                      <div class="flex items-center justify-between gap-2">
                        <div class="timer-display text-xl sm:text-2xl font-bold text-slate-800">
                          {Math.floor(exercise.duration / 60)}:{(exercise.duration % 60).toString().padStart(2, '0')}
                        </div>
                        <div class="timer-controls flex gap-1.5 sm:gap-2">
                          <button
                            class="start-timer-btn px-3 sm:px-4 py-1.5 sm:py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-all font-medium text-xs sm:text-sm"
                            data-phase-id={phaseId}
                            data-exercise-id={exercise.id}
                            data-duration={exercise.duration}
                          >
                            Iniciar
                          </button>
                          <button
                            class="pause-timer-btn hidden p-1.5 sm:p-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all"
                          >
                            <Pause size={18} />
                          </button>
                          <button
                            class="play-timer-btn hidden p-1.5 sm:p-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all"
                          >
                            <Play size={18} />
                          </button>
                          <button
                            class="reset-timer-btn hidden p-1.5 sm:p-2 bg-slate-500 text-white rounded-lg hover:bg-slate-600 transition-all"
                            data-duration={exercise.duration}
                          >
                            <RotateCcw size={18} />
                          </button>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
            ))}
          </div>
        </div>
      ))}

      <!-- Tips -->
      <div class="bg-amber-50 border-2 border-amber-200 rounded-lg p-3 sm:p-4 mt-6 mb-4">
        <h3 class="font-bold text-sm sm:text-base text-amber-900 mb-2">💡 Consejos clave</h3>
        <ul class="text-xs sm:text-sm text-amber-800 space-y-1.5 sm:space-y-1">
          <li>• <strong>Secuencia no negociable:</strong> Inhibir → Alargar → Activar → Integrar</li>
          <li>• <strong>Frecuencia:</strong> 3 sesiones/semana + micropausas diarias</li>
          <li>• <strong>Bird dog:</strong> El ejercicio #1 para core según estudios</li>
          <li>• <strong>12 semanas mínimo</strong> para cambios estructurales duraderos</li>
          <li>• <strong>Detén si hay:</strong> Dolor agudo, adormecimiento, mareos</li>
        </ul>
      </div>

      <!-- Reset Button -->
      <div class="text-center mb-6">
        <button
          id="reset-progress-btn"
          class="text-xs sm:text-sm px-4 py-2 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-600 transition-all"
        >
          🔄 Resetear todo el progreso
        </button>
      </div>
    </div>

    <!-- Exercise Info Modal -->
    <div id="exercise-info-modal" class="modal fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-3 sm:p-4 z-50 hidden">
      <div class="bg-white rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto p-4 sm:p-6">
        <div class="flex justify-between items-start gap-2 mb-4">
          <h2 id="modal-title" class="text-xl sm:text-2xl font-bold text-slate-800 flex-1 min-w-0"></h2>
          <button id="close-info-modal" class="p-1.5 sm:p-2 hover:bg-slate-100 rounded-full transition-all flex-shrink-0">
            <X size={20} />
          </button>
        </div>

        <!-- Video Container -->
        <div id="modal-video-container" class="mb-4 hidden">
          <div class="aspect-video rounded-lg overflow-hidden shadow-md bg-slate-100 flex items-center justify-center">
            <iframe
              id="modal-video-iframe"
              width="100%"
              height="100%"
              src=""
              title="Video tutorial del ejercicio"
              frameborder="0"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="w-full h-full"
            ></iframe>
          </div>
        </div>

        <div class="space-y-3 sm:space-y-4">
          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 mb-1 flex items-center gap-2">
              🎯 Músculos trabajados
            </h3>
            <p id="modal-muscles" class="text-xs sm:text-sm text-slate-600"></p>
          </div>

          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 mb-1 flex items-center gap-2">
              ❓ Por qué es importante
            </h3>
            <p id="modal-why" class="text-xs sm:text-sm text-slate-600"></p>
          </div>

          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 mb-1 flex items-center gap-2">
              🔬 Evidencia científica
            </h3>
            <p id="modal-evidence" class="text-xs sm:text-sm text-slate-600"></p>
          </div>

          <div>
            <h3 class="font-bold text-sm sm:text-base text-slate-700 mb-1 flex items-center gap-2">
              💡 Consejos técnicos
            </h3>
            <p id="modal-tips" class="text-xs sm:text-sm text-slate-600"></p>
          </div>
        </div>

        <button
          id="close-info-modal-btn"
          class="mt-4 sm:mt-6 w-full px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all font-medium text-sm sm:text-base"
        >
          Entendido
        </button>
      </div>
    </div>

    <!-- References Modal -->
    <div id="references-modal" class="modal fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-3 sm:p-4 z-50 hidden">
      <div class="bg-white rounded-lg max-w-4xl w-full max-h-[90vh] overflow-y-auto p-4 sm:p-6">
        <div class="flex justify-between items-start gap-2 mb-4">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-800 flex-1 min-w-0">Referencias Científicas</h2>
          <button id="close-references-modal" class="p-1.5 sm:p-2 hover:bg-slate-100 rounded-full transition-all flex-shrink-0">
            <X size={20} />
          </button>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 mb-4 sm:mb-6">
          Esta rutina se basa en más de 30 estudios peer-reviewed publicados entre 2015-2025,
          incluyendo revisiones sistemáticas, metaanálisis, ensayos controlados aleatorizados (RCTs)
          y estudios con electromiografía (EMG) y ultrasonido.
        </p>

        <div class="space-y-4 sm:space-y-6">
          {references.map((section) => (
            <div>
              <h3 class="text-base sm:text-lg font-bold text-slate-800 mb-2 sm:mb-3 pb-2 border-b-2 border-slate-200">
                {section.category}
              </h3>
              <ul class="space-y-2 sm:space-y-3">
                {section.studies.map((study) => (
                  <li class="text-xs sm:text-sm text-slate-700 pl-3 sm:pl-4 border-l-2 border-blue-300 leading-relaxed">
                    {study}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="mt-4 sm:mt-6 p-3 sm:p-4 bg-blue-50 rounded-lg">
          <h3 class="font-bold text-sm sm:text-base text-blue-900 mb-2">📚 Cómo acceder a los estudios</h3>
          <p class="text-xs sm:text-sm text-blue-800">
            La mayoría de estos estudios están disponibles gratuitamente en PubMed Central (PMC),
            BMC journals, y otras bases de datos de acceso abierto. Busca los códigos PMC o DOI
            en Google Scholar o PubMed para acceder directamente.
          </p>
        </div>

        <button
          id="close-references-modal-btn"
          class="mt-4 sm:mt-6 w-full px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all font-medium text-sm sm:text-base"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ exerciseDetails, workout }}>
    // App State
    let currentLevel = 'intermedio';
    let completedExercises = new Set();
    let activeTimer = null;
    let timerInterval = null;

    // Load state from localStorage
    const loadState = () => {
      const saved = localStorage.getItem('desatrofiate-progress');
      if (saved) {
        try {
          const data = JSON.parse(saved);
          completedExercises = new Set(data.completed || []);
          currentLevel = data.level || 'intermedio';

          // Update UI after DOM is fully painted
          requestAnimationFrame(() => {
            completedExercises.forEach(key => {
              // Split solo en el PRIMER guion para preservar IDs con guiones como "pectoral-stretch"
              const firstDashIndex = key.indexOf('-');
              const phaseId = key.substring(0, firstDashIndex);
              const exerciseId = key.substring(firstDashIndex + 1);
              // Selector más específico para asegurar que encontramos la tarjeta del ejercicio
              const card = document.querySelector(`.exercise-card[data-phase-id="${phaseId}"][data-exercise-id="${exerciseId}"]`);
              if (card) {
                card.classList.add('border-green-400', 'bg-green-50');
                card.classList.remove('border-slate-200', 'bg-white');
                const btn = card.querySelector('.complete-btn');
                if (btn) {
                  btn.classList.add('bg-green-500', 'text-white');
                  btn.classList.remove('bg-slate-200', 'text-slate-500');
                }
              }
            });
          });

          updateProgress();
          updateLevelButtons();
          updateLevelInfo();
        } catch (e) {
          console.error('Error loading state:', e);
        }
      }
    };

    // Save state to localStorage
    const saveState = () => {
      localStorage.setItem('desatrofiate-progress', JSON.stringify({
        completed: Array.from(completedExercises),
        level: currentLevel
      }));
    };

    // Update progress bar
    const updateProgress = () => {
      const total = Object.values(workout).reduce((sum, phase) => sum + phase.exercises.length, 0);
      const completed = completedExercises.size;

      // Actualizar texto del contador
      const progressText = document.getElementById('progress-text');
      if (progressText) progressText.textContent = `${completed} / ${total}`;

      // Actualizar cada segmento de fase
      ['fase1', 'fase2', 'fase3', 'fase4'].forEach(phaseId => {
        const phase = workout[phaseId];
        const phaseTotal = phase.exercises.length;

        // Contar ejercicios completados de esta fase
        const phaseCompleted = phase.exercises.filter(ex =>
          completedExercises.has(`${phaseId}-${ex.id}`)
        ).length;

        // Calcular el ancho del segmento (proporcional al total de ejercicios de la fase)
        const segmentMaxWidth = (phaseTotal / total) * 100;

        // Calcular el progreso dentro de este segmento
        const segmentProgress = (phaseCompleted / phaseTotal) * segmentMaxWidth;

        const segment = document.getElementById(`progress-${phaseId}`);
        if (segment) {
          segment.style.width = `${segmentProgress}%`;
        }
      });

      // Celebrate completion with confetti!
      if (completed === total && completed > 0) {
        setTimeout(() => {
          if (typeof confetti !== 'undefined') {
            // Launch confetti from both sides
            const count = 200;
            const defaults = {
              origin: { y: 0.7 }
            };

            function fire(particleRatio, opts) {
              confetti({
                ...defaults,
                ...opts,
                particleCount: Math.floor(count * particleRatio),
                spread: 100,
                startVelocity: 55,
              });
            }

            fire(0.25, { spread: 26, startVelocity: 55 });
            fire(0.2, { spread: 60 });
            fire(0.35, { spread: 100, decay: 0.91, scalar: 0.8 });
            fire(0.1, { spread: 120, startVelocity: 25, decay: 0.92, scalar: 1.2 });
            fire(0.1, { spread: 120, startVelocity: 45 });
          }
        }, 300);
      }
    };

    // Update level buttons
    const updateLevelButtons = () => {
      document.querySelectorAll('.level-btn').forEach(btn => {
        const level = btn.dataset.level;
        if (level === currentLevel) {
          btn.classList.add('bg-blue-500', 'text-white', 'shadow-md');
          btn.classList.remove('bg-slate-200', 'text-slate-700');
        } else {
          btn.classList.remove('bg-blue-500', 'text-white', 'shadow-md');
          btn.classList.add('bg-slate-200', 'text-slate-700');
        }
      });
    };

    // Update level info in exercise cards
    const updateLevelInfo = () => {
      document.querySelectorAll('.level-info').forEach(info => {
        const levels = JSON.parse(info.dataset.levels || '{}');
        const levelText = info.querySelector('.level-text');
        const levelLabel = info.querySelector('.font-semibold');

        if (levels[currentLevel] && levelText && levelLabel) {
          levelText.textContent = levels[currentLevel];
          levelLabel.textContent = currentLevel.charAt(0).toUpperCase() + currentLevel.slice(1) + ':';
        }
      });
    };

    // Format time
    const formatTime = (seconds) => {
      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      return `${mins}:${secs.toString().padStart(2, '0')}`;
    };

    // Timer functions
    const startTimer = (card, duration) => {
      if (activeTimer && activeTimer.card !== card) {
        stopTimer(activeTimer.card);
      }

      const display = card.querySelector('.timer-display');
      const startBtn = card.querySelector('.start-timer-btn');
      const pauseBtn = card.querySelector('.pause-timer-btn');
      const playBtn = card.querySelector('.play-timer-btn');
      const resetBtn = card.querySelector('.reset-timer-btn');

      startBtn.classList.add('hidden');
      pauseBtn.classList.remove('hidden');
      resetBtn.classList.remove('hidden');

      let timeLeft = duration;
      activeTimer = { card, timeLeft };

      timerInterval = setInterval(() => {
        timeLeft--;
        activeTimer.timeLeft = timeLeft;
        display.textContent = formatTime(timeLeft);

        if (timeLeft <= 0) {
          stopTimer(card);
          // Play sound or notification
        }
      }, 1000);
    };

    const pauseTimer = (card) => {
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }

      const pauseBtn = card.querySelector('.pause-timer-btn');
      const playBtn = card.querySelector('.play-timer-btn');

      pauseBtn.classList.add('hidden');
      playBtn.classList.remove('hidden');
    };

    const resumeTimer = (card) => {
      if (!activeTimer || activeTimer.card !== card) return;

      const display = card.querySelector('.timer-display');
      const pauseBtn = card.querySelector('.pause-timer-btn');
      const playBtn = card.querySelector('.play-timer-btn');

      playBtn.classList.add('hidden');
      pauseBtn.classList.remove('hidden');

      let timeLeft = activeTimer.timeLeft;

      timerInterval = setInterval(() => {
        timeLeft--;
        activeTimer.timeLeft = timeLeft;
        display.textContent = formatTime(timeLeft);

        if (timeLeft <= 0) {
          stopTimer(card);
        }
      }, 1000);
    };

    const stopTimer = (card) => {
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }

      const display = card.querySelector('.timer-display');
      const startBtn = card.querySelector('.start-timer-btn');
      const pauseBtn = card.querySelector('.pause-timer-btn');
      const playBtn = card.querySelector('.play-timer-btn');
      const resetBtn = card.querySelector('.reset-timer-btn');
      const duration = parseInt(card.dataset.duration || '0');

      display.textContent = formatTime(duration);
      startBtn.classList.remove('hidden');
      pauseBtn.classList.add('hidden');
      playBtn.classList.add('hidden');
      resetBtn.classList.add('hidden');

      if (activeTimer && activeTimer.card === card) {
        activeTimer = null;
      }
    };

    const resetTimer = (card) => {
      stopTimer(card);
      const duration = parseInt(card.dataset.duration || '0');
      const display = card.querySelector('.timer-display');
      display.textContent = formatTime(duration);
    };

    // Reset progress
    const resetProgress = () => {
      if (confirm('¿Estás seguro de que quieres resetear todo el progreso?')) {
        completedExercises.clear();

        // Reset UI
        document.querySelectorAll('.exercise-card').forEach(card => {
          card.classList.remove('border-green-400', 'bg-green-50');
          card.classList.add('border-slate-200', 'bg-white');
          const btn = card.querySelector('.complete-btn');
          if (btn) {
            btn.classList.remove('bg-green-500', 'text-white');
            btn.classList.add('bg-slate-200', 'text-slate-500');
          }
        });

        updateProgress();
        saveState();
      }
    };

    // Event Listeners
    document.addEventListener('DOMContentLoaded', () => {
      loadState();

      // Reset button
      const resetBtn = document.getElementById('reset-progress-btn');
      if (resetBtn) {
        resetBtn.addEventListener('click', resetProgress);
      }

      // Level buttons
      document.querySelectorAll('.level-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentLevel = btn.dataset.level;
          updateLevelButtons();
          updateLevelInfo();
          saveState();
        });
      });

      // Phase toggles
      document.querySelectorAll('.phase-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const phaseId = btn.dataset.phaseId;
          const container = document.querySelector(`.phase-container[data-phase-id="${phaseId}"]`);
          const content = container.querySelector('.phase-content');
          const chevronDown = container.querySelector('.chevron-down');
          const chevronUp = container.querySelector('.chevron-up');

          content.classList.toggle('hidden');
          chevronDown.classList.toggle('hidden');
          chevronUp.classList.toggle('hidden');
        });
      });

      // Toggle exercise completion (función reutilizable)
      const toggleExerciseCompletion = (phaseId, exerciseId) => {
        const key = `${phaseId}-${exerciseId}`;
        const card = document.querySelector(`.exercise-card[data-phase-id="${phaseId}"][data-exercise-id="${exerciseId}"]`);
        const btn = card?.querySelector('.complete-btn');

        if (!card) return;

        if (completedExercises.has(key)) {
          completedExercises.delete(key);
          card.classList.remove('border-green-400', 'bg-green-50');
          card.classList.add('border-slate-200', 'bg-white');
          if (btn) {
            btn.classList.remove('bg-green-500', 'text-white');
            btn.classList.add('bg-slate-200', 'text-slate-500');
          }
        } else {
          completedExercises.add(key);
          card.classList.add('border-green-400', 'bg-green-50');
          card.classList.remove('border-slate-200', 'bg-white');
          if (btn) {
            btn.classList.add('bg-green-500', 'text-white');
            btn.classList.remove('bg-slate-200', 'text-slate-500');
          }
        }

        updateProgress();
        saveState();
      };

      // Complete buttons
      document.querySelectorAll('.complete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const phaseId = btn.dataset.phaseId;
          const exerciseId = btn.dataset.exerciseId;
          toggleExerciseCompletion(phaseId, exerciseId);
        });
      });

      // Exercise cards - hacer clic en la tarjeta para completar
      document.querySelectorAll('.exercise-card').forEach(card => {
        card.addEventListener('click', (e) => {
          // No activar si se hace clic en elementos interactivos
          if (
            e.target.closest('.info-btn') ||
            e.target.closest('.timer-container') ||
            e.target.closest('.complete-btn')
          ) {
            return;
          }

          const phaseId = card.dataset.phaseId;
          const exerciseId = card.dataset.exerciseId;
          toggleExerciseCompletion(phaseId, exerciseId);
        });
      });

      // Timer buttons
      document.querySelectorAll('.start-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          const duration = parseInt(btn.dataset.duration || '0');
          startTimer(card, duration);
        });
      });

      document.querySelectorAll('.pause-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          pauseTimer(card);
        });
      });

      document.querySelectorAll('.play-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          resumeTimer(card);
        });
      });

      document.querySelectorAll('.reset-timer-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.exercise-card');
          resetTimer(card);
        });
      });

      // Info buttons
      document.querySelectorAll('.info-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const exerciseId = btn.dataset.exerciseId;
          const details = exerciseDetails[exerciseId];

          if (details) {
            // Find exercise name and video URL
            let exerciseName = '';
            let videoUrl = '';
            for (const phase of Object.values(workout)) {
              const exercise = phase.exercises.find(ex => ex.id === exerciseId);
              if (exercise) {
                exerciseName = exercise.name;
                videoUrl = exercise.videoUrl || '';
                break;
              }
            }

            document.getElementById('modal-title').textContent = exerciseName;
            document.getElementById('modal-muscles').textContent = details.muscles;
            document.getElementById('modal-why').textContent = details.why;
            document.getElementById('modal-evidence').textContent = details.evidence;
            document.getElementById('modal-tips').textContent = details.tips;

            // Handle video display
            const videoContainer = document.getElementById('modal-video-container');
            const videoIframe = document.getElementById('modal-video-iframe');

            if (videoUrl) {
              // Convert YouTube watch URL to embed URL
              const videoId = videoUrl.includes('watch?v=')
                ? videoUrl.split('watch?v=')[1].split('&')[0]
                : videoUrl.split('/').pop();
              const embedUrl = `https://www.youtube.com/embed/${videoId}`;

              videoIframe.src = embedUrl;
              videoContainer.classList.remove('hidden');
            } else {
              videoContainer.classList.add('hidden');
              videoIframe.src = '';
            }

            document.getElementById('exercise-info-modal').classList.remove('hidden');
          }
        });
      });

      // Close info modal
      const closeInfoModal = () => {
        document.getElementById('exercise-info-modal').classList.add('hidden');
        // Stop video playback by clearing the iframe src
        document.getElementById('modal-video-iframe').src = '';
      };

      document.getElementById('close-info-modal').addEventListener('click', closeInfoModal);
      document.getElementById('close-info-modal-btn').addEventListener('click', closeInfoModal);

      // References modal
      document.getElementById('show-references-btn').addEventListener('click', () => {
        document.getElementById('references-modal').classList.remove('hidden');
      });

      document.getElementById('close-references-modal').addEventListener('click', () => {
        document.getElementById('references-modal').classList.add('hidden');
      });

      document.getElementById('close-references-modal-btn').addEventListener('click', () => {
        document.getElementById('references-modal').classList.add('hidden');
      });

      // Close modals on backdrop click
      document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.add('hidden');
          }
        });
      });
    });
  </script>
</BaseLayout>
